import { Slider } from "std-widgets.slint";
import { Action, Caption, Cover, Divider, Eyebrow, Theme } from "theme.slint";

export component SeekBar inherits Rectangle {
    in property <float> elapsed;
    in property <float> duration;
    in property <bool> enabled;
    in property <[float]> waveform;
    callback seek(float);
    height: 24px;
    min-width: 0px;
    property <float> ratio: clamp(control.value / max(1, duration), 0, 1);
    property <bool> scrubbing;
    function sync-position() {
        if !root.scrubbing { control.value = clamp(root.elapsed, 0, max(0, root.duration)); }
    }
    function commit(value: float) {
        if root.enabled {
            root.scrubbing = false;
            control.value = clamp(value, 0, max(0, root.duration));
            root.seek(control.value);
        }
    }
    init => { root.sync-position(); }
    changed elapsed => { root.sync-position(); }
    changed duration => { root.sync-position(); }
    changed enabled => { if !root.enabled { root.scrubbing = false; root.sync-position(); } }
    control := Slider {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        minimum: 0; maximum: max(1, root.duration);
        enabled: root.enabled;
        accessible-label: "Playback position";
        accessible-action-increment => { root.commit(self.value + self.step); }
        accessible-action-decrement => { root.commit(self.value - self.step); }
        accessible-action-set-value(value) => { if value.is-float() { root.commit(value.to-float()); } }
        changed(_) => { root.scrubbing = true; }
        released(value) => { root.commit(value); }
    }
    Rectangle {
        background: Theme.panel;
        accessible-role: none;
        border-radius: 4px;
        border-width: control.has-focus ? 2px : 0px;
        border-color: Theme.blue;
        Rectangle { x: 8px; y: (parent.height - 3px) / 2; width: parent.width - 16px; height: 3px; background: Theme.line; border-radius: 2px; }
        if root.waveform.length == 0: Rectangle { x: 8px; y: (parent.height - 3px) / 2; width: (parent.width - 16px) * root.ratio; height: 3px; background: Theme.accent; border-radius: 2px; }
        for sample[i] in root.waveform: Rectangle {
            x: 8px + (parent.width - 16px) * i / max(1, root.waveform.length);
            width: max(1px, (parent.width - 16px) / max(1, root.waveform.length) - 1px);
            height: 2px + clamp(sample, 0, 1) * (parent.height - 8px);
            y: (parent.height - self.height) / 2;
            border-radius: 1px;
            background: i < root.ratio * root.waveform.length ? Theme.accent : Theme.line;
        }
        Rectangle { x: 3px + (parent.width - 16px) * root.ratio; y: (parent.height - 11px) / 2; width: 11px; height: 11px; border-radius: 6px; background: root.enabled ? Theme.accent : Theme.muted; }
    }
}

export component Transport inherits Rectangle {
    in property <bool> playing;
    in property <bool> available;
    in property <bool> skip-enabled;
    callback previous();
    callback toggle();
    callback next();
    width: 134px;
    height: 44px;
    horizontal-stretch: 0;
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Action { width: 39px; height: 42px; icon: "|◀"; quiet: true; accessible-label: "Previous track"; enabled: root.skip-enabled; clicked => { root.previous(); } }
        Action { width: 42px; height: 42px; primary: true; round: true; icon: root.playing ? "Ⅱ" : "▶"; enabled: root.available; accessible-label: root.playing ? "Pause" : "Play"; clicked => { root.toggle(); } }
        Action { width: 39px; height: 42px; icon: "▶|"; quiet: true; accessible-label: "Next track"; enabled: root.skip-enabled; clicked => { root.next(); } }
    }
}

component Clock inherits Caption {
    in property <float> seconds;
    property <int> whole: floor(max(0, seconds));
    property <int> remainder: mod(whole, 60);
    text: floor(whole / 60) + ":" + (remainder < 10 ? "0" : "") + remainder;
    font-family: "JetBrains Mono"; font-size: 11px; width: 41px; horizontal-alignment: center;
}

export component PlayerBar inherits Rectangle {
    in property <bool> has-track;
    in property <string> track;
    in property <string> subtitle;
    in property <string> output;
    in property <string> status;
    in property <image> artwork;
    in property <float> elapsed;
    in property <float> duration;
    in property <bool> can-seek;
    in property <bool> playing;
    in property <bool> can-toggle;
    in property <bool> can-skip;
    in property <bool> offline;
    in property <bool> compact;
    in property <string> page;
    callback previous();
    callback next();
    callback toggle();
    callback seek(float);
    callback navigate(string);
    property <bool> narrow: root.width < 760px;
    property <length> pad: max(clamp(root.width * 0.04, 16px, 36px), (root.width - 1220px) / 2);
    property <length> center-width: clamp(root.width * 0.36, 162px, 480px);
    height: !root.has-track ? 48px : 82px;
    vertical-stretch: 0; background: Theme.panel;
    Divider { y: 0px; }
    if !root.has-track: Caption { x: root.pad; width: parent.width - 2 * root.pad - 96px; text: root.status != "" ? root.status : "No song selected"; accessible-label: self.text; font-size: 13px; }
    if root.has-track: Rectangle {
        forward-focus: id-key;
        x: root.pad; width: (root.width - root.center-width)/2 - root.pad - 10px;
        height: 52px; y: (root.height - self.height)/2;
        accessible-role: button; accessible-label: "Now playing: " + root.track; accessible-action-default => { root.navigate("now"); }
        border-width: id-key.has-focus ? 2px : 0px; border-color: Theme.blue; border-radius: 5px;
        background: id-touch.has-hover ? Theme.raised : transparent;
        Cover { x: 0px; width: root.narrow ? 40px : 48px; height: self.width; y: (parent.height - self.height)/2; artwork: root.artwork; }
        VerticalLayout { x: root.narrow ? 49px : 61px; width: parent.width - self.x; alignment: center; spacing: 3px;
            Text { text: root.track; font-size: 15px * Theme.density; font-weight: 700; color: Theme.text; overflow: elide; }
            if root.subtitle != "" || root.status != "": Caption { text: root.status != "" ? root.status : root.subtitle; }
        }
        id-key := FocusScope { focus-on-click: false; key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { if !event.repeat {root.navigate("now");} return accept; } return reject; } }
        id-touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { id-key.focus(); root.navigate("now"); } }
    }
    if root.has-track: Rectangle {
        width: root.center-width; x: (root.width - self.width)/2;
        Transport { x: (parent.width - self.width)/2; y: root.duration <= 0 ? (root.height - self.height)/2 : 7px;
            playing: root.playing; available: root.can-toggle; skip-enabled: root.can-skip; previous => {root.previous();} toggle => {root.toggle();} next => {root.next();} }
        if root.duration > 0: HorizontalLayout { y: 52px; height: 22px; spacing: 4px;
            if root.width >= 540px: Clock { seconds: root.elapsed; }
            SeekBar { elapsed: root.elapsed; duration: root.duration; enabled: root.can-seek; horizontal-stretch: 1; seek(v) => { root.seek(v); } }
            Clock { seconds: root.duration; }
        }
    }
    HorizontalLayout { x: root.width - self.width - root.pad; width: self.preferred-width; y: (root.height - self.height)/2; height: 38px; spacing: 6px;
        Action { width: 37px; icon: "≡"; quiet: true; selected: root.page == "queue"; accessible-label: "Play queue"; clicked => { root.navigate("queue"); } }
        Action { text: root.narrow || !root.has-track ? "" : root.offline ? "This computer" : root.output; width: self.text == "" ? 37px : 154px; icon: "◫"; quiet: true; selected: root.page == "devices"; accessible-label: "Playback devices"; accessible-description: root.output; clicked => { root.navigate("devices"); } }
    }
}
