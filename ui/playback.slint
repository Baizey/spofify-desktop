import { Slider } from "std-widgets.slint";
import { Action, Caption, Cover, Divider, Theme, TrackTitle } from "theme.slint";
import { Glyph } from "icon.slint";
import { ArtistCredit, CreditLine } from "credits.slint";
import { DeviceRow, OutputPicker } from "output-picker.slint";

global SeekBarStyle {
    public pure function accent(focused: bool, resting: color) -> color {
        return focused ? Theme.tertiary : resting;
    }
}

export component SeekBar inherits Rectangle {
    in property <float> elapsed;
    in property <float> duration;
    in property <bool> enabled;
    in property <[float]> waveform;
    in property <color> track-background: Theme.bg;
    in property <bool> position-known: true;
    callback seek(float);
    height: 24px;
    min-width: 0px;
    property <float> ratio: clamp(control.value / max(1, duration), 0, 1);
    property <color> accent: SeekBarStyle.accent(root.enabled && control.has-focus, Theme.primary);
    property <bool> scrubbing;
    function sync-position() {
        if !root.scrubbing { control.value = clamp(root.elapsed, 0, max(0, root.duration)); }
    }
    function commit(value: float) {
        if root.enabled {
            root.scrubbing = false;
            control.value = clamp(value, 0, max(0, root.duration));
            root.seek(control.value);
        }
    }
    init => { root.sync-position(); }
    changed elapsed => { root.sync-position(); }
    changed duration => { root.sync-position(); }
    changed enabled => { if !root.enabled { root.scrubbing = false; root.sync-position(); } }
    control := Slider {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        minimum: 0; maximum: max(1, root.duration);
        enabled: root.enabled;
        accessible-label: "Playback position";
        accessible-action-increment => { root.commit(self.value + self.step); }
        accessible-action-decrement => { root.commit(self.value - self.step); }
        accessible-action-set-value(value) => { if value.is-float() { root.commit(value.to-float()); } }
        changed(_) => { root.scrubbing = true; }
        released(value) => { root.commit(value); }
    }
    Rectangle {
        background: root.track-background;
        accessible-role: none;
        Rectangle { x: 8px; y: (parent.height - 3px) / 2; width: parent.width - 16px; height: 3px; background: Theme.line; border-radius: 2px; }
        if root.position-known && root.waveform.length == 0: Rectangle { x: 8px; y: (parent.height - 3px) / 2; width: (parent.width - 16px) * root.ratio; height: 3px; background: root.accent; border-radius: 2px; }
        for sample[i] in root.waveform: Rectangle {
            x: 8px + (parent.width - 16px) * i / max(1, root.waveform.length);
            width: max(1px, (parent.width - 16px) / max(1, root.waveform.length) - 1px);
            height: 2px + clamp(sample, 0, 1) * (parent.height - 8px);
            y: (parent.height - self.height) / 2;
            border-radius: 1px;
            background: i < root.ratio * root.waveform.length ? root.accent : Theme.line;
        }
        if root.position-known: Rectangle { x: 3px + (parent.width - 16px) * root.ratio; y: (parent.height - 11px) / 2; width: 11px; height: 11px; border-radius: 6px; background: root.enabled ? root.accent : Theme.muted; }
    }
}

// Pointer activation keeps the real focus position for subsequent Tab or
// Space, but does not leave a keyboard ring in the playback controls.
component PlaybackAction inherits Action {
    pointer-focus-visible: false;
}

export component Transport inherits Rectangle {
    in property <bool> playing;
    in property <bool> available;
    in property <bool> skip-enabled;
    in property <bool> modes-enabled;
    in property <bool> shuffle;
    in property <string> repeat-mode;
    callback previous();
    callback toggle();
    callback next();
    callback queue-action(string, string);
    callback focused();
    width: 214px;
    height: 44px;
    horizontal-stretch: 0;
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        height: 42px;
        alignment: center;
        spacing: 5px;
        PlaybackAction {
            width: 36px; height: 42px; icon: "shuffle"; quiet: true; selected: root.shuffle;
            enabled: root.modes-enabled;
            accessible-label: "Shuffle"; accessible-description: root.shuffle ? "On" : "Off";
            changed has-focus => { if self.has-focus { root.focused(); } }
            clicked => { root.queue-action("shuffle", ""); }
        }
        PlaybackAction {
            width: 39px; height: 42px; icon: "|◀"; quiet: true; accessible-label: "Previous track"; enabled: root.skip-enabled;
            changed has-focus => { if self.has-focus { root.focused(); } }
            clicked => { root.previous(); }
        }
        PlaybackAction {
            width: 42px; height: 42px; primary: root.available; round: true;
            icon: root.playing ? "Ⅱ" : "▶"; enabled: root.available;
            accessible-label: root.playing ? "Pause" : "Play";
            changed has-focus => { if self.has-focus { root.focused(); } }
            clicked => { root.toggle(); }
        }
        PlaybackAction {
            width: 39px; height: 42px; icon: "▶|"; quiet: true; accessible-label: "Next track"; enabled: root.skip-enabled;
            changed has-focus => { if self.has-focus { root.focused(); } }
            clicked => { root.next(); }
        }
        PlaybackAction {
            width: 36px; height: 42px; icon: root.repeat-mode == "one" ? "repeat-one" : "repeat";
            quiet: true; selected: root.repeat-mode == "one" || root.repeat-mode == "all";
            enabled: root.modes-enabled;
            accessible-label: "Repeat";
            accessible-description: root.repeat-mode == "one" ? "Repeat track" : root.repeat-mode == "all" ? "Repeat queue" : "Off";
            changed has-focus => { if self.has-focus { root.focused(); } }
            clicked => { root.queue-action("repeat", ""); }
        }
    }
}

component Clock inherits Caption {
    in property <float> seconds;
    property <int> whole: floor(max(0, seconds));
    property <int> remainder: mod(whole, 60);
    text: floor(whole / 60) + ":" + (remainder < 10 ? "0" : "") + remainder;
    font-family: "JetBrains Mono"; font-size: 11px; width: 41px; horizontal-alignment: center;
}

component VolumeSlider inherits Rectangle {
    in property <float> level;
    in property <bool> muted;
    in property <bool> enabled;
    callback adjusted(float);
    property <color> accent: SeekBarStyle.accent(root.enabled && slider.has-focus, root.muted ? Theme.muted : Theme.primary);
    height: 38px;
    opacity: root.enabled ? 1 : 0.48;
    function adjust(value: float) { if root.enabled { root.adjusted(value); } }
    changed level => { slider.value = root.level; }
    slider := Slider {
        y: 3px; width: parent.width; height: 26px;
        enabled: root.enabled;
        minimum: 0; maximum: 100; step: 5;
        value: root.level;
        accessible-label: "Desktop volume";
        accessible-description: root.muted ? "This app only · Muted" : "This app only";
        accessible-action-increment => { root.adjust(min(100, self.value + self.step)); }
        accessible-action-decrement => { root.adjust(max(0, self.value - self.step)); }
        accessible-action-set-value(value) => { if value.is-float() { root.adjust(clamp(value.to-float(), 0, 100)); } }
        changed(value) => { root.adjust(value); }
    }
    Rectangle {
        y: slider.y; height: slider.height;
        background: Theme.rail;
        border-radius: 5px;
        accessible-role: none;
        Rectangle { x: 6px; y: (parent.height - 3px) / 2; width: parent.width - 12px; height: 3px; border-radius: 2px; background: Theme.line; }
        Rectangle { x: 6px; y: (parent.height - 3px) / 2; width: (parent.width - 12px) * slider.value / 100; height: 3px; border-radius: 2px; background: root.accent; }
        Rectangle { x: 2px + (parent.width - 12px) * slider.value / 100; y: (parent.height - 9px) / 2; width: 9px; height: 9px; border-radius: 5px; background: root.accent; }
    }
    Caption {
        y: 26px; height: 12px;
        text: "Desktop"; font-size: 10px * Theme.density; horizontal-alignment: center;
        accessible-role: none;
    }
}

export global DockLayout {
    // Keep the compact metadata and seek lanes stable across playback states,
    // with more room for the title and credits at larger text scales.
    out property <length> compact-metadata-height: 62px + 40px * max(0, Theme.density - 1);
    out property <length> status-height: 18px;

    // Reserve both lanes across empty and active playback, including requests
    // that change the message or duration without moving the workspace.
    public pure function height(layered: bool) -> length {
        return self.status-height + (layered ? self.compact-metadata-height + 69px : 82px);
    }
}

export component PlayerBar inherits Rectangle {
    in property <bool> has-track;
    in property <bool> locked;
    in property <string> track;
    in property <string> track-id;
    in property <string> subtitle;
    in property <string> output;
    in property <[DeviceRow]> devices;
    in property <string> device-status;
    in property <string> device-picker-context;
    in property <string> status;
    in property <image> artwork;
    in property <float> elapsed;
    in property <float> duration;
    in property <bool> can-seek;
    in property <bool> playing;
    in property <bool> can-toggle;
    in property <bool> can-skip;
    in property <bool> offline;
    in property <bool> layered;
    in property <bool> shuffle;
    in property <string> repeat-mode;
    in property <bool> modes-enabled;
    in property <float> volume;
    in property <bool> muted;
    in property <bool> on-now-page;
    in property <bool> queue-open;
    in property <[ArtistCredit]> credits;
    in property <string> album-id;
    in property <string> album-name;
    in property <string> current-album-id;
    in property <int> title-focus-serial;
    callback page-action(string, string);
    callback previous();
    callback next();
    callback toggle();
    callback seek(float);
    callback navigate(string);
    callback toggle-queue(bool);
    callback queue-action(string, string);
    callback volume-change(float);
    callback mute-toggle();
    callback device-action(string, string, string);
    public function focus-queue(by-pointer: bool) {
        if by-pointer { queue-trigger.take-pointer-focus(); }
        else { queue-trigger.take-focus(); }
    }
    public function focus-lyrics() { if lyrics-trigger.enabled { lyrics-trigger.take-focus(); } }
    public function focus-now() {
        if now-trigger.enabled { now-trigger.take-focus(); }
        else if lyrics-trigger.enabled { lyrics-trigger.take-focus(); }
        else if queue-trigger.enabled { queue-trigger.take-focus(); }
    }
    public function dismiss-devices() { devices-trigger.dismiss(); }
    property <length> edge: clamp(root.width * 0.018, 12px, 24px);
    property <length> column-gap: root.layered ? 10px : 16px;
    property <length> inner-width: root.width - 2 * root.edge;
    // After reserving the right-hand controls, give the seek lane two shares
    // and metadata one, with room for cover and title at the inline breakpoint.
    // The compact seek lane spans the full bar below the track and tools.
    property <length> track-and-transport: root.inner-width - output-tools.width - 2 * root.column-gap;
    property <length> transport-width: root.layered ? root.inner-width
        : clamp(root.track-and-transport * 2 / 3, 214px, root.track-and-transport - 188px);
    property <length> metadata-height: root.layered ? DockLayout.compact-metadata-height : root.height - DockLayout.status-height;
    property <bool> title-repaint-phase;
    changed track => { root.title-repaint-phase = !root.title-repaint-phase; }
    property <string> title-identity: root.track-id + "/" + root.album-id;
    property <string> focused-title-identity;
    property <bool> title-focused;
    changed title-identity => {
        if root.title-focused && root.focused-title-identity != root.title-identity {
            root.title-focused = false;
            root.focus-now();
        }
    }
    changed current-album-id => { if root.current-album-id == root.album-id { root.title-focused = false; } }
    vertical-stretch: 0; background: Theme.rail;
    Divider { y: 0px; }
    track-info := Rectangle {
        x: root.edge; y: 0px;
        width: max(0px, root.layered ? output-tools.x - self.x - root.column-gap : root.track-and-transport - root.transport-width);
        height: root.metadata-height;
        // Damage the whole metadata area on title changes, rather than relying
        // on a partial software repaint of the old and new glyphs.
        // The transparent border affects neither layout nor progress-only damage.
        border-color: transparent;
        border-width: root.title-repaint-phase ? 1px : 0px;
        property <length> cover-size: self.width < 150px ? 36px : root.layered ? 40px : 48px;
        property <bool> show-art: self.width >= 150px && root.artwork.width > 0;
        Cover {
            visible: root.has-track && track-info.show-art;
            x: 0px; width: track-info.cover-size; height: self.width;
            y: (parent.height - self.height)/2; artwork: root.artwork;
        }
        now-trigger := Action {
            x: 0px; width: track-info.cover-size; height: self.width;
            y: (parent.height - self.height) / 2;
            visible: root.has-track;
            enabled: root.has-track && !root.locked && !root.on-now-page;
            accessible-label: "Open Now Playing";
            click-scope: root.track-id;
            quiet: track-info.show-art || root.on-now-page;
            icon: track-info.show-art ? "" : root.on-now-page ? "♫" : "now-playing";
            border-radius: min(Theme.container-radius, self.height / 5);
            background: !track-info.show-art ? (self.has-hover || self.has-focus ? Theme.raised : Theme.panel)
                : self.enabled && (self.has-hover || self.has-focus) ? Theme.bg.with-alpha(0.65) : transparent;
            if track-info.show-art && now-trigger.enabled: Rectangle {
                x: parent.width - self.width - 4px; y: parent.height - self.height - 4px;
                width: 16px; height: self.width; border-radius: 4px; background: Theme.bg;
                Glyph {
                    x: 2px; y: 2px; width: 12px; height: self.width;
                    ink: Theme.text; name: "now-playing";
                }
            }
            clicked => { root.navigate("now"); }
        }
        if !root.has-track: Caption {
            x: 4px; width: max(0px, parent.width - self.x); height: parent.height;
            text: "Nothing playing";
            vertical-alignment: center;
            accessible-role: text; accessible-label: self.text;
        }
        if root.has-track: VerticalLayout {
            x: track-info.cover-size + (root.layered ? 9px : 13px);
            width: max(0px, parent.width - self.x); height: parent.height;
            alignment: center;
            TrackTitle {
                text: root.track; font-weight: 700;
                album-id: root.album-id; album-name: root.album-name;
                current-album-id: root.current-album-id;
                links-enabled: !root.locked;
                click-scope: root.title-identity;
                focus-serial: root.title-focus-serial;
                keyboard-focus-changed(owns) => {
                    if owns { root.focused-title-identity = root.title-identity; }
                    root.title-focused = owns;
                }
                activated => {
                    if root.focused-title-identity == root.title-identity { root.page-action("album", root.album-id); }
                }
            }
            if root.credits.length > 0 || root.subtitle != "": Rectangle {
                height: artists.preferred-height;
                artists := CreditLine {
                    x: root.credits.length > 0 ? 2px : 4px;
                    width: max(0px, parent.width - 2 * self.x); height: parent.height;
                    credits: root.credits; fallback: root.subtitle; interactive: !root.locked;
                    activated(id) => { root.page-action("artist", id); }
                }
            }
        }
    }
    Caption {
        x: root.edge; y: root.metadata-height; width: root.inner-width; height: DockLayout.status-height;
        visible: root.status != "";
        text: root.status; color: Theme.tertiary;
        accessible-role: text; accessible-label: self.text; accessible-live-region: polite;
    }
    Rectangle {
        width: root.transport-width; x: root.layered ? root.edge : track-info.x + track-info.width + root.column-gap;
        y: root.layered ? root.metadata-height + DockLayout.status-height : 0px;
        height: root.layered ? root.height - self.y : root.metadata-height;
        Transport {
            x: (parent.width - self.width)/2;
            y: root.layered ? 0px : 7px;
            playing: root.has-track && root.playing;
            available: root.has-track && !root.locked && root.can-toggle;
            skip-enabled: root.has-track && !root.locked && root.can-skip;
            shuffle: root.shuffle; repeat-mode: root.repeat-mode;
            modes-enabled: !root.locked && root.modes-enabled;
            previous => { root.previous(); } toggle => { root.toggle(); } next => { root.next(); }
            queue-action(op, key) => { root.queue-action(op, key); }
        }
        HorizontalLayout {
            y: root.layered ? 44px : 52px; height: 22px; spacing: 4px;
            visible: !root.has-track || root.duration > 0;
            property <bool> show-time: root.has-track && root.duration > 0;
            Clock { seconds: root.elapsed; visible: parent.show-time; }
            SeekBar {
                elapsed: parent.show-time ? root.elapsed : 0;
                duration: parent.show-time ? root.duration : 0;
                position-known: parent.show-time;
                track-background: Theme.rail; horizontal-stretch: 1;
                enabled: parent.show-time && !root.locked && root.can-seek;
                seek(v) => { root.seek(v); }
            }
            Clock { seconds: root.duration; visible: parent.show-time; }
        }
    }
    output-tools := HorizontalLayout {
        x: root.width - self.width - root.edge; width: self.preferred-width; y: (root.metadata-height - self.height)/2; height: 38px; spacing: 3px;
        lyrics-trigger := PlaybackAction {
            width: 36px; icon: "lyrics"; quiet: true; accessible-label: "Lyrics";
            enabled: root.has-track && !root.locked;
            clicked => { root.navigate("lyrics"); }
        }
        queue-trigger := PlaybackAction {
            width: 36px; icon: "≡"; quiet: true; selected: root.queue-open;
            enabled: !root.locked;
            accessible-label: "Play queue"; accessible-expandable: true; accessible-expanded: root.queue-open;
            clicked => { root.toggle-queue(self.pointer-focused); }
        }
        devices-trigger := OutputPicker {
            width: 36px; window-width: root.width;
            enabled: !root.locked;
            devices: root.devices; output: root.output; status: root.device-status;
            context-key: root.device-picker-context; offline: root.offline;
            device-action(op, id, name) => { root.device-action(op, id, name); }
        }
        PlaybackAction {
            width: 36px; icon: root.muted || root.volume == 0 ? "volume-muted" : "volume";
            quiet: true; selected: root.muted; enabled: !root.locked;
            accessible-label: root.muted ? "Unmute desktop playback" : "Mute desktop playback";
            clicked => { root.mute-toggle(); }
        }
        VolumeSlider {
            width: clamp(root.width * 0.085, 64px, 116px);
            level: root.volume * 100; muted: root.muted; enabled: !root.locked;
            adjusted(value) => { root.volume-change(value / 100); }
        }
    }
}
