import { Glyph } from "icon.slint";
import { Theme } from "theme.slint";

// Sleeve art, not status UI. Use one visual system for missing covers and portraits.
component LibraryArtwork inherits Rectangle {
    in property <image> artwork;
    in property <bool> is-artist;
    property <bool> has-artwork: artwork.width > 0 && artwork.height > 0;
    property <color> ink: is-artist ? Theme.amber : Theme.blue;
    border-radius: 7px;
    background: Theme.panel;
    clip: true;
    accessible-role: none;

    if root.has-artwork: Image {
        width: parent.width;
        height: parent.height;
        source: root.artwork;
        image-fit: cover;
        accessible-role: none;
    }

    if !root.has-artwork: Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(145deg, root.ink.with-alpha(0.29) 0%, root.ink.with-alpha(0.06) 100%);

        // Jacket spine and the narrow footer of a printed sleeve.
        Rectangle {
            x: parent.width * 0.09; y: 0px;
            width: 1px; height: parent.height;
            background: root.ink.with-alpha(0.28);
        }
        Rectangle {
            x: parent.width * 0.16; y: parent.height * 0.88;
            width: parent.width * 0.75; height: 1px;
            background: root.ink.with-alpha(0.35);
        }
        Rectangle {
            x: parent.width * 0.16; y: parent.height * 0.88;
            width: parent.width * 0.17; height: 2px;
            background: root.ink.with-alpha(0.76);
        }

        if !root.is-artist: record := Rectangle {
            x: parent.width * 0.26; y: parent.height * 0.045;
            width: parent.width * 0.76; height: self.width;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: root.ink.with-alpha(0.40);
            background: @linear-gradient(120deg, Theme.raised 0%, Theme.panel 75%);
            for groove in [0.86, 0.73, 0.60]: Rectangle {
                width: record.width * groove; height: self.width;
                x: (record.width - self.width) / 2; y: self.x;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: root.ink.with-alpha(0.22);
            }
            Rectangle {
                width: parent.width * 0.34; height: self.width;
                x: (parent.width - self.width) / 2; y: self.x;
                border-radius: self.width / 2;
                background: root.ink.with-alpha(0.72);
                Rectangle {
                    width: max(2px, parent.width * 0.17); height: self.width;
                    x: (parent.width - self.width) / 2; y: self.x;
                    border-radius: self.width / 2;
                    background: Theme.panel;
                }
            }
        }

        if root.is-artist: Rectangle {
            x: parent.width * 0.25; y: parent.height * 0.09;
            width: parent.width * 0.61; height: parent.height * 0.70;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: root.ink.with-alpha(0.42);
            background: @linear-gradient(165deg, root.ink.with-alpha(0.31) 0%, root.ink.with-alpha(0.06) 100%);
            Glyph {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: parent.width * 0.66; height: self.width;
                name: "◉"; ink: root.ink;
            }
        }
    }
}

// Size cards in the parent; the default height adds a density-scaled caption to a square slot.
export component LibraryCard inherits Rectangle {
    in property <string> title;
    in property <string> secondary;
    in property <image> artwork;
    in property <bool> is-artist: false;
    callback activated();
    callback focused();

    property <string> display-title: title != "" ? title : is-artist ? "Unknown artist" : "Unknown album";
    property <string> display-secondary: secondary != "" ? secondary : is-artist ? "Artist" : "Album";
    property <length> inset: 6px;

    preferred-width: 148px;
    min-width: 0px;
    height: self.width + 48px * Theme.density;
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: key.has-focus ? 2px : pointer.has-hover ? 1px : 0px;
    border-color: key.has-focus ? Theme.blue : Theme.line;
    background: pointer.pressed ? Theme.line : pointer.has-hover || key.has-focus ? Theme.raised : transparent;

    forward-focus: key;
    accessible-role: button;
    accessible-label: "Open " + display-title;
    accessible-description: display-secondary;
    accessible-action-default => { root.activated(); }

    sleeve := LibraryArtwork {
        x: root.inset; y: root.inset;
        width: max(0px, root.width - 2 * root.inset); height: self.width;
        artwork: root.artwork; is-artist: root.is-artist;
    }
    title-text := Text {
        x: sleeve.x; y: sleeve.y + sleeve.height + 7px;
        width: sleeve.width; height: 19px * Theme.density;
        text: root.display-title;
        color: Theme.text;
        font-size: 14px * Theme.density;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Text {
        x: sleeve.x; y: title-text.y + title-text.height + 2px;
        width: sleeve.width; height: 16px * Theme.density;
        text: root.display-secondary;
        color: Theme.muted;
        font-size: 12px * Theme.density;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { key.focus(); root.activated(); }
    }
    key := FocusScope {
        focus-on-click: false;
        focus-gained(_) => { root.focused(); }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                if !event.repeat { root.activated(); }
                return accept;
            }
            return reject;
        }
    }
}
