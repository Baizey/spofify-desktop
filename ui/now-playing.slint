import { ScrollView } from "std-widgets.slint";
import { ArtistCredit, WrappingCredits } from "credits.slint";
import { Action, Caption, Cover, Divider, Eyebrow, Theme } from "theme.slint";
import { SeekBar, Transport } from "playback.slint";

component PlayerTime inherits Caption {
    in property <float> seconds;
    property <int> whole: floor(max(0, seconds));
    property <int> remainder: mod(whole, 60);
    text: floor(whole / 60) + ":" + (remainder < 10 ? "0" : "") + remainder;
    font-family: "JetBrains Mono";
    font-size: 11px * Theme.density;
}

export struct TimedLyricLine { start-ms: int, text: string }

// The standard scrollbar is too faint when idle. Keep the proportional thumb
// visible and draggable in a lane that never covers the last row of lyrics.
component LyricPanBar inherits Rectangle {
    in property <length> limit;
    in property <length> viewport-width;
    in-out property <length> content-x;
    callback take-reading-focus();
    accessible-role: none;
    property <length> thumb-width: min(self.width, max(28px, self.width * viewport-width / max(1px, viewport-width + limit)));
    property <length> travel: max(1px, self.width - self.thumb-width);
    Rectangle {
        width: parent.width; y: (parent.height - self.height) / 2; height: 4px;
        border-radius: 2px; background: Theme.line;
    }
    thumb := Rectangle {
        x: root.travel * (-root.content-x / max(1px, root.limit));
        y: (parent.height - self.height) / 2; width: root.thumb-width; height: 7px;
        border-radius: 3.5px;
        background: pointer.pressed || pointer.has-hover ? Theme.muted : Theme.subtle.with-alpha(0.7);
    }
    pointer := TouchArea {
        property <length> grab;
        function position() { root.content-x = -root.limit * clamp((self.mouse-x - self.grab) / root.travel, 0, 1); }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.grab = self.mouse-x >= thumb.x && self.mouse-x <= thumb.x + thumb.width
                    ? self.mouse-x - thumb.x : thumb.width / 2;
                root.take-reading-focus();
                self.position();
            }
        }
        moved => { if self.pressed { self.position(); } }
    }
}

// The reading viewport owns both scroll axes. Its width is independent from the authored text.
component LyricsReader inherits Rectangle {
    in property <string> lyrics;
    in property <[TimedLyricLine]> lines;
    in property <string> attribution;
    in property <int> active-line: -1;
    in property <string> status;
    in property <string> track-id;
    in property <length> reading-height;
    in property <bool> active;
    callback reveal();
    out property <bool> has-reading-focus: reading-focus.has-focus;
    public function take-focus() { reading-focus.focus(); }
    function pan(step: length) { reader.content-x = clamp(reader.content-x + step, -root.horizontal-limit, 0px); }

    property <length> heading-y: 14px;
    out property <length> heading-height: 53px;
    property <length> pan-height: root.horizontal-limit > 0px ? 22px : 0px;
    property <bool> has-lyrics: root.lyrics != "" || root.lines.length > 0;
    property <length> verse-size: 19px * Theme.density;
    property <length> horizontal-limit: max(0px, reader.content-width - reader.visible-width);
    property <length> vertical-limit: max(0px, reader.content-height - reader.visible-height);
    property <length> edge: 12px;
    preferred-height: root.heading-height + (root.has-lyrics ? root.reading-height : 50px);
    changed track-id => { reader.content-x = 0px; reader.content-y = 0px; }
    changed horizontal-limit => { reader.content-x = clamp(reader.content-x, -root.horizontal-limit, 0px); }
    changed vertical-limit => { reader.content-y = clamp(reader.content-y, -root.vertical-limit, 0px); }

    Divider { y: 0px; }

    heading := Text {
        x: root.edge; y: root.heading-y;
        height: 33px;
        text: "Lyrics";
        color: Theme.text;
        font-size: 22px * Theme.density;
        font-weight: 700;
        vertical-alignment: center;
    }
    reading-focus := FocusScope {
        width: parent.width; height: parent.height;
        enabled: root.active;
        accessible-role: groupbox; accessible-label: "Lyrics";
        accessible-description: !root.has-lyrics ? root.status
            : root.horizontal-limit > 0px ? "Use Left and Right arrows to read long lines" : "";
        focus-on-click: false;
        changed has-focus => { if self.has-focus { root.reveal(); } }
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                if root.horizontal-limit <= 0px { return reject; }
                root.pan(event.text == Key.LeftArrow ? 80px : -80px);
                root.reveal();
                return accept;
            }
            if event.text == Key.Home && (root.horizontal-limit > 0px || root.vertical-limit > 0px) {
                reader.content-x = 0px; reader.content-y = 0px;
                root.reveal();
                return accept;
            }
            if root.vertical-limit <= 0px || (event.text != Key.UpArrow && event.text != Key.DownArrow
                && event.text != Key.PageUp && event.text != Key.PageDown && event.text != Key.End) { return reject; }
            let step = event.text == Key.UpArrow ? 28px : event.text == Key.DownArrow ? -28px
                : event.text == Key.PageUp ? max(32px, reader.visible-height - 28px)
                : event.text == Key.PageDown ? -max(32px, reader.visible-height - 28px) : 0px;
            reader.content-y = event.text == Key.End ? -root.vertical-limit
                : clamp(reader.content-y + step, -root.vertical-limit, 0px);
            root.reveal();
            return accept;
        }
        if !root.has-lyrics: Caption {
            x: root.edge; y: root.heading-height;
            width: parent.width - self.x;
            text: root.status;
            font-size: 14px * Theme.density;
            wrap: word-wrap;
            accessible-role: text; accessible-label: self.text; accessible-live-region: polite;
        }
        reader := ScrollView {
            y: root.heading-height; width: parent.width; height: parent.height - self.y - root.pan-height;
            visible: root.has-lyrics;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;
            // Reserve a little space at the far edge for the desktop scrollbars.
            content-width: max(self.visible-width, verses.preferred-width + 16px);
            content-height: max(self.visible-height, credit.y + credit.height + 8px);
            verses := VerticalLayout {
                x: 0px; y: 3px;
                width: max(0px, reader.content-width - 16px);
                height: self.preferred-height;
                alignment: start;
                if root.lyrics != "": VerticalLayout {
                    padding-left: root.edge;
                    Text {
                        text: root.lyrics; color: Theme.text;
                        font-size: root.verse-size; font-weight: 500; wrap: no-wrap;
                        accessible-role: text; accessible-label: self.text;
                    }
                }
                for line[index] in root.lines: lyric-row := Rectangle {
                    property <bool> current: index == root.active-line && line.text != "";
                    preferred-width: root.edge + words.preferred-width;
                    height: max(root.verse-size, words.preferred-height) + 6px;
                    accessible-role: text; accessible-label: line.text;
                    accessible-description: self.current ? "Current line" : "";
                    if self.current: Rectangle {
                        x: 0px; y: 0px; width: min(parent.width, words.preferred-width + 2 * root.edge); height: parent.height;
                        border-radius: 4px; background: Theme.primary.with-alpha(0.11);
                    }
                    words := Text {
                        x: root.edge; width: max(0px, parent.width - self.x);
                        height: parent.height; vertical-alignment: center;
                        text: line.text; color: Theme.text;
                        font-size: root.verse-size; font-weight: 500; wrap: no-wrap;
                        accessible-role: none;
                    }
                    // Keep the leading marker and the text gutter fixed while
                    // the measured lyric line and its tint pan beneath them.
                    if self.current || reader.content-x != 0px: Rectangle {
                        x: -reader.content-x; y: 0px; width: root.edge - 1px; height: parent.height;
                        background: Theme.bg;
                        if lyric-row.current: Rectangle {
                            x: 1px; y: 3px; width: 3px; height: parent.height - 6px;
                            border-radius: 1.5px; background: Theme.primary;
                        }
                    }
                }
            }
            if reader.content-x != 0px && root.lyrics != "": Rectangle {
                x: -reader.content-x; y: verses.y; width: root.edge; height: verses.height;
                background: Theme.bg;
            }
            credit := VerticalLayout {
                x: root.edge - reader.content-x; y: verses.y + verses.height;
                width: max(0px, reader.visible-width - root.edge - 16px);
                padding-top: root.attribution == "" ? 0px : 14px;
                height: self.preferred-height;
                if root.attribution != "": Caption {
                    text: root.attribution; font-size: 13px * Theme.density; wrap: word-wrap;
                    accessible-role: text; accessible-label: self.text;
                }
            }
        }
        if root.pan-height > 0px: LyricPanBar {
            x: root.edge; y: parent.height - self.height;
            width: max(0px, parent.width - self.x - 16px); height: root.pan-height;
            limit: root.horizontal-limit; viewport-width: reader.visible-width;
            content-x <=> reader.content-x;
            take-reading-focus => { root.take-focus(); }
        }
        if reading-focus.has-focus: Rectangle {
            x: 0px; y: root.heading-y; width: heading.preferred-width + 2 * root.edge; height: 34px;
            border-width: 2px; border-color: Theme.tertiary; border-radius: 5px;
        }
    }
}

export component NowPlaying inherits Rectangle {
    in property <string> track-id;
    in property <string> track;
    in property <string> subtitle;
    in property <string> album-id;
    in property <string> album-name;
    in property <[ArtistCredit]> credits;
    in property <bool> metadata-interactive: true;
    in property <string> context-kind;
    in property <string> context-id;
    in property <string> context-name;
    in property <image> artwork;
    in property <string> lyrics-text;
    in property <[TimedLyricLine]> lyrics-lines;
    in property <string> lyrics-attribution;
    in property <int> active-lyric-line: -1;
    in property <string> lyrics-status;
    in property <bool> offline;
    in property <[float]> waveform;
    in property <float> elapsed;
    in property <float> duration;
    in property <bool> playing;
    in property <bool> can-seek;
    in property <bool> can-toggle;
    in property <bool> can-skip;
    in property <bool> shuffle;
    in property <string> repeat-mode: "off";
    in property <bool> can-change-modes;
    in property <string> next-title;
    in property <string> next-subtitle;

    callback previous();
    callback toggle();
    callback next();
    callback seek(float);
    callback page-action(string, string);
    callback queue-action(string, string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 0px;
    min-height: 0px;
    background: Theme.bg;

    property <bool> has-track: root.track-id != "";
    property <bool> header: root.stage-width >= 555px;
    property <bool> header-wide: root.stage-width >= 1120px;
    property <bool> short: scroll.visible-height < 640px;
    property <length> gutter: clamp(scroll.visible-width * 0.038, 18px, 66px);
    property <length> stage-width: max(0px, min(1440px, scroll.visible-width - 2 * root.gutter));
    property <length> deck-lane: root.header ? root.stage-width : min(root.stage-width, 460px);
    property <length> art-size: min(root.deck-lane,
        root.header-wide ? 138px : root.header ? 112px : clamp(scroll.visible-height - 350px, 100px, 248px));
    property <length> header-controls-width: min(390px, root.stage-width * 0.27);
    property <length> deck-top: 44px;
    property <bool> has-context: root.context-id != "" && root.context-name != "" &&
        (root.context-kind == "album" || root.context-kind == "artist" || root.context-kind == "playlist" || root.context-kind == "derived" || root.context-kind == "saved");
    property <bool> context-is-album: root.has-context && root.context-kind == "album" && root.context-id == root.album-id;
    property <bool> link-album: root.metadata-interactive && root.album-id != "";
    property <bool> show-album: root.link-album || root.album-label != "";
    property <bool> show-context: root.metadata-interactive && root.has-context && !root.context-is-album;
    property <string> album-label: root.album-name != "" ? root.album-name : root.context-is-album ? root.context-name : "";
    public function focus-lyrics() {
        lyrics.take-focus();
        root.align-lyrics();
    }

    changed track-id => { root.reset-position(); }
    property <bool> has-lyrics: !root.offline && (root.lyrics-text != "" || root.lyrics-lines.length > 0);
    changed has-lyrics => {
        // Align after initial delivery only; playback must never drive scrolling.
        if root.has-lyrics && lyrics.has-reading-focus { root.align-lyrics(); }
    }

    function align-lyrics() {
        root.reveal(stage.y + lyrics.y, min(lyrics.height, scroll.visible-height - 18px));
    }
    function reset-position() {
        scroll.content-y = 0px;
        if root.has-track && lyrics.has-reading-focus { root.align-lyrics(); }
    }
    function scroll-to(y: length) {
        scroll.content-y = clamp(y, scroll.visible-height - scroll.content-height, 0px);
    }
    function reveal(y: length, h: length) {
        if y < -scroll.content-y || h >= scroll.visible-height { root.scroll-to(-y + 8px); }
        else if y + h > scroll.visible-height - scroll.content-y { root.scroll-to(scroll.visible-height - y - h - 8px); }
    }

    scroll := ScrollView {
        width: parent.width; height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: max(self.visible-height, stage.y + stage.height + 26px);

        stage := Rectangle {
            width: root.stage-width;
            x: (scroll.visible-width - self.width) / 2;
            y: root.short ? 8px : 16px;
            height: !root.has-track ? 176px : max(deck.y + deck.height, lyrics.y + lyrics.height);

            HorizontalLayout {
                y: 0px; height: 38px; spacing: root.short ? 6px : 11px;
                Eyebrow { text: "NOW PLAYING"; }
                Rectangle { horizontal-stretch: 1; }
                if root.next-title != "": Caption {
                    text: "Up next · " + root.next-title + (root.next-subtitle == "" ? "" : " · " + root.next-subtitle);
                    horizontal-alignment: right;
                    min-width: 0px; max-width: root.header ? 420px : 210px;
                    horizontal-stretch: 2;
                }
            }

            if !root.has-track: VerticalLayout {
                y: 59px; height: 100px; alignment: start; spacing: 6px;
                Text {
                    text: "Nothing playing"; color: Theme.text;
                    font-size: 28px * Theme.density; font-weight: 700;
                    wrap: word-wrap;
                }
                Caption { text: "Play a track from your library to get started."; font-size: 14px * Theme.density; wrap: word-wrap; }
            }

            deck := Rectangle {
                visible: root.has-track;
                x: (stage.width - self.width) / 2; y: root.deck-top;
                width: root.deck-lane;
                property <length> stack-identity-y: root.art-size + (root.short ? 10px : 16px);
                property <length> identity-row-height: max(root.art-size, identity.height, root.header-wide ? controls.height : 0px);
                property <length> stack-controls-y: (root.header ? self.identity-row-height : self.stack-identity-y + identity.height) + 10px;
                height: root.header-wide ? self.identity-row-height : self.stack-controls-y + controls.height;

                Cover {
                    x: root.header ? 0px : (parent.width - self.width) / 2;
                    y: root.header ? (deck.identity-row-height - self.height) / 2 : 0px;
                    artwork: root.artwork; width: root.art-size; height: root.art-size;
                }
                identity := VerticalLayout {
                    x: root.header ? root.art-size + 26px : 0px;
                    y: root.header ? (deck.identity-row-height - self.height) / 2 : deck.stack-identity-y;
                    width: max(0px, parent.width - self.x - (root.header-wide ? root.header-controls-width + 36px : 0px));
                    height: self.preferred-height; alignment: start; spacing: 3px;
                    Text {
                        text: root.track;
                        horizontal-alignment: root.header ? left : center;
                        color: Theme.text;
                        font-size: (root.short ? 24px : root.header-wide ? 35px : 30px) * Theme.density;
                        font-weight: 750;
                        letter-spacing: -0.45px;
                        wrap: word-wrap;
                        accessible-label: root.track;
                    }
                    if root.subtitle != "" || root.credits.length > 0: artist-line := WrappingCredits {
                        credits: root.credits; fallback: root.subtitle; centered: !root.header;
                        interactive: root.metadata-interactive;
                        font-size: 15px * Theme.density;
                        focused(y, h) => { root.reveal(stage.y + deck.y + identity.y + artist-line.y + y, h); }
                        activated(id) => { root.page-action("artist", id); }
                    }
                    if root.show-album || root.show-context: source-line := HorizontalLayout {
                        height: 34px; spacing: 8px;
                        if root.link-album: Rectangle {
                            width: min(album.min-width, parent.width * (root.show-context ? 0.49 : 1));
                            album := Action {
                                width: parent.width; height: parent.height;
                                text: root.album-label == "" ? "Album" : root.album-label;
                                icon: "◎"; quiet: true; leading: true;
                                accessible-label: root.album-label == "" ? "Open album" : "Open album: " + root.album-label;
                                changed has-focus => { if self.has-focus { root.reveal(stage.y + deck.y + identity.y + source-line.y, source-line.height); } }
                                clicked => { root.page-action("album", root.album-id); }
                            }
                        }
                        if root.show-album && !root.link-album: Caption {
                            min-width: 0px;
                            max-width: root.show-context ? parent.width * 0.49 : parent.width;
                            text: root.album-label;
                        }
                        if root.show-context: Action {
                            min-width: 0px; height: 34px; horizontal-stretch: 1;
                            text: "From " + root.context-name; icon: "↗"; quiet: true; leading: true;
                            accessible-label: "Open playback source: " + root.context-name;
                            changed has-focus => { if self.has-focus { root.reveal(stage.y + deck.y + identity.y + source-line.y, source-line.height); } }
                            clicked => { root.page-action("context-" + root.context-kind, root.context-id); }
                        }
                        if !root.show-context: Rectangle { horizontal-stretch: 1; }
                    }
                }
                controls := Rectangle {
                    property <bool> side-by-side: root.header && !root.header-wide && root.duration > 0;
                    property <length> seek-height: root.duration > 0 ? 49px : 0px;
                    property <length> transport-gap: root.duration > 0 ? (root.short ? 3px : 9px) : 0px;
                    x: root.header-wide ? parent.width - self.width : 0px;
                    y: root.header-wide ? (deck.identity-row-height - self.height) / 2 : deck.stack-controls-y;
                    width: root.header-wide ? root.header-controls-width : parent.width;
                    height: self.side-by-side ? max(self.seek-height, playback-row.height) : self.seek-height + self.transport-gap + playback-row.height;
                    VerticalLayout {
                        x: 0px; y: 0px;
                        width: controls.side-by-side ? max(0px, parent.width - playback-row.width - 20px) : parent.width;
                        height: controls.seek-height;
                        if root.duration > 0: SeekBar {
                            height: 30px;
                            elapsed: root.elapsed; duration: root.duration;
                            enabled: root.has-track && root.can-seek;
                            waveform: root.waveform;
                            seek(value) => { root.seek(value); }
                        }
                        if root.duration > 0: HorizontalLayout {
                            height: 19px; padding-left: 2px; padding-right: 2px;
                            PlayerTime { seconds: min(root.elapsed, root.duration); accessible-label: "Elapsed " + self.text; }
                            Rectangle { horizontal-stretch: 1; }
                            PlayerTime { seconds: root.duration; accessible-label: "Duration " + self.text; }
                        }
                    }
                    playback-row := HorizontalLayout {
                        x: controls.side-by-side ? parent.width - self.width : 0px;
                        y: controls.side-by-side ? (controls.seek-height - self.height) / 2 : controls.seek-height + controls.transport-gap;
                        width: controls.side-by-side ? self.preferred-width : parent.width;
                        height: 44px; alignment: center;
                        Transport {
                            playing: root.playing; available: root.has-track && root.can-toggle; skip-enabled: root.has-track && root.can-skip;
                            shuffle: root.shuffle; repeat-mode: root.repeat-mode; modes-enabled: root.has-track && root.can-change-modes;
                            previous => { root.previous(); }
                            toggle => { root.toggle(); }
                            next => { root.next(); }
                            focused => { root.reveal(stage.y + deck.y + controls.y + playback-row.y, playback-row.height); }
                            queue-action(op, key) => { root.queue-action(op, key); }
                        }
                    }
                }
            }

            lyrics := LyricsReader {
                visible: root.has-track;
                width: stage.width;
                y: deck.y + deck.height + 22px;
                height: self.preferred-height;
                reading-height: max(112px, scroll.visible-height - stage.y - self.y - self.heading-height - 26px);
                active: root.has-track;
                track-id: root.track-id; lyrics: root.offline ? "" : root.lyrics-text;
                lines: root.offline ? [] : root.lyrics-lines;
                attribution: root.offline ? "" : root.lyrics-attribution;
                active-line: root.active-lyric-line;
                status: root.offline ? "Lyrics unavailable offline." : root.lyrics-status != "" ? root.lyrics-status : "Loading lyrics…";
                reveal => { root.align-lyrics(); }
            }
        }
    }
}
