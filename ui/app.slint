import { ScrollView } from "std-widgets.slint";
import { Action, Caption, Divider, Eyebrow, Field, Notice, Theme } from "theme.slint";
import { Copy, EmptyState, Hero, MediaLine } from "catalog.slint";
import { PlaylistDetailHeader } from "playlist-detail.slint";
import { ReorderList, ReorderRow } from "reorder.slint";
import { ArtistCredit } from "credits.slint";
import { Editor, SignInView } from "forms.slint";
import { DockLayout, PlayerBar } from "playback.slint";
import { DeviceRow } from "output-picker.slint";
import { NowPlaying, TimedLyricLine } from "now-playing.slint";
import { Settings } from "settings.slint";
import { PlaybackTools, WorkspaceRail } from "workspace-parts.slint";
import "../assets/JetBrainsMono-v2.304-wght.ttf";
export { ArtistCredit, DeviceRow, ReorderRow }

export struct BrowseRow {
    kind: string, title: string, subtitle: string, detail: string, playable: bool, can-open: bool, actions: [string], section: string,
    credits: [ArtistCredit], album-id: string, album-name: string, track-id: string, occurrence-key: string, playlist-pinned: bool,
}
export struct QueueRow {
    key: string, track-id: string, title: string, subtitle: string, current: bool, upcoming: bool,
    credits: [ArtistCredit], album-id: string, album-name: string,
}

export struct PlaylistActions {
    play: bool, queue: bool, offline-action: string, rename: bool, rules: bool, remove-action: string,
}

export struct PlaylistOfflineState { saved: bool, feedback: string }

struct RowRange { start: int, end: int }

component BrowseLine inherits MediaLine {
    in property <BrowseRow> entry;
    in property <int> index;
    in property <string> page-kind;
    in property <bool> is-playlist;
    in property <bool> local-mode;
    in property <bool> can-play-local;
    title: entry.title; subtitle: entry.subtitle; detail: entry.detail; kind: entry.kind;
    search-result: page-kind == "search";
    sequence: page-kind == "album" || is-playlist ? index + 1 : 0;
    occurrence-description: is-playlist || page-kind == "saved-collection" ? "Song " + (index + 1) : "";
    credits: entry.credits; metadata-enabled: !local-mode && page-kind != "picker";
    album-id: entry.album-id;
    album-name: page-kind == "album" || page-kind == "picker" || entry.kind != "track" ? "" : entry.album-name;
    playable: entry.playable && (!local-mode || can-play-local) && page-kind != "picker";
    can-open: entry.can-open && (!local-mode || entry.kind == "saved-collection");
    open-label: page-kind == "picker" ? "Add to " + entry.title : "Open " + entry.title;
    selectable: entry.kind == "track";
    actions: page-kind == "picker" ? []
        : !local-mode || page-kind == "offline" ? entry.actions
        : page-kind == "playlists" && entry.playlist-pinned ? ["unpin-playlist"] : [];
}

export component AppWindow inherits Window {
    title: "Spofify Desktop";
    icon: @image-url("../assets/spofify-logo.svg");
    in property <length> inspection-width: 0px;
    in property <length> inspection-height: 0px;
    in property <bool> inspection-reorder-line;
    in property <bool> reduced-motion;
    preferred-width: 1280px;
    preferred-height: 790px;
    min-width: root.inspection-width > 0px ? root.inspection-width : 480px;
    max-width: root.inspection-width > 0px ? root.inspection-width : 65535px;
    min-height: root.inspection-height > 0px ? root.inspection-height : 440px;
    max-height: root.inspection-height > 0px ? root.inspection-height : 65535px;
    default-font-family: "JetBrains Mono";

    in-out property <string> origin;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> keep-signed-in;
    in-out property <string> query;
    in property <bool> signed-in;
    in property <bool> busy;
    in property <bool> restoring-login;
    in property <string> auth-notice;
    in property <string> status;
    in property <bool> error;
    in property <string> now-title: "Nothing playing";
    in property <string> now-detail: "Find a track to begin";
    in property <string> player-status;
    in property <string> update-notice;
    in property <string> update-action;
    in property <string> update-button;
    callback download-update();
    in property <bool> playing;
    in property <bool> can-control;
    in property <bool> remote-controls;
    in property <bool> can-seek;
    in property <string> output-name;
    in property <float> elapsed;
    in property <float> duration;
    in property <string> time-label;
    callback sign-in();
    callback sign-out();
    callback cancel-sign-in();
    callback server-edited();
    callback username-edited();
    callback search-edited();
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);

    in property <[BrowseRow]> browse-rows;
    // The scroll surface owns geometry; the adapter mounts only these absolute indices.
    in property <[int]> visible-playlist-indices;
    callback playlist-viewport-changed(int, int);
    // Invalidates in-flight row gestures before an accepted model changes indices.
    in property <string> browse-model-key;
    in property <[image]> browse-artwork;
    in property <image> page-artwork;
    in property <[ArtistCredit]> page-credits;
    in property <string> page-title;
    in property <string> page-key;
    in property <string> page-subtitle;
    in property <string> page-kind: "search";
    in property <string> page-status;
    in property <bool> page-busy;
    in property <bool> page-error;
    in property <string> catalog-request-key;
    in property <string> catalog-continuation-status;
    in property <bool> catalog-loading;
    in property <string> catalog-return-key;
    in property <float> catalog-return-y;
    in property <int> catalog-return-anchor: -1;
    in property <float> catalog-return-offset;
    in property <int> catalog-return-row: -1;
    in property <string> catalog-return-part;
    in property <string> catalog-return-credit;
    in property <int> catalog-return-serial;
    in-out property <float> catalog-scroll-y;
    in-out property <int> catalog-anchor-row: -1;
    in-out property <float> catalog-anchor-y;
    in-out property <int> catalog-focused-row: -1;
    in-out property <string> catalog-focused-part;
    in-out property <string> catalog-focused-credit;
    // True only during a synchronous row-originated navigation callback.
    in-out property <bool> catalog-row-navigation;
    callback catalog-demand(string);
    in property <bool> can-back;
    in property <[string]> page-actions;
    in property <PlaylistActions> playlist-actions;
    in property <string> playlist-metadata;
    in property <string> playlist-description;
    in property <PlaylistOfflineState> playlist-offline-state;
    in property <[ReorderRow]> playlist-order-rows;
    in property <string> playlist-order-scope;
    in property <bool> playlist-order-pending;
    callback playlist-order-drop(string, string, string);
    in property <int> saved-pin-focus-serial;
    callback navigate(string);
    callback row-action(string, int);
    callback page-action(string, string);

    in-out property <string> form-mode;
    in-out property <string> form-name;
    in-out property <string> form-description;
    in-out property <string> form-value;
    in-out property <string> form-error;
    in property <bool> form-busy;
    in-out property <string> form-help;

    in property <string> now-track-id;
    in property <string> now-album-id;
    in property <string> now-album-name;
    in property <[ArtistCredit]> now-credits;
    in property <string> next-title;
    in property <string> next-subtitle;
    in property <string> now-artist-id;
    in property <string> now-context-kind;
    in property <string> now-context-id;
    in property <string> now-context-name;
    in property <image> cover-art;
    in property <string> lyrics-track-id;
    in property <string> lyrics-text;
    in property <[TimedLyricLine]> lyrics-lines;
    in property <string> lyrics-attribution;
    in property <string> lyrics-status;
    in-out property <int> lyrics-open-generation;
    pure callback resolve-active-lyric([TimedLyricLine], float, float) -> int;
    in property <[float]> waveform;
    in property <string> media-status;
    in property <string> account-label;
    in property <bool> manual-offline;
    in property <bool> reconnecting;
    in property <bool> local-playback;
    in property <string> music-storage;
    in property <bool> crossfade-enabled;
    in property <string> crossfade-status;
    callback crossfade-changed(bool);
    in property <float> density-scale: 1.0;
    callback density-changed(float);

    in property <string> room-token;
    in property <string> media-track-token;
    in property <[QueueRow]> queue-rows;
    in property <[ReorderRow]> queue-order-rows;
    in property <string> queue-order-token;
    in property <bool> queue-order-writable;
    in property <bool> queue-order-awaiting-echo;
    callback queue-order-drop(string, string, string);
    in property <[DeviceRow]> device-rows;
    in property <string> queue-status;
    in property <string> device-status;
    in property <bool> shuffle;
    in property <string> repeat-mode: "off";
    callback queue-action(string, string);
    in property <float> local-volume: 1;
    in property <bool> local-muted;
    callback local-volume-change(float);
    callback local-mute-toggle();
    callback device-action(string, string, string);

    default-font-size: 13px * Theme.density;
    background: Theme.bg;
    changed density-scale => { Theme.density = clamp(root.density-scale, 0.85, 1.25); }
    property <image> no-artwork;

    property <bool> compact: self.width < 820px;
    property <bool> wide: self.width >= 1136px;
    property <length> rail-width: self.width >= 1480px ? 224px : root.compact ? 164px : 194px;
    property <length> queue-width: clamp(self.width * 0.229, 304px, 390px);
    property <length> toolbar-height: root.compact ? 57px : 65px;
    property <string> playback-status: root.player-status != "" ? root.player-status : root.reconnecting ? "Connecting…" : "";
    property <bool> dock-visible: root.now-track-id != "" && !root.is-now && !root.editor-open;
    property <bool> toolbar-playback: !root.dock-visible && !root.editor-open;
    property <string> device-picker-context: root.page-kind + "|" + root.page-key + "|" + root.account-label;
    property <string> device-picker-status: root.reconnecting ? "Connecting…" : root.device-status;
    property <length> player-height: root.dock-visible ? DockLayout.height(root.compact) : 0px;
    property <bool> wide-queue-open: true;
    property <bool> compact-queue-open;
    property <bool> queue-shown: root.wide ? root.wide-queue-open : root.compact-queue-open;
    property <bool> editor-open: form-mode != "" && form-mode != "closed";
    property <bool> is-search: page-kind == "search";
    property <bool> is-history: page-kind == "history" || page-kind == "recent";
    property <bool> is-playlist: page-kind == "playlist" || page-kind == "playlist-manual" || page-kind == "playlist-rules";
    property <bool> playlist-detail: self.is-playlist || self.page-kind == "saved-collection";
    property <bool> is-settings: page-kind == "appearance" || page-kind == "settings" || page-kind == "account";
    property <bool> is-now: page-kind == "now";
    property <bool> saved-view: page-kind == "offline" || page-kind == "saved-collection";
    property <bool> local-mode: manual-offline || reconnecting;
    property <bool> can-play-local: root.saved-view || (root.manual-offline && root.is-search);
    property <bool> queue-controls: local-playback ? can-control : !local-mode && remote-controls;
    property <bool> queue-has-upcoming: queue-rows.length > 0 && queue-rows[queue-rows.length - 1].upcoming;
    property <string> catalog-title: page-kind == "offline" ? "Saved offline" : page-title != "" ? page-title : Copy.title(page-kind);
    in-out property <string> form-return;
    property <string> saved-removal-key;
    property <string> confirmation-title;
    property <int> form-focus-serial;
    changed wide => { root.compact-queue-open = false; }
    changed signed-in => {
        if !root.signed-in {
            root.compact-queue-open = false;
            root.wide-queue-open = true;
            root.form-return = "";
        }
    }

    function flip-offline() { root.page-action("offline", root.reconnecting || !root.manual-offline ? "on" : "off"); }
    function edit-form(mode: string) {
        root.form-return = mode;
        root.form-name = "";
        root.form-description = "";
        root.form-value = "";
        root.form-mode = mode;
        if mode != "remove-saved" { root.page-action("prepare-" + mode, ""); }
    }
    public function show-playlist-editor(key: string, mode: string, name: string, description: string, rules: string, help: string) {
        if root.page-key == key && root.is-playlist && !root.editor-open && !root.compact-queue-open && !root.local-mode {
            root.form-return = mode;
            root.confirmation-title = mode == "delete" ? root.catalog-title : "";
            root.form-name = name;
            root.form-description = description;
            root.form-value = rules;
            root.form-help = mode == "rules" ? help : "";
            root.form-error = "";
            root.form-mode = mode;
        }
    }
    function confirm-saved-removal(action: string) {
        root.edit-form("remove-saved");
        root.form-return = action;
        root.saved-removal-key = root.page-key;
        root.confirmation-title = root.playlist-detail ? root.catalog-title : "";
        root.form-error = "";
    }
    function cancel-form() {
        if root.form-mode != "remove-saved" { root.page-action("cancel-form", root.form-mode); }
        root.form-mode = "";
        root.form-name = "";
        root.form-description = "";
        root.form-value = "";
    }
    function submit-form() {
        if root.form-mode == "remove-saved" {
            if root.saved-removal-key == root.page-key
                && (root.form-return == root.playlist-actions.remove-action || root.form-return == root.playlist-actions.offline-action) {
                root.page-action(root.form-return, "");
            } else { root.form-error = "This saved collection changed. Close the confirmation and open it again."; }
        }
        else { root.page-action(root.form-mode, root.form-mode == "rules" || root.form-mode == "new-rules" ? root.form-value : root.form-mode == "delete" ? "" : root.form-name); }
    }
    function catalog-action(action: string) {
        if action == "new-manual" || action == "new-rules" { root.edit-form(action); }
        else if action == "remove" { root.confirm-saved-removal(action); }
        else { root.page-action(action, ""); }
    }

    if !root.signed-in: SignInView {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        origin <=> root.origin; username <=> root.username; password <=> root.password;
        keep-signed-in <=> root.keep-signed-in;
        status: root.status; error: root.error; busy: root.busy;
        restoring: root.restoring-login; auth-notice: root.auth-notice;
        server-edited => { root.server-edited(); } username-edited => { root.username-edited(); }
        sign-in => { root.sign-in(); } cancel => { root.cancel-sign-in(); }
    }
    if root.signed-in: shell := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        focus-on-tab-navigation: false; focus-on-click: false;
        property <string> destination: root.page-kind;
        property <bool> editing: root.editor-open;
        property <string> account-scope: root.account-label;
        // Two account-local return slots, owned by the signed-in shell.
        property <string> search-return-key;
        property <length> search-return-y;
        property <string> playlist-return-key;
        property <length> playlist-return-y;
        property <int> playlist-return-row: -1;
        property <string> playlist-return-occurrence;
        property <string> playlist-return-control;
        property <bool> returning;
        property <string> restoring-key;
        property <length> restoring-y;
        property <int> restoring-row: -1;
        property <int> playlist-order-start;
        property <int> dock-queue-focus-serial;
        property <bool> dock-queue-pointer-focus;
        property <bool> lyrics-entry;
        property <bool> restore-lyrics-focus;
        property <bool> queue-order-edit;
        property <bool> playlist-order-edit;
        property <bool> queue-visible: root.queue-shown;
        property <bool> local-mode: root.local-mode;
        property <bool> local-playback: root.local-playback;
        property <string> order-route: root.page-kind + "|" + root.page-key;
        changed queue-visible => {
            if !self.queue-visible { queue-order.cancel-grab(); self.queue-order-edit = false; }
        }
        changed local-mode => { self.leave-orders(); }
        changed local-playback => { queue-order.cancel-grab(); self.queue-order-edit = false; }
        changed order-route => { self.leave-orders(); }
        function leave-orders() {
            queue-order.cancel-grab(); playlist-order.cancel-grab();
            self.queue-order-edit = false; self.playlist-order-edit = false;
        }
        init => { self.focus(); }
        changed account-scope => {
            self.search-return-key = "";
            self.playlist-return-key = "";
            self.restoring-key = "";
            self.returning = false;
        }
        function remember-scroll(row: int, control: string) {
            if root.is-search && root.query != "" {
                self.search-return-key = catalog-scroll.scroll-key;
                self.search-return-y = catalog-scroll.content-y;
            } else if root.playlist-detail {
                self.playlist-return-key = catalog-scroll.scroll-key;
                self.playlist-return-y = catalog-scroll.content-y;
                self.playlist-return-row = row;
                self.playlist-return-occurrence = row >= 0 && row < root.browse-rows.length ? root.browse-rows[row].occurrence-key : "";
                self.playlist-return-control = control;
            }
        }
        function browse(op: string, index: int) {
            if op == "open" || op == "add" { self.remember-scroll(index, op == "add" ? "menu" : ""); }
            root.row-action(op, index);
        }
        function edited-search() {
            self.leave-orders();
            root.compact-queue-open = false;
            self.returning = false;
            self.restoring-key = "";
            root.search-edited();
        }
        function apply-return-scroll() {
            if catalog-scroll.restore-catalog {
                self.restoring-key = "";
                return;
            }
            if self.restoring-key == "" || self.restoring-key != catalog-scroll.scroll-key { return; }
            if root.playlist-detail && root.page-busy && root.browse-rows.length == 0 { return; }
            catalog-scroll.set-scroll(self.restoring-y);
            if catalog-scroll.content-y == self.restoring-y || (root.playlist-detail && !root.page-busy) {
                let row = self.restoring-row;
                if root.playlist-detail && row >= catalog-list.mount-range.start && row < catalog-list.mount-range.end
                    && root.browse-rows[row].occurrence-key == self.playlist-return-occurrence {
                    catalog-list.focus-row(row, false, self.playlist-return-control);
                }
                self.restoring-key = "";
            }
        }
        function destination-scrolled() {
            self.restoring-key = "";
            self.restoring-row = -1;
            catalog-list.focused-row = -1;
            catalog-list.focus-owner = -1;
            catalog-list.focus-request = -1;
            catalog-scroll.set-scroll(0px);
            if self.returning {
                self.returning = false;
                if root.is-search && catalog-scroll.scroll-key == self.search-return-key {
                    self.restoring-key = self.search-return-key;
                    self.restoring-y = self.search-return-y;
                } else if root.playlist-detail && catalog-scroll.scroll-key == self.playlist-return-key {
                    self.restoring-key = self.playlist-return-key;
                    self.restoring-y = self.playlist-return-y;
                    self.restoring-row = self.playlist-return-row;
                }
                self.apply-return-scroll();
            }
        }
        changed destination => {
            if !root.editor-open && !root.compact-queue-open && !(root.is-now && self.lyrics-entry)
                && !(root.dock-visible && self.restore-lyrics-focus) {
                if root.is-search { search.take-focus(); }
                else if !history-pane.has-focus { self.focus(); }
            }
        }
        changed editing => {
            if self.editing { self.leave-orders(); }
            if !self.editing {
                // The browse view is still mounted. Focus the action that opened the editor if it survived.
                if back-button.enabled { back-button.take-focus(); }
                else { rail.restore-focus(); }
                root.form-focus-serial += 1;
            }
        }
        property <int> saved-pin-focus: root.saved-pin-focus-serial;
        changed saved-pin-focus => {
            if (root.page-kind == "offline" || (root.page-kind == "playlists" && root.local-mode))
                && !root.editor-open && !root.compact-queue-open { rail.restore-focus(); }
        }
        function toggle-queue(by-pointer: bool) {
            if root.editor-open { return; }
            if root.queue-shown { self.hide-queue(by-pointer); }
            else {
                if root.wide { root.wide-queue-open = true; }
                else { root.compact-queue-open = true; }
                if by-pointer { queue-close.take-pointer-focus(); }
                else { queue-close.take-focus(); }
            }
        }
        function hide-queue(by-pointer: bool) {
            queue-order.cancel-grab();
            self.queue-order-edit = false;
            if root.wide { root.wide-queue-open = false; }
            else { root.compact-queue-open = false; }
            if root.dock-visible {
                self.dock-queue-pointer-focus = by-pointer;
                self.dock-queue-focus-serial += 1;
            } else if root.toolbar-playback { playback-tools.focus-queue(); }
        }
        function route(target: string) {
            if root.editor-open { return; }
            if target == "queue" {
                self.toggle-queue(false);
            } else {
                self.leave-orders();
                self.returning = target == "back";
                if !self.returning { self.remember-scroll(-1, ""); }
                self.restoring-key = "";
                root.compact-queue-open = false;
                // Retire the outgoing page's focus even on Back between two pages of the same kind.
                if self.returning { self.focus(); }
                self.restore-lyrics-focus = self.returning && root.is-now && self.lyrics-entry && root.now-track-id != "";
                self.lyrics-entry = target == "lyrics";
                root.navigate(self.lyrics-entry ? "now" : target);
            }
        }
        function entity(kind: string, id: string, row: int) {
            if !root.local-mode && !root.editor-open && id != "" {
                self.leave-orders();
                self.remember-scroll(row, kind + ":" + id);
                if root.compact-queue-open { root.compact-queue-open = false; self.focus(); }
                root.page-action(kind, id);
            }
        }
        capture-key-pressed(event) => {
            if root.editor-open { return reject; }
            if event.modifiers.control && (event.text == "f" || event.text == "l" || event.text == "F" || event.text == "L") {
                root.compact-queue-open = false;
                search.take-focus(); return accept;
            }
            if event.text == Key.Escape {
                if queue-order.cancel-grab() || playlist-order.cancel-grab() { return accept; }
            }
            if event.text == Key.Escape || (event.modifiers.alt && event.text == Key.LeftArrow) {
                if root.compact-queue-open {
                    if !event.repeat { self.hide-queue(false); }
                    return accept;
                }
                if root.can-back {
                    if !event.repeat { self.route("back"); }
                    return accept;
                }
            }
            return reject;
        }
        session-notice := Notice {
            x: 8px; y: 0px; width: parent.width - 16px;
            height: root.auth-notice == "" ? 0px : self.min-height;
            visible: root.auth-notice != "";
            text: root.auth-notice;
        }
        update-banner := Rectangle {
            x: 0px; y: session-notice.height; width: parent.width;
            visible: root.update-notice != "";
            height: self.visible ? update-content.preferred-height : 0px;
            background: Theme.rail;
            update-content := HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 3px; padding-bottom: 3px;
                spacing: 8px;
                Caption {
                    text: root.update-notice; wrap: word-wrap; horizontal-stretch: 1;
                    accessible-role: text; accessible-label: self.text; accessible-live-region: polite;
                }
                if root.update-button != "": Action {
                    text: root.update-button; enabled: !root.editor-open && root.update-action != "";
                    click-scope: root.update-action;
                    clicked => {
                        if self.has-focus { shell.focus(); }
                        root.download-update();
                    }
                }
            }
            Divider { y: parent.height - 1px; }
        }
        work := Rectangle {
            x: 0px; y: update-banner.y + update-banner.height; width: parent.width; height: parent.height - self.y - root.player-height;
            rail := WorkspaceRail {
                x: 0px; y: 0px; width: root.rail-width; height: parent.height;
                kind: root.page-kind; account: root.account-label; compact: root.compact;
                offline: root.manual-offline; reconnecting: root.reconnecting; locked: root.editor-open;
                navigate(target) => { shell.route(target); }
            }
            main := Rectangle {
                x: root.rail-width; y: 0px; height: parent.height;
                width: parent.width - self.x - (root.wide && root.queue-shown ? root.queue-width : 0px);
                property <length> inset: clamp(self.width * 0.038, 14px, 38px);
                property <bool> narrow: self.width < 640px;
                toolbar := Rectangle {
                    x: 0px; y: 0px; width: parent.width; height: root.toolbar-height;
                    background: Theme.rail;
                    Divider { x: 0px; y: parent.height - 1px; }
                    HorizontalLayout {
                        padding-left: main.inset; padding-right: main.inset; spacing: root.toolbar-playback ? 8px : 0px;
                        Rectangle {
                            horizontal-stretch: 1; min-width: 0px;
                            search := Field {
                                y: (parent.height - self.height) / 2; width: parent.width; height: 39px;
                                text <=> root.query; prefix: "⌕"; clearable: true; enabled: !root.editor-open;
                                field-label: root.local-mode ? "Search downloads" : "Search tracks, albums or artists";
                                placeholder-text: root.local-mode ? "Search downloads" : main.width < 420px ? "Search music" : "Search tracks, albums or artists";
                                cleared => { shell.edited-search(); }
                                edited => { shell.edited-search(); }
                                accepted => { shell.edited-search(); }
                            }
                        }
                        Rectangle {
                            visible: root.toolbar-playback;
                            width: self.visible ? playback-tools.preferred-width : 0px;
                            playback-tools := PlaybackTools {
                                x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: 38px;
                                labeled: !main.narrow; enabled: root.toolbar-playback;
                                queue-open: root.queue-shown; status: root.playback-status;
                                context-key: root.device-picker-context;
                                window-width: root.width; window-height: root.height;
                                devices: root.device-rows; output: root.output-name;
                                device-status: root.device-picker-status; offline: root.local-mode;
                                device-action(op, id, name) => { root.device-action(op, id, name); }
                                navigate(target) => { shell.route(target); }
                            }
                        }
                    }
                }
                property <bool> can-edit-order: root.is-playlist && root.playlist-order-scope != "";
                // Only one Edit order target is shown. Keep the established deep-scroll
                // shortcut and restore to it without revealing the header on Done.
                property <bool> sticky-order: self.can-edit-order
                    && -catalog-scroll.content-y > header-slot.y + playlist-header.order-top;
                changed sticky-order => {
                    if !self.can-edit-order || !catalog-scroll.visible || !history-pane.visible { return; }
                    if self.sticky-order && playlist-header.order-has-focus && edit-playlist-order.enabled {
                        edit-playlist-order.take-focus();
                    } else if !self.sticky-order && edit-playlist-order.has-focus {
