import { ScrollView, Slider } from "std-widgets.slint";
import { Theme, Action, Field, Consent, Cover } from "theme.slint";
import "../assets/JetBrainsMono-v2.304-wght.ttf";
export struct TrackRow { title: string, subtitle: string, detail: string, playable: bool }

export component AppWindow inherits Window {
    title: "Spofify Desktop";
    in property <length> inspection-width: 0px;
    in property <length> inspection-height: 0px;
    preferred-width: 1100px; preferred-height: 760px;
    min-width: root.inspection-width > 0px ? root.inspection-width : 800px;
    max-width: root.inspection-width > 0px ? root.inspection-width : 65535px;
    min-height: root.inspection-height > 0px ? root.inspection-height : 600px;
    max-height: root.inspection-height > 0px ? root.inspection-height : 65535px;
    background: Theme.bg;
    default-font-family: "JetBrains Mono";
    default-font-size: 14px;
    in-out property <string> origin;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> query;
    in-out property <bool> lan-consent;
    in property <bool> signed-in;
    in property <bool> busy;
    in property <bool> retry-visible;
    in property <string> status;
    in property <string> result-label;
    in property <bool> error;
    in property <[TrackRow]> rows;
    in property <string> now-title: "Nothing playing";
    in property <string> now-detail: "Find a track to begin";
    in property <string> player-status;
    in property <bool> playing;
    in property <bool> can-control;
    in property <bool> remote-controls;
    in property <bool> can-seek;
    in property <bool> player-retry;
    in property <bool> player-retry-allowed;
    in property <string> output-name;
    in property <float> elapsed;
    in property <float> duration;
    in property <string> time-label;
    callback sign-in();
    callback sign-out();
    callback server-edited();
    callback search-edited();
    callback play-track(int);
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);
    callback retry-player();
    callback retry();

    VerticalLayout {
        padding: 0px; spacing: 0px;
        Rectangle {
            height: 58px; background: #10151b;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px; padding-top: 12px; padding-bottom: 12px; spacing: 12px;
                Rectangle { width: 28px; Image { y: (parent.height - 28px) / 2; width: 28px; height: 28px; source: @image-url("../assets/spofify-logo.svg"); accessible-role: none; } }
                Text { text: "Spofify"; color: Theme.text; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 1px; Rectangle { y: (parent.height - 20px) / 2; height: 20px; background: Theme.line; } }
                Text { text: "Desktop"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if root.signed-in: Action { text: "Sign out"; clicked => { root.sign-out(); } }
            }
        }
        if !root.signed-in: Rectangle {
            vertical-stretch: 1;
            // Explicit card width and bounded content height avoid width/wrap layout cycles.
            VerticalLayout {
                x: (parent.width - 480px) / 2;
                y: max(12px, (parent.height - 492px) / 2);
                width: 480px; height: 492px;
                padding: 0px; spacing: 7px;
                Text { height: 32px; text: "Connect to your music"; color: Theme.text; font-size: 23px; font-weight: 700; }
                Text { height: 22px; text: "Sign in to your Spofify server to search and play."; color: Theme.muted; font-size: 12px; }
                Text { height: 18px; text: "Server origin"; color: Theme.muted; font-size: 12px; }
                Field { text <=> root.origin; field-label: "Server origin"; placeholder-text: "https://music.example.com"; edited => { root.server-edited(); } }
                Text { height: 18px; text: "HTTPS recommended. Origin only, no path."; color: Theme.muted; font-size: 11px; }
                Text { height: 18px; text: "Username"; color: Theme.muted; font-size: 12px; }
                Field { text <=> root.username; field-label: "Username"; enabled: !root.busy; }
                Text { height: 18px; text: "Password"; color: Theme.muted; font-size: 12px; }
                Field { text <=> root.password; input-type: InputType.password; field-label: "Password"; enabled: !root.busy; accepted => { root.sign-in(); } }
                Consent { text: "Allow trusted-LAN HTTP"; checked <=> root.lan-consent; enabled: !root.busy; }
                Text { height: 34px; text: "HTTP sends credentials unencrypted. Only private, loopback or Tailscale IPs are allowed. Use a network you trust."; color: Theme.amber; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px; height: 36px;
                    Action { text: root.busy ? "Signing in…" : "Sign in"; accessible-label: "Sign in"; enabled: !root.busy; primary: true; horizontal-stretch: 1; clicked => { root.sign-in(); } }
                    if root.busy: Action { text: "Cancel sign in"; clicked => { root.sign-out(); } }
                }
                Text { height: 50px; text: root.status; color: root.error ? Theme.red : Theme.muted; font-size: 12px; wrap: word-wrap; accessible-label: root.status; }
            }
        }
        if root.signed-in: VerticalLayout {
            padding-left: 32px; padding-right: 32px; padding-top: 24px; padding-bottom: 20px; spacing: 16px;
            Field { text <=> root.query; pill: true; field-label: "Search tracks"; placeholder-text: "Search tracks, artists or albums"; edited => { root.search-edited(); } }
            HorizontalLayout {
                height: 26px;
                Text { text: "Tracks"; color: Theme.text; font-size: 19px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: root.busy ? "Searching…" : root.result-label; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            }
            if root.status != "": Text { text: root.status; color: root.error ? Theme.red : Theme.muted; font-size: 12px; wrap: word-wrap; accessible-label: root.status; }
            if root.retry-visible && !root.busy: Action { text: "Retry search"; clicked => { root.retry(); } }
            Rectangle {
                vertical-stretch: 1;
                if root.rows.length == 0 && !root.busy && !root.error: VerticalLayout {
                    padding-top: 36px; spacing: 10px; alignment: start;
                    Text { text: root.query == "" ? "Your next listen starts here." : "No tracks found."; color: Theme.text; font-size: 16px; horizontal-alignment: center; }
                    Text { text: root.query == "" ? "Search your library by track, artist or album." : "Try another title, artist or album."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
                }
                ScrollView {
                    width: parent.width; height: parent.height; content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 0px; padding: 0px;
                        for row[index] in root.rows: Rectangle {
                            height: 66px;
                            Rectangle { y: parent.height - 1px; height: 1px; background: #ffffff0b; }
                            HorizontalLayout {
                                padding-top: 10px; padding-bottom: 10px; padding-left: 4px; padding-right: 8px; spacing: 14px;
                                Rectangle { width: 34px; Action { y: 7px; text: "▶"; round: true; width: 34px; height: 32px; accessible-label: "Play " + row.title; enabled: row.playable && !root.busy; clicked => { root.play-track(index); } } }
                                Cover { width: 46px; height: 46px; }
                                VerticalLayout {
                                    spacing: 4px; alignment: center; horizontal-stretch: 1;
                                    Text { text: row.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: row.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
                                }
                                Text { text: row.detail; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            Text { text: "Up to 20 tracks · Refine your search for more specific results"; color: Theme.muted; font-size: 11px; }
        }
        if root.signed-in: Rectangle {
            height: 132px; min-width: 0px; background: #111716;
            Rectangle { y: 0px; height: 1px; background: Theme.line; }
            // Bounded regions keep transport centered without feeding window width into layout minima.
            Cover { x: 24px; y: 24px; width: 58px; height: 58px; border-radius: Theme.radius; }
            Text { x: 98px; y: 34px; width: parent.width / 3 - 110px; height: 20px; text: root.now-title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; accessible-label: root.now-title; }
            Text { x: 98px; y: 59px; width: parent.width / 3 - 110px; height: 16px; text: root.now-detail; color: Theme.muted; font-size: 11px; overflow: elide; }
            Action { x: parent.width / 2 - 82px; y: 20px; text: "|◀"; round: true; width: 40px; height: 36px; accessible-label: "Previous"; enabled: root.remote-controls; clicked => { root.previous(); } }
            Action { x: parent.width / 2 - 20px; y: 18px; text: root.playing ? "Ⅱ" : "▶"; round: true; light: true; width: 40px; height: 40px; accessible-label: root.playing ? "Pause" : "Resume"; enabled: root.can-control; clicked => { root.toggle-play(); } }
            Action { x: parent.width / 2 + 42px; y: 20px; text: "▶|"; round: true; width: 40px; height: 36px; accessible-label: "Next"; enabled: root.remote-controls; clicked => { root.next(); } }
            seek := Slider { x: parent.width / 3 + 12px; y: 64px; width: parent.width / 3 - 24px; height: 26px; minimum: 0; maximum: max(1,root.duration); value: root.elapsed; enabled: root.can-seek; accessible-label: "Seek on selected output"; changed(value) => { root.seek(value); } }
            // Paint-only skin: the standard Slider still owns all input, focus,
            // value and accessibility. These non-interactive rectangles only
            // replace its stock blue paint; no hidden/duplicate input control.
            Rectangle {
                x: seek.x; y: seek.y; width: seek.width; height: seek.height;
                background: #111716; accessible-role: none;
                property <length> thumb-x: (self.width - 20px) * clamp(seek.value / seek.maximum, 0, 1);
                Rectangle { x: 10px; y: 11px; width: parent.width - 20px; height: 4px; border-radius: 2px; background: Theme.line; accessible-role: none; }
                Rectangle { x: 10px; y: 11px; width: parent.thumb-x; height: 4px; border-radius: 2px; background: root.can-seek ? Theme.green : Theme.muted.with-alpha(0.35); accessible-role: none; }
                Rectangle { x: parent.thumb-x; y: 3px; width: 20px; height: 20px; border-radius: 10px; background: Theme.raised; border-width: seek.has-focus && root.can-seek ? 2px : 1px; border-color: seek.has-focus && root.can-seek ? Theme.focus : Theme.line; accessible-role: none;
                    Rectangle { x: 4px; y: 4px; width: 12px; height: 12px; border-radius: 6px; background: root.can-seek ? Theme.green : Theme.muted.with-alpha(0.35); accessible-role: none; }
                }
            }
            Text { x: parent.width / 3; y: 98px; width: parent.width / 3; height: 16px; text: root.time-label; color: Theme.muted; font-size: 11px; horizontal-alignment: center; accessible-label: root.time-label; }
            Text { x: parent.width * 2 / 3 + 14px; y: 18px; width: parent.width / 3 - 38px; height: 18px; text: root.output-name; color: Theme.green; font-size: 11px; overflow: elide; horizontal-alignment: right; accessible-label: root.output-name; }
            Text { x: parent.width * 2 / 3 + 14px; y: 42px; width: parent.width / 3 - 38px; height: 58px; text: root.player-status; color: Theme.muted; font-size: 11px; wrap: word-wrap; horizontal-alignment: right; accessible-label: root.player-status; }
            if root.player-retry: Action { x: parent.width - 164px; y: 98px; height: 28px; width: 140px; text: "Retry connection"; enabled: root.player-retry-allowed; clicked => { root.retry-player(); } }
        }
        Rectangle {
            height: 28px;
            Text { x: 24px; height: parent.height; text: "Selected-output playback · No credentials saved"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
        }
    }
}
