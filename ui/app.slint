                                            }
                                        }
                                        init => { self.focus-if-requested(); }
                                        changed focus-requested => { self.focus-if-requested(); }
                                        Timer {
                                            // A changed snapshot may no longer expose the launching link or menu.
                                            interval: 16ms; running: row.focus-requested && row.restore-control != "";
                                            triggered => { row.take-row-focus(); catalog-list.focus-request = -1; }
                                        }
                                        keyboard-focus-changed(owns, body) => {
                                            if owns {
                                                catalog-list.focus-owner = i;
                                                catalog-list.focus-owner-on-body = body;
                                                catalog-list.focus-owner-page = catalog-scroll.scroll-key;
                                                catalog-list.focus-owner-context = catalog-list.focus-context;
                                            } else if catalog-list.focus-owner == i { catalog-list.focus-owner = -1; }
                                        }
                                        focused => {
                                            catalog-list.focused-row = i;
                                            if self.focus-requested { catalog-list.focus-request = -1; }
                                            else { catalog-scroll.reveal(self.row-y, self.height); }
                                        }
                                        action(op) => { shell.browse(op, i); }
                                        page-action(op, id) => { shell.entity(op, id, i); }
                                    }
                                }
                                other-rows := VerticalLayout {
                                    x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: 2px;
                                    for i in (root.playlist-detail || catalog-scroll.catalog-results-route) ? 0 : root.browse-rows.length: shelf-row := VerticalLayout {
                                        property <BrowseRow> entry: root.browse-rows[i];
                                        spacing: 4px;
                                        if shelf-row.entry.section != "": Eyebrow { text: shelf-row.entry.section; height: 27px; }
                                        BrowseLine {
                                            entry: shelf-row.entry; index: i;
                                            page-kind: root.page-kind; is-playlist: false;
                                            local-mode: root.local-mode; can-play-local: root.can-play-local;
                                            paint-left: main.inset; paint-right: main.inset;
                                            artwork: i < root.browse-artwork.length ? root.browse-artwork[i] : root.no-artwork;
                                            current-track: self.entry.track-id != "" && self.entry.track-id == root.now-track-id;
                                            playing-track: self.current-track && root.playing;
                                            compact: main.width < 435px; window-height: root.height;
                                            menu-key: root.page-key + "|" + root.browse-model-key + "|" + i;
                                            property <length> row-y: catalog-list.top + other-rows.y + shelf-row.y + self.y;
                                            row-viewport-y: self.row-y + catalog-scroll.content-y;
                                            play-viewport-height: catalog-list.visible && history-pane.visible && catalog-scroll.visible
                                                ? catalog-scroll.visible-height : 0px;
                                            play-focus-evicted => { catalog-list.focus(); }
                                            focused => { catalog-scroll.reveal(self.row-y, self.height); }
                                            action(op) => {
                                                if root.page-kind == "playlists" && (op == "rename" || op == "rules" || op == "delete") {
                                                    shell.browse("edit-" + op, i);
                                                } else { shell.browse(op, i); }
                                            }
                                            page-action(op, id) => { shell.entity(op, id, -1); }
                                        }
                                    }
                                }
                            }
                            catalog-results := VerticalLayout {
                                visible: catalog-scroll.catalog-results-route && root.browse-rows.length > 0;
                                accessible-role: list;
                                accessible-label: root.catalog-title;
                                accessible-item-count: root.browse-rows.length;
                                accessible-orientation: vertical;
                                spacing: 2px;
                                // Layout slots give the one scroll surface exact geometry. Only
                                // mount rich row controls around the viewport and keyboard focus.
                                for entry[index] in (catalog-scroll.catalog-results-route ? root.browse-rows : []): slot := Rectangle {
                                    property <string> album: root.page-kind == "album" || entry.kind != "track" ? "" : entry.album-name;
                                    property <bool> show-type: root.is-search && (entry.kind == "track" || entry.kind == "artist" || entry.kind == "album");
                                    height: Copy.result-height(self.show-type, entry.credits.length > 0 || entry.subtitle != "", self.album != "");
                                    property <length> row-y: catalog.y + catalog-results.y + self.y;
                                    property <length> visible-y: self.row-y + catalog-scroll.content-y;
                                    property <bool> near-viewport: self.visible-y + self.height >= -catalog-scroll.visible-height
                                        && self.visible-y <= 2 * catalog-scroll.visible-height;
                                    property <bool> near-focus: root.catalog-focused-row >= 0 && abs(index - root.catalog-focused-row) <= 2;
                                    property <bool> restoring: catalog-scroll.restore-catalog && index == root.catalog-return-row;
                                    property <bool> is-anchor: self.visible-y <= 0px && self.visible-y + self.height + catalog-results.spacing > 0px;
                                    function publish-anchor() {
                                        if self.is-anchor {
                                            root.catalog-anchor-row = index;
                                            root.catalog-anchor-y = self.row-y / 1px;
                                        }
                                    }
                                    changed is-anchor => { self.publish-anchor(); }
                                    changed row-y => { self.publish-anchor(); }
                                    property <int> restore-anchor: catalog-scroll.return-anchor-serial;
                                    changed restore-anchor => {
                                        if index == root.catalog-return-anchor {
                                            catalog-scroll.set-scroll(clamp(root.catalog-return-offset * 1px, -self.height, 0px) - self.row-y);
                                        }
                                    }
                                    if slot.near-viewport || slot.near-focus || slot.restoring: MediaLine {
                                        width: parent.width; height: parent.height;
                                        title: entry.title; subtitle: entry.subtitle; detail: entry.detail; kind: entry.kind;
                                        search-result: root.is-search;
                                        align-credit-fallback: true;
                                        paint-left: main.inset; paint-right: main.inset;
                                        sequence: root.page-kind == "album" ? index + 1 : 0;
                                        artwork: index < root.browse-artwork.length ? root.browse-artwork[index] : root.no-artwork;
                                        credits: entry.credits; metadata-enabled: !root.local-mode;
                                        album-id: entry.album-id; album-name: slot.album;
                                        playable: entry.playable && (!root.local-mode || root.can-play-local);
                                        can-open: entry.can-open && (!root.local-mode || entry.kind == "saved-collection");
                                        selectable: entry.kind == "track";
                                        current-track: entry.track-id != "" && entry.track-id == root.now-track-id;
                                        playing-track: self.current-track && root.playing;
                                        compact: main.width < 435px;
                                        window-height: root.height;
                                        menu-key: root.page-key + "|" + root.browse-model-key + "|" + index;
                                        actions: !root.local-mode ? entry.actions : [];
                                        // The Back anchor can keep this delegate mounted long after it
                                        // leaves the viewport. Don't leave a clipped Play button active.
                                        row-viewport-y: slot.visible-y;
                                        play-viewport-height: history-pane.visible && catalog-scroll.visible && !catalog-scroll.restore-catalog
                                            ? catalog-scroll.visible-height : 0px;
                                        play-focus-evicted => { history-pane.focus(); root.catalog-focused-row = -1; }
                                        property <int> return-focus: catalog-scroll.return-focus-serial;
                                        changed return-focus => {
                                            if slot.restoring && slot.visible-y + slot.height > 0px && slot.visible-y < catalog-scroll.visible-height {
                                                root.catalog-focused-row = index;
                                                root.catalog-focused-part = root.catalog-return-part;
                                                root.catalog-focused-credit = root.catalog-return-credit;
                                                self.restore-focus(root.catalog-return-part, root.catalog-return-credit);
                                            }
                                        }
                                        focused => {
                                            if !catalog-scroll.restore-catalog {
                                                root.catalog-focused-row = index;
                                                root.catalog-focused-part = "";
                                                root.catalog-focused-credit = "";
                                                catalog-scroll.reveal(slot.row-y, slot.height);
                                            }
                                        }
                                        action(op) => {
                                            if op == "open" || op == "add" {
                                                root.catalog-focused-row = index;
                                                root.catalog-focused-part = op == "add" ? "menu" : "";
                                                root.catalog-focused-credit = "";
                                                root.catalog-row-navigation = true;
                                            }
                                            shell.browse(op, index);
                                            root.catalog-row-navigation = false;
                                        }
                                        page-action(op, id) => {
                                            root.catalog-focused-row = index;
                                            root.catalog-focused-part = op;
                                            root.catalog-focused-credit = id;
                                            root.catalog-row-navigation = true;
                                            shell.entity(op, id, index);
                                            root.catalog-row-navigation = false;
                                        }
                                    }
                                }
                            }
                            if root.catalog-loading: Caption { text: "Loading…"; }
                            if root.catalog-continuation-status != "": Notice {
                                text: root.catalog-continuation-status;
                                error: true;
                            }
                        }
                    }
                    playlist-order-pane := VerticalLayout {
                        x: main.inset; y: 0px; width: parent.width - 2 * main.inset; height: parent.height;
                        visible: root.is-playlist && shell.playlist-order-edit;
                        padding-top: 8px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: root.catalog-title; font-size: 22px * Theme.density; font-weight: 750;
                                color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            }
                            Action {
                                text: "Done";
                                enabled: playlist-order-pane.visible;
                                clicked => {
                                    playlist-order.cancel-grab();
                                    shell.playlist-order-edit = false;
                                    if edit-playlist-order.enabled { edit-playlist-order.take-focus(); }
                                    else { playlist-header.focus-order(); }
                                }
                            }
                        }
                        Divider { }
                        if root.page-error && root.page-status != "": Notice { text: root.page-status; }
                        playlist-order := ReorderList {
                            rows: root.playlist-order-rows;
                            initial-index: shell.playlist-order-start;
                            align-initial-top: true;
                            scope-key: playlist-order-pane.visible && !root.compact-queue-open ? root.playlist-order-scope : "";
                            writable: !root.form-busy;
                            commit-pending: root.playlist-order-pending;
                            line-variant: root.inspection-reorder-line;
                            reduced-motion: root.reduced-motion;
                            placed(key, after) => {
                                if self.scope-key != "" { root.playlist-order-drop(self.scope-key, key, after); }
                            }
                        }
                    }
                }
                if root.editor-open: Editor {
                    x: 0px; y: root.toolbar-height; width: parent.width; height: parent.height - self.y;
                    confirm-subject: root.confirmation-title;
                    remove-offline-save: root.form-return == "unpin-playlist";
                    mode: root.form-mode; name <=> root.form-name; description <=> root.form-description; definition <=> root.form-value;
                    error: root.form-error; help: root.form-help; busy: root.form-busy;
                    cancel => { root.cancel-form(); } save => { root.submit-form(); }
                }
            }
            queue-pane := Rectangle {
                visible: root.queue-shown;
                x: root.wide ? work.width - root.queue-width : root.rail-width;
                y: root.wide ? 0px : root.toolbar-height;
                width: root.wide ? root.queue-width : work.width - root.rail-width;
                height: work.height - self.y;
                background: Theme.rail;
                property <length> inset-left: root.compact ? 12px : 17px;
                // Fluent's overlay scrollbar is 14px wide. Keep its hit area in the margin.
                property <length> inset-right: root.compact ? 14px : 16px;
                Divider { x: 0px; y: 0px; width: 1px; height: parent.height; }
                VerticalLayout {
                    padding-left: queue-pane.inset-left; padding-right: queue-pane.inset-right;
                    padding-top: 10px; padding-bottom: 5px; spacing: 8px;
                    HorizontalLayout {
                        height: 41px; spacing: 8px; padding-left: 4px;
                        Text { text: "Queue"; color: Theme.text; font-size: 22px * Theme.density; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                        Action {
                            text: shell.queue-order-edit ? "Done" : "Edit order";
                            visible: root.queue-order-token != "" || shell.queue-order-edit;
                            enabled: root.queue-shown && !root.editor-open && self.visible && (shell.queue-order-edit || root.queue-order-writable);
                            selected: shell.queue-order-edit;
                            clicked => {
                                if shell.queue-order-edit {
                                    queue-order.cancel-grab();
                                    shell.queue-order-edit = false;
                                    self.take-focus();
                                } else if root.queue-order-writable {
                                    playlist-order.cancel-grab();
                                    shell.playlist-order-edit = false;
                                    shell.queue-order-edit = true;
                                    queue-order.focus-list();
                                }
                            }
                        }
                        queue-close := Action {
                            width: 36px; quiet: true; icon: "×"; enabled: root.queue-shown && !root.editor-open;
                            pointer-focus-visible: false;
                            accessible-label: "Close play queue"; clicked => { shell.hide-queue(self.pointer-focused); }
                        }
                    }
                    if root.queue-rows.length > 0 && !shell.queue-order-edit: FlexboxLayout {
                        flex-wrap: wrap; spacing: 6px;
                        Action { text: "Shuffle"; height: 32px; selected: root.shuffle; enabled: root.queue-controls && !root.editor-open; accessible-description: root.shuffle ? "On" : "Off"; clicked => { root.queue-action("shuffle", ""); } }
                        Action { text: root.repeat-mode == "one" ? "Repeat: one" : root.repeat-mode == "all" ? "Repeat: all" : "Repeat: off"; height: 32px; selected: root.repeat-mode != "off"; enabled: root.queue-controls && !root.editor-open; clicked => { root.queue-action("repeat", ""); } }
                        if root.queue-has-upcoming: Action { text: "Clear upcoming"; height: 32px; quiet: true; enabled: root.queue-controls && !root.editor-open; clicked => { root.queue-action("clear", ""); } }
                    }
                    Divider { }
                    queue-order := ReorderList {
                        visible: shell.queue-order-edit;
                        vertical-stretch: self.visible ? 1 : 0;
                        min-height: 0px;
                        max-height: self.visible ? 65535px : 0px;
                        rows: root.queue-order-rows;
                        initial-index: 1;
                        writable: root.queue-order-writable;
                        commit-pending: root.queue-order-awaiting-echo;
                        scope-key: self.visible && root.queue-shown ? root.queue-order-token : "";
                        line-variant: root.inspection-reorder-line;
                        reduced-motion: root.reduced-motion;
                        placed(key, after) => {
                            if self.scope-key != "" { root.queue-order-drop(self.scope-key, key, after); }
                        }
                    }
                    queue-lane := FocusScope {
                        visible: !shell.queue-order-edit;
                        focus-on-click: false;
                        focus-on-tab-navigation: false;
                        max-height: self.visible ? 65535px : 0px;
                        min-width: queue-scroll.min-width;
                        min-height: 0px; vertical-stretch: self.visible ? 1 : 0;
                        // Paint row focus to the pane edges without putting row controls
                        // under the overlay scrollbar in the right margin.
                        Rectangle {
                            x: -queue-pane.inset-left; y: 0px;
                            width: parent.width + queue-pane.inset-left + queue-pane.inset-right;
                            height: parent.height;
                            clip: true;
                            queue-list := VerticalLayout {
                                x: queue-pane.inset-left; y: queue-scroll.content-y;
                                width: queue-lane.width; height: self.preferred-height;
                                spacing: 3px; alignment: start; padding-bottom: 8px;
                                if root.queue-rows.length > 0 && root.queue-status != "": Notice { text: root.queue-status; }
                                if root.queue-rows.length == 0: Caption {
                                    text: "The queue is empty. Play a track or choose Add to queue.";
                                    wrap: word-wrap;
                                }
                                for phase in ["current", "upcoming", "played"]: phase-list := VerticalLayout {
                                    spacing: 0px;
                                    for row[i] in root.queue-rows: queue-group := VerticalLayout {
                                        property <bool> member: phase == "current" ? row.current : phase == "upcoming" ? row.upcoming && !row.current : !row.current && !row.upcoming;
                                        property <bool> first-upcoming: i == 0 || !root.queue-rows[i - 1].upcoming;
                                        property <bool> first-played: i == 0 || root.queue-rows[i - 1].current || root.queue-rows[i - 1].upcoming;
                                        if self.member && (row.current || (row.upcoming ? self.first-upcoming : self.first-played)): HorizontalLayout {
                                            height: 27px; padding-left: 4px;
                                            Eyebrow {
                                                text: phase == "current" ? "NOW PLAYING" : phase == "upcoming" ? "UP NEXT" : "PLAYED";
                                                color: phase == "current" ? Theme.primary : Theme.muted;
                                            }
                                        }
                                        if self.member: MediaLine {
                                            title: row.title; subtitle: row.subtitle; kind: "track";
                                            // Queue rows name occurrences. Only the cursor row is current,
                                            // even if the recording also occurs in Played or Up Next.
                                            current-track: row.current && row.track-id != "" && row.track-id == root.now-track-id;
                                            playing-track: self.current-track && root.playing;
                                            credits: row.credits; metadata-enabled: !root.local-mode && !root.editor-open;
                                            album-id: row.album-id; album-name: row.album-name;
                                            artwork: self.current-track ? root.cover-art : root.no-artwork;
                                            can-open: false; compact: true; queue-row: true;
                                            paint-left: queue-pane.inset-left; paint-right: queue-pane.inset-right;
                                            paint-surface: Theme.rail;
                                            playable: row.upcoming && root.queue-controls && !root.editor-open;
                                            selectable: self.playable;
                                            actions: !root.queue-shown || !self.playable ? [] : ["remove"];
                                            window-height: root.height; menu-key: row.key;
                                            property <length> row-y: phase-list.y + queue-group.y + self.y;
                                            row-viewport-y: self.row-y + queue-scroll.content-y;
                                            play-viewport-height: root.queue-shown && queue-lane.visible && !root.editor-open
                                                ? queue-scroll.visible-height : 0px;
                                            play-focus-evicted => { queue-lane.focus(); }
                                            focused => { queue-scroll.reveal(self.row-y, self.height); }
                                            action(op) => { if op != "open" { root.queue-action(op, row.key); } }
                                            page-action(op, id) => { shell.entity(op, id, -1); }
                                        }
                                    }
                                }
                            }
                        }
                        queue-scroll := ScrollView {
                            // Wheel input covers the leading Play strip too.
                            x: -queue-pane.inset-left; y: 0px;
                            width: parent.width + queue-pane.inset-left + queue-pane.inset-right; height: parent.height;
                            content-height: queue-list.height;
                            horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                            function reveal(y: length, h: length) {
                                if y < -self.content-y { self.content-y = -y; }
                                else if y + h > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - y - h); }
                            }
                        }
                    }
                }
            }
        }
        if root.dock-visible: player := PlayerBar {
            property <int> queue-focus-serial: shell.dock-queue-focus-serial;
            changed queue-focus-serial => { self.focus-queue(shell.dock-queue-pointer-focus); }
            toggle-queue(by-pointer) => { shell.toggle-queue(by-pointer); }
            Timer {
                interval: 1ms; running: shell.restore-lyrics-focus;
                triggered => { shell.restore-lyrics-focus = false; player.focus-lyrics(); }
            }
            x: 0px; y: parent.height - root.player-height; width: parent.width; height: root.player-height;
            track: root.now-title; subtitle: root.now-detail; output: root.output-name;
            devices: root.device-rows;
            device-status: root.device-picker-status;
            device-picker-context: root.device-picker-context
                + (root.dock-visible && root.signed-in ? "|shown" : "|hidden");
            device-action(op, id, name) => { root.device-action(op, id, name); }
            credits: root.now-credits; metadata-enabled: !root.local-mode;
            album-id: root.now-album-id; album-name: root.now-album-name;
            status: root.playback-status;
            artwork: root.cover-art; elapsed: root.elapsed; duration: root.duration;
            can-seek: root.can-seek && (!root.local-mode || root.local-playback);
            playing: root.playing; can-toggle: root.can-control && (!root.local-mode || root.local-playback);
            can-skip: root.local-mode ? root.local-playback && root.can-control : root.remote-controls;
            page: root.page-kind; queue-open: root.queue-shown; offline: root.local-mode;
            layered: root.compact;
            shuffle: root.shuffle; repeat-mode: root.repeat-mode; modes-enabled: root.queue-controls;
            queue-action(op, key) => { root.queue-action(op, key); }
            volume: root.local-volume; muted: root.local-muted;
            volume-change(value) => { root.local-volume-change(value); }
            mute-toggle => { root.local-mute-toggle(); }
            previous => { root.previous(); } next => { root.next(); } toggle => { root.toggle-play(); }
            seek(v) => { root.seek(v); } navigate(page) => { shell.route(page); }
            page-action(op, id) => { shell.entity(op, id, -1); }
        }
    }
}
