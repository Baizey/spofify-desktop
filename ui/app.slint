import { ScrollView } from "std-widgets.slint";
import { Action, Caption, Divider, Eyebrow, Field, Notice, Theme } from "theme.slint";
import { Copy, EmptyState, Hero, MediaLine } from "catalog.slint";
import { OverflowMenu } from "overflow-menu.slint";
import { ArtistCredit } from "credits.slint";
import { Editor, SignInView } from "forms.slint";
import { PlayerBar } from "playback.slint";
import { NowPlaying } from "now-playing.slint";
import { Settings, SettingCard } from "settings.slint";
import { PlaybackTools, WorkspaceRail } from "workspace-parts.slint";
import "../assets/JetBrainsMono-v2.304-wght.ttf";
export { ArtistCredit }

export struct BrowseRow {
    kind: string, title: string, subtitle: string, detail: string, playable: bool, can-open: bool, actions: [string], section: string,
    credits: [ArtistCredit], album-id: string, album-name: string, track-id: string,
}
export struct QueueRow {
    key: string, track-id: string, title: string, subtitle: string, current: bool, upcoming: bool,
    credits: [ArtistCredit], album-id: string, album-name: string,
}
export struct DeviceRow { id: string, name: string, selected: bool, available: bool, can-play: bool }

export component AppWindow inherits Window {
    title: "Spofify Desktop";
    icon: @image-url("../assets/spofify-logo.svg");
    in property <length> inspection-width: 0px;
    in property <length> inspection-height: 0px;
    preferred-width: 1280px;
    preferred-height: 790px;
    min-width: root.inspection-width > 0px ? root.inspection-width : 480px;
    max-width: root.inspection-width > 0px ? root.inspection-width : 65535px;
    min-height: root.inspection-height > 0px ? root.inspection-height : 440px;
    max-height: root.inspection-height > 0px ? root.inspection-height : 65535px;
    default-font-family: "JetBrains Mono";

    in-out property <string> origin;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> keep-signed-in;
    in-out property <string> query;
    in property <bool> signed-in;
    in property <bool> busy;
    in property <bool> restoring-login;
    in property <bool> can-retry-session;
    in property <string> auth-notice;
    in property <string> status;
    in property <bool> error;
    in property <string> now-title: "Nothing playing";
    in property <string> now-detail: "Find a track to begin";
    in property <string> player-status;
    in property <string> update-notice;
    in property <string> update-action;
    in property <string> update-button;
    callback download-update();
    in property <bool> playing;
    in property <bool> can-control;
    in property <bool> remote-controls;
    in property <bool> can-seek;
    in property <string> output-name;
    in property <float> elapsed;
    in property <float> duration;
    in property <string> time-label;
    callback sign-in();
    callback sign-out();
    callback retry-session();
    callback cancel-sign-in();
    callback server-edited();
    callback username-edited();
    callback search-edited();
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);

    in property <[BrowseRow]> browse-rows;
    // Invalidates in-flight row gestures before an accepted model changes indices.
    in property <string> browse-model-key;
    in property <[image]> browse-artwork;
    in property <image> page-artwork;
    in property <[ArtistCredit]> page-credits;
    in property <string> page-title;
    in property <string> page-key;
    in property <string> page-subtitle;
    in property <string> page-kind: "search";
    in property <string> page-status;
    in property <bool> page-busy;
    in property <bool> page-error;
    in property <bool> has-more;
    in property <bool> can-back;
    in property <[string]> page-actions;
    in property <[string]> page-options;
    callback navigate(string);
    callback row-action(string, int);
    callback page-action(string, string);

    in-out property <string> form-mode;
    in-out property <string> form-name;
    in-out property <string> form-description;
    in-out property <string> form-value;
    in property <string> form-error;
    in property <bool> form-busy;
    in property <string> form-help;

    in property <string> now-track-id;
    in property <string> now-album-id;
    in property <string> now-album-name;
    in property <[ArtistCredit]> now-credits;
    in property <string> next-title;
    in property <string> next-subtitle;
    in property <string> now-artist-id;
    in property <string> now-context-kind;
    in property <string> now-context-id;
    in property <string> now-context-name;
    in property <image> cover-art;
    in property <string> lyrics-track-id;
    in property <string> lyrics-text;
    in property <string> lyrics-status;
    in property <[float]> waveform;
    in property <string> media-status;
    in property <string> account-label;
    in property <bool> manual-offline;
    in property <bool> reconnecting;
    in property <bool> local-playback;
    in property <string> music-storage;
    in property <bool> crossfade-enabled;
    in property <string> crossfade-status;
    callback crossfade-changed(bool);
    in property <float> density-scale: 1.0;
    callback density-changed(float);

    in property <string> room-token;
    in property <string> media-track-token;
    in property <[QueueRow]> queue-rows;
    in property <[DeviceRow]> device-rows;
    in property <string> queue-status;
    in property <string> device-status;
    in property <bool> shuffle;
    in property <string> repeat-mode: "off";
    callback queue-action(string, string);
    in property <float> local-volume: 1;
    in property <bool> local-muted;
    callback local-volume-change(float);
    callback local-mute-toggle();
    callback device-action(string, string);

    default-font-size: 13px * Theme.density;
    background: Theme.bg;
    changed density-scale => { Theme.density = clamp(root.density-scale, 0.85, 1.25); }
    property <image> no-artwork;

    property <bool> compact: self.width < 820px;
    property <bool> wide: self.width >= 1136px;
    property <length> rail-width: self.width >= 1480px ? 224px : root.compact ? 164px : 194px;
    property <length> queue-width: clamp(self.width * 0.229, 304px, 390px);
    property <length> toolbar-height: root.compact ? 57px : 65px;
    property <string> playback-status: root.player-status != "" ? root.player-status : root.reconnecting ? "Connecting…" : "";
    property <bool> dock-visible: root.now-track-id != "" && !root.is-now && !root.editor-open;
    property <bool> toolbar-playback: !root.dock-visible && !root.editor-open;
    property <length> player-height: !root.dock-visible ? 0px
        : root.compact ? (root.playback-status == "" ? 58px : 72px) + (root.duration > 0 ? 69px : 48px)
        : root.playback-status == "" ? 82px : 96px;
    property <bool> wide-queue-open: true;
    property <bool> compact-queue-open;
    property <bool> queue-shown: root.wide ? root.wide-queue-open : root.compact-queue-open;
    property <bool> editor-open: form-mode != "" && form-mode != "closed";
    property <bool> is-search: page-kind == "search";
    property <bool> is-history: page-kind == "history" || page-kind == "recent";
    property <bool> is-playlist: page-kind == "playlist" || page-kind == "playlist-manual" || page-kind == "playlist-rules";
    property <bool> is-settings: page-kind == "appearance" || page-kind == "settings" || page-kind == "account";
    property <bool> is-now: page-kind == "now";
    property <bool> saved-view: page-kind == "offline" || page-kind == "saved-collection";
    property <bool> local-mode: manual-offline || reconnecting;
    property <bool> can-play-local: root.saved-view || (root.manual-offline && root.is-search);
    property <bool> queue-controls: local-mode ? local-playback && can-control : remote-controls;
    property <bool> queue-has-upcoming: queue-rows.length > 0 && queue-rows[queue-rows.length - 1].upcoming;
    property <string> catalog-title: page-kind == "offline" ? "Saved offline" : page-title != "" ? page-title : Copy.title(page-kind);
    property <string> form-return;
    property <int> form-focus-serial;
    changed wide => { root.compact-queue-open = false; }
    changed signed-in => {
        if !root.signed-in {
            root.compact-queue-open = false;
            root.wide-queue-open = true;
            root.form-return = "";
        }
    }

    function flip-offline() { root.page-action("offline", root.reconnecting || !root.manual-offline ? "on" : "off"); }
    function edit-form(mode: string) {
        root.form-return = mode;
        root.form-name = "";
        root.form-description = "";
        root.form-value = "";
        root.form-mode = mode;
        if mode != "remove-saved" { root.page-action("prepare-" + mode, ""); }
    }
    function cancel-form() {
        if root.form-mode != "device-rename" && root.form-mode != "remove-saved" { root.page-action("cancel-form", root.form-mode); }
        root.form-mode = "";
        root.form-name = "";
        root.form-description = "";
        root.form-value = "";
    }
    function submit-form() {
        if root.form-mode == "device-rename" { root.device-action("rename", root.form-name); }
        else if root.form-mode == "remove-saved" { root.form-mode = ""; root.page-action("remove", ""); }
        else { root.page-action(root.form-mode, root.form-mode == "rules" || root.form-mode == "new-rules" ? root.form-value : root.form-mode == "delete" ? "" : root.form-name); }
    }
    function catalog-action(action: string) {
        if action == "new-manual" || action == "new-rules" || action == "rename" || action == "rules" || action == "delete" { root.edit-form(action); }
        else if action == "remove" { root.edit-form("remove-saved"); }
        else { root.page-action(action, ""); }
    }

    if !root.signed-in: SignInView {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        origin <=> root.origin; username <=> root.username; password <=> root.password;
        keep-signed-in <=> root.keep-signed-in;
        status: root.status; error: root.error; busy: root.busy;
        restoring: root.restoring-login; auth-notice: root.auth-notice; can-retry-session: root.can-retry-session;
        server-edited => { root.server-edited(); } username-edited => { root.username-edited(); }
        sign-in => { root.sign-in(); } cancel => { root.cancel-sign-in(); }
        retry-session => { root.retry-session(); }
    }
    if root.signed-in: shell := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        focus-on-tab-navigation: false; focus-on-click: false;
        property <string> destination: root.page-kind;
        property <bool> editing: root.editor-open;
        property <string> account-scope: root.account-label;
        // Two account-local return slots, owned by the signed-in shell.
        property <string> search-return-key;
        property <length> search-return-y;
        property <string> playlist-return-key;
        property <length> playlist-return-y;
        property <bool> returning;
        property <string> restoring-key;
        property <length> restoring-y;
        property <int> dock-queue-focus-serial;
        property <bool> lyrics-entry;
        property <bool> restore-lyrics-focus;
        init => { self.focus(); }
        changed account-scope => {
            self.search-return-key = "";
            self.playlist-return-key = "";
            self.restoring-key = "";
            self.returning = false;
        }
        function remember-scroll() {
            if root.is-search && root.query != "" {
                self.search-return-key = catalog-scroll.scroll-key;
                self.search-return-y = catalog-scroll.content-y;
            } else if root.is-playlist {
                self.playlist-return-key = catalog-scroll.scroll-key;
                self.playlist-return-y = catalog-scroll.content-y;
            }
        }
        function browse(op: string, index: int) {
            if op == "open" || op == "add" { self.remember-scroll(); }
            root.row-action(op, index);
        }
        function edited-search() {
            root.compact-queue-open = false;
            self.returning = false;
            self.restoring-key = "";
            root.search-edited();
        }
        function apply-return-scroll() {
            if self.restoring-key != "" && self.restoring-key == catalog-scroll.scroll-key {
                catalog-scroll.content-y = clamp(self.restoring-y, min(0px, catalog-scroll.visible-height - catalog-scroll.content-height), 0px);
                if catalog-scroll.content-y == self.restoring-y { self.restoring-key = ""; }
            }
        }
        function destination-scrolled() {
            self.restoring-key = "";
            catalog-scroll.content-y = 0px;
            if self.returning {
                self.returning = false;
                if root.is-search && catalog-scroll.scroll-key == self.search-return-key {
                    self.restoring-key = self.search-return-key;
                    self.restoring-y = self.search-return-y;
                } else if root.is-playlist && catalog-scroll.scroll-key == self.playlist-return-key {
                    self.restoring-key = self.playlist-return-key;
                    self.restoring-y = self.playlist-return-y;
                }
                self.apply-return-scroll();
            }
        }
        changed destination => {
            if !root.editor-open && !root.compact-queue-open && !(root.is-now && self.lyrics-entry)
                && !(root.dock-visible && self.restore-lyrics-focus) {
                if root.is-search { search.take-focus(); }
                else if !history-pane.has-focus { self.focus(); }
            }
        }
        changed editing => {
            if !self.editing {
                // The browse view is still mounted. Focus the action that opened the editor if it survived.
                if root.is-playlist && root.page-options.length > 0 && !root.local-mode { playlist-menu.take-focus(); }
                else if back-row.visible { back-button.take-focus(); }
                else { rail.restore-focus(); }
                root.form-focus-serial += 1;
            }
        }
        function show-queue() {
            if root.wide { root.wide-queue-open = true; }
            else { root.compact-queue-open = true; }
            queue-close.take-focus();
        }
        function hide-queue() {
            if root.wide { root.wide-queue-open = false; }
            else { root.compact-queue-open = false; }
            if root.dock-visible { self.dock-queue-focus-serial += 1; }
            else if root.toolbar-playback { playback-tools.focus-queue(); }
        }
        function route(target: string) {
            if root.editor-open { return; }
            if target == "queue" {
                if root.queue-shown { self.hide-queue(); } else { self.show-queue(); }
            } else {
                self.remember-scroll();
                self.returning = target == "back";
                self.restoring-key = "";
                root.compact-queue-open = false;
                // Retire the outgoing page's focus even on Back between two pages of the same kind.
                if self.returning { self.focus(); }
                self.restore-lyrics-focus = self.returning && root.is-now && self.lyrics-entry && root.now-track-id != "";
                self.lyrics-entry = target == "lyrics";
                root.navigate(self.lyrics-entry ? "now" : target);
            }
        }
        function entity(kind: string, id: string) {
            if !root.local-mode && !root.editor-open && id != "" {
                self.remember-scroll();
                if root.compact-queue-open { root.compact-queue-open = false; self.focus(); }
                root.page-action(kind, id);
            }
        }
        capture-key-pressed(event) => {
            if root.editor-open { return reject; }
            if event.modifiers.control && (event.text == "f" || event.text == "l" || event.text == "F" || event.text == "L") {
                root.compact-queue-open = false;
                search.take-focus(); return accept;
            }
            if event.text == Key.Escape || (event.modifiers.alt && event.text == Key.LeftArrow) {
                if root.compact-queue-open {
                    if !event.repeat { self.hide-queue(); }
                    return accept;
                }
                if root.can-back {
                    if !event.repeat { self.route("back"); }
                    return accept;
                }
            }
            return reject;
        }
        session-notice := Notice {
            x: 8px; y: 0px; width: parent.width - 16px;
            height: root.auth-notice == "" ? 0px : self.min-height;
            visible: root.auth-notice != "";
            text: root.auth-notice;
        }
        update-banner := Rectangle {
            x: 0px; y: session-notice.height; width: parent.width;
            visible: root.update-notice != "";
            height: self.visible ? update-content.preferred-height : 0px;
            background: Theme.rail;
            update-content := HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 3px; padding-bottom: 3px;
                spacing: 8px;
                Caption {
                    text: root.update-notice; wrap: word-wrap; horizontal-stretch: 1;
                    accessible-role: text; accessible-label: self.text; accessible-live-region: polite;
                }
                if root.update-button != "": Action {
                    text: root.update-button; enabled: !root.editor-open && root.update-action != "";
                    click-scope: root.update-action;
                    clicked => {
                        if self.has-focus { shell.focus(); }
                        root.download-update();
                    }
                }
            }
            Divider { y: parent.height - 1px; }
        }
        work := Rectangle {
            x: 0px; y: update-banner.y + update-banner.height; width: parent.width; height: parent.height - self.y - root.player-height;
            rail := WorkspaceRail {
                x: 0px; y: 0px; width: root.rail-width; height: parent.height;
                kind: root.page-kind; account: root.account-label; compact: root.compact;
                offline: root.manual-offline; reconnecting: root.reconnecting; locked: root.editor-open;
                navigate(target) => { shell.route(target); }
            }
            main := Rectangle {
                x: root.rail-width; y: 0px; height: parent.height;
                width: parent.width - self.x - (root.wide && root.queue-shown ? root.queue-width : 0px);
                property <length> inset: clamp(self.width * 0.038, 14px, 38px);
                property <bool> narrow: self.width < 640px;
                toolbar := Rectangle {
                    x: 0px; y: 0px; width: parent.width; height: root.toolbar-height;
                    background: Theme.rail;
                    Divider { x: 0px; y: parent.height - 1px; }
                    HorizontalLayout {
                        padding-left: main.inset; padding-right: main.inset; spacing: root.toolbar-playback ? 8px : 0px;
                        Rectangle {
                            horizontal-stretch: 1; min-width: 0px;
                            search := Field {
                                y: (parent.height - self.height) / 2; width: parent.width; height: 39px;
                                text <=> root.query; prefix: "⌕"; clearable: true; enabled: !root.editor-open;
                                field-label: root.local-mode ? "Search downloads" : "Search tracks, albums or artists";
                                placeholder-text: root.local-mode ? "Search downloads" : main.width < 420px ? "Search music" : "Search tracks, albums or artists";
                                cleared => { shell.edited-search(); }
                                edited => { shell.edited-search(); }
                                accepted => { shell.edited-search(); }
                            }
                        }
                        Rectangle {
                            visible: root.toolbar-playback;
                            width: self.visible ? playback-tools.preferred-width : 0px;
                            playback-tools := PlaybackTools {
                                x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: 38px;
                                labeled: !main.narrow; enabled: root.toolbar-playback;
                                queue-open: root.queue-shown; devices-open: root.page-kind == "devices";
                                status: root.playback-status; context-key: root.page-kind + "|" + root.page-key;
                                navigate(target) => { shell.route(target); }
                            }
                        }
                    }
                }
                // Back belongs to the current page, not to the persistent search row.
                back-row := Rectangle {
                    x: main.inset; y: root.toolbar-height; width: parent.width - 2 * main.inset;
                    visible: root.can-back && !root.editor-open && !root.compact-queue-open;
                    height: self.visible ? 46px : 0px;
                    back-button := Action {
                        x: 0px; y: 8px; width: self.min-width;
                        text: "Back"; icon: "←"; quiet: true;
                        enabled: back-row.visible; clicked => { shell.route("back"); }
                    }
                }
                history-pane := FocusScope {
                    x: 0px; y: back-row.y + back-row.height; width: parent.width; height: parent.height - self.y;
                    visible: !root.editor-open && !root.compact-queue-open;
                    focus-on-click: false; focus-on-tab-navigation: false;
                    if root.is-now: now := NowPlaying {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        Timer {
                            interval: 1ms; running: shell.lyrics-entry;
                            triggered => { self.running = false; now.focus-lyrics(); }
                        }
                        track-id: root.now-track-id; track: root.now-title; subtitle: root.now-detail;
                        credits: root.now-credits; metadata-interactive: !root.local-mode;
                        album-name: root.now-album-name; album-id: root.now-album-id;
                        next-title: root.next-title; next-subtitle: root.next-subtitle;
                        context-kind: root.now-context-kind; context-id: root.local-mode ? "" : root.now-context-id;
                        context-name: root.local-mode ? "" : root.now-context-name;
                        artwork: root.cover-art;
                        property <bool> lyrics-current: root.lyrics-track-id == root.now-track-id;
                        lyrics-text: self.lyrics-current ? root.lyrics-text : "";
                        lyrics-status: self.lyrics-current ? root.lyrics-status : "";
                        offline: root.local-mode;
                        waveform: root.waveform; elapsed: root.elapsed; duration: root.duration;
                        playing: root.playing; can-seek: root.can-seek && (!root.local-mode || root.local-playback); can-toggle: root.can-control && (!root.local-mode || root.local-playback);
                        can-skip: root.local-mode ? root.local-playback && root.can-control : root.remote-controls;
                        shuffle: root.shuffle; repeat-mode: root.repeat-mode; can-change-modes: root.queue-controls;
                        previous => { root.previous(); } toggle => { root.toggle-play(); } next => { root.next(); } seek(v) => { root.seek(v); }
                        page-action(op, id) => { shell.entity(op, id); } queue-action(op, key) => { root.queue-action(op, key); }
                    }
                    catalog-scroll := ScrollView {
                        visible: !root.is-now;
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                        property <string> scroll-key: root.is-search ? "search|" + root.query
                            : root.page-key != "" ? root.page-key : root.page-kind + "|" + root.catalog-title;
                        changed scroll-key => { shell.destination-scrolled(); }
                        changed content-height => { shell.apply-return-scroll(); }
                        function reveal(y: length, h: length) {
                            if y < -self.content-y { self.content-y = -y; }
                            else if y + h > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - y - h); }
                        }
                        catalog := VerticalLayout {
                            x: 0px; y: 0px; width: catalog-scroll.visible-width;
                            padding-left: main.inset; padding-right: main.inset;
                            padding-top: main.narrow ? 14px : 23px; padding-bottom: 24px;
                            spacing: 8px; alignment: start;
                            detail-hero := Rectangle {
                                property <bool> with-art: root.is-playlist || root.page-kind == "album" || root.page-kind == "artist";
                                border-radius: Theme.container-radius;
                                background: self.with-art ? Theme.panel : transparent;
                                border-width: self.with-art ? 1px : 0px;
                                border-color: Theme.line;
                                min-height: hero-layout.preferred-height; vertical-stretch: 0;
                                hero-layout := VerticalLayout {
                                    padding: detail-hero.with-art ? (main.narrow ? 12px : 20px) : 0px;
                                    Hero {
                                        title: root.is-settings ? "Settings" : root.catalog-title;
                                        subtitle: root.is-settings ? "" : root.page-kind == "offline" ? "Music saved on this device" + (root.page-subtitle == "" ? "" : " · " + root.page-subtitle) : root.page-subtitle;
                                        section: root.saved-view ? "ON THIS DEVICE" : root.page-kind == "album" ? "ALBUM" : root.page-kind == "artist" ? "ARTIST" : root.is-playlist ? "PLAYLIST" : "";
                                        glyph: Copy.mark(root.page-kind);
                                        artwork: root.page-artwork; compact: main.narrow; show-art: detail-hero.with-art;
                                        credits: root.page-credits; metadata-enabled: !root.local-mode;
                                        focused(y, h) => { catalog-scroll.reveal(catalog.y + detail-hero.y + self.y + y, h); }
                                        page-action(op, id) => { shell.entity(op, id); }
                                    }
                                }
                            }
                            page-tools := HorizontalLayout {
                                property <bool> has-primary: root.page-actions.length > 0 && (!root.local-mode || root.saved-view);
                                property <bool> has-menu: !root.local-mode && root.is-playlist && root.page-options.length > 0;
                                visible: self.has-primary || self.has-menu;
                                spacing: self.has-menu ? 8px : 0px;
                                FlexboxLayout {
                                    flex-wrap: wrap; spacing: 6px; horizontal-stretch: 1;
                                    for action in !root.local-mode || root.saved-view ? root.page-actions : []: Action {
                                        text: Copy.action-label(action); icon: Copy.action-mark(action); primary: action == "play" || action == "new-manual";
                                        enabled: action != "play" || !root.saved-view || root.can-play-local;
                                        property <int> resume: root.form-focus-serial;
                                        changed resume => { if root.form-return == action || (action == "remove" && root.form-return == "remove-saved") { self.take-focus(); } }
                                        clicked => { root.catalog-action(action); }
                                    }
                                }
                                playlist-menu := OverflowMenu {
                                    actions: root.is-playlist && !root.local-mode ? root.page-options : [];
                                    width: self.actions.length > 0 ? 37px : 0px;
                                    height: self.actions.length > 0 ? 38px : 0px;
                                    visible: self.actions.length > 0;
                                    label: "Manage playlist"; open-label: "Hide playlist options";
                                    context-key: root.page-key + "|" + root.catalog-title;
                                    window-height: root.height;
                                    action(op) => { root.catalog-action(op); }
                                }
                            }
                            if root.page-status != "": Notice { text: root.page-status; error: root.page-error; }
                            if root.page-busy && root.page-status == "": Caption { text: "Loading…"; }
                            if root.is-settings: Settings {
                                account: root.account-label; offline: root.local-mode; reconnecting: root.reconnecting;
                                crossfade-enabled: root.crossfade-enabled; crossfade-status: root.crossfade-status;
                                music-storage: root.music-storage;
                                open-downloads => { shell.route("offline"); }
                                crossfade-changed(enabled) => { root.crossfade-changed(enabled); }
                                scale: root.density-scale;
                                sign-out => { root.sign-out(); } toggle-offline => { root.flip-offline(); }
                                density-changed(scale) => { root.density-changed(scale); }
                                focused(y, h) => { catalog-scroll.reveal(catalog.y + self.y + y, h); }
                            }
                            if root.page-kind == "devices" && root.device-rows.length > 0 && root.device-status != "": Notice { text: root.device-status; }
                            if root.page-kind == "devices" && root.device-rows.length == 0: EmptyState {
                                title: "No playback devices yet";
                                subtitle: root.device-status != "" ? root.device-status : "Available outputs will appear here.";
                                glyph: "◫";
                            }
                            if root.page-kind == "devices": VerticalLayout {
                                spacing: 6px;
                                for device in root.device-rows: SettingCard {
                                    title: device.name;
                                    detail: device.selected ? "Selected output" : !device.available ? "Not available" : device.can-play ? "Available for playback" : "Cannot play audio";
                                    FlexboxLayout {
                                        flex-wrap: wrap; spacing: 6px;
                                        Action {
                                            text: device.selected ? "Deselect" : "Select output"; enabled: !root.local-mode && (device.selected || (device.available && device.can-play));
                                            primary: !device.selected; clicked => { root.device-action(device.selected ? "deselect" : "select", device.id); }
                                        }
                                        if device.selected: Action {
                                            text: "Rename device"; enabled: !root.local-mode;
                                            property <int> resume: root.form-focus-serial;
                                            changed resume => { if root.form-return == "device-rename" { self.take-focus(); } }
                                            clicked => { root.form-return = "device-rename"; root.form-name = device.name; root.form-mode = "device-rename"; root.device-action("prepare-rename", device.id); }
                                        }
                                    }
                                }
                            }
                            if root.is-history && root.browse-rows.length == 0 && !root.page-busy && !root.page-error: VerticalLayout {
                                spacing: 12px;
                                Caption { text: root.local-mode ? "Listening history isn’t available offline." : "Tracks you play will appear here."; font-size: 14px * Theme.density; wrap: word-wrap; }
                                HorizontalLayout {
                                    Action {
                                        text: root.local-mode ? "Open saved offline" : "Search music"; icon: root.local-mode ? "↓" : "⌕";
                                        clicked => { if root.local-mode { shell.route("offline"); } else { search.take-focus(); } }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            if !root.is-history && !root.is-settings && root.page-kind != "devices" && root.browse-rows.length == 0 && !root.page-busy && !root.page-error:
                                EmptyState {
                                    glyph: Copy.mark(root.page-kind);
                                    title: root.is-search && root.query == "" ? (root.local-mode ? "Search your downloads" : "What would you like to hear?")
                                        : root.is-search ? "No matching results" : root.page-kind == "picker" ? "No manual playlists"
                                        : root.page-kind == "offline" ? "Nothing saved yet" : root.page-kind == "playlists" ? "No playlists yet"
                                        : root.page-kind == "artist" ? "No releases found" : root.page-kind == "album" ? "No tracks found" : "No items here yet";
                                    subtitle: root.is-search && root.query == "" ? (root.local-mode ? "Find music saved on this device." : "Search by track, album or artist.")
                                        : root.is-search ? "Try a different title, artist or album." : root.page-kind == "picker" ? "Create a manual playlist before adding tracks."
                                        : root.page-kind == "offline" ? "Choose Save offline on music you want to keep on this device."
                                        : root.page-kind == "playlists" && !root.local-mode ? "Create a playlist to keep tracks together."
                                        : root.page-kind == "artist" ? "There are no releases listed here. Tracks and appearances may still be indexed in search." : "";
                                }
                            if root.page-kind == "artist" && root.browse-rows.length == 0 && !root.page-busy && !root.page-error && !root.local-mode: HorizontalLayout {
                                alignment: center;
                                Action {
                                    text: "Search for this artist"; icon: "⌕";
                                    clicked => { root.query = root.catalog-title; shell.edited-search(); search.take-focus(); }
                                }
                            }
                            if root.browse-rows.length > 0 && root.page-kind != "playlists": Eyebrow {
                                height: 30px; color: Theme.muted;
                                text: root.is-search ? "RESULTS" : root.is-history ? "RECENTLY PLAYED" : root.page-kind == "artist" ? "DISCOGRAPHY"
                                    : root.page-kind == "album" || root.is-playlist ? "TRACKS" : root.page-kind == "picker" ? "MANUAL PLAYLISTS"
                                    : root.saved-view ? "DOWNLOADED MUSIC" : "";
                            }
                            catalog-list := VerticalLayout {
                                spacing: 2px;
                                for row[i] in root.browse-rows: shelf-row := VerticalLayout {
                                    spacing: 4px;
                                    if row.section != "": Eyebrow { text: row.section; height: 27px; }
                                    MediaLine {
                                        title: row.title; subtitle: row.subtitle; detail: row.detail; kind: row.kind;
                                        search-result: root.is-search;
                                        sequence: root.page-kind == "album" || root.is-playlist ? i + 1 : 0;
                                        artwork: i < root.browse-artwork.length ? root.browse-artwork[i] : root.no-artwork;
                                        credits: row.credits; metadata-enabled: !root.local-mode && root.page-kind != "picker";
                                        album-id: row.album-id;
                                        album-name: root.page-kind == "album" || root.page-kind == "picker" || row.kind != "track" ? "" : row.album-name;
                                        playable: row.playable && (!root.local-mode || root.can-play-local) && root.page-kind != "picker";
                                        can-open: row.can-open && (!root.local-mode || row.kind == "saved-collection");
                                        open-label: root.page-kind == "picker" ? "Add to " + row.title : "Open " + row.title;
                                        selectable: row.kind == "track";
                                        current-track: row.track-id != "" && row.track-id == root.now-track-id;
                                        playing-track: self.current-track && root.playing;
                                        compact: main.width < 435px;
                                        window-height: root.height;
                                        menu-key: root.page-key + "|" + root.browse-model-key + "|" + i;
                                        actions: root.page-kind == "picker" ? [] : !root.local-mode ? row.actions
                                            : root.page-kind == "offline" && row.actions.length > 0 ? ["remove"] : [];
                                        focused => { catalog-scroll.reveal(catalog.y + catalog-list.y + shelf-row.y + self.y, self.height); }
                                        action(op) => { shell.browse(op, i); }
                                        page-action(op, id) => { shell.entity(op, id); }
                                    }
                                }
                            }
                            if root.has-more: HorizontalLayout {
                                Action { text: "Load more"; enabled: !root.page-busy; clicked => { root.page-action("more", ""); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                if root.editor-open: Editor {
                    x: 0px; y: root.toolbar-height; width: parent.width; height: parent.height - self.y;
                    mode: root.form-mode; name <=> root.form-name; description <=> root.form-description; definition <=> root.form-value;
                    error: root.form-error; help: root.form-help; busy: root.form-busy;
                    cancel => { root.cancel-form(); } save => { root.submit-form(); }
                }
            }
            queue-pane := Rectangle {
                visible: root.queue-shown;
                x: root.wide ? work.width - root.queue-width : root.rail-width;
                y: root.wide ? 0px : root.toolbar-height;
                width: root.wide ? root.queue-width : work.width - root.rail-width;
                height: work.height - self.y;
                background: Theme.rail;
                Divider { x: 0px; y: 0px; width: 1px; height: parent.height; }
                VerticalLayout {
                    padding-left: root.compact ? 12px : 17px; padding-right: root.compact ? 12px : 16px;
                    padding-top: 10px; padding-bottom: 5px; spacing: 8px;
                    HorizontalLayout {
                        height: 41px; spacing: 8px;
                        Text { text: "Queue"; color: Theme.text; font-size: 22px * Theme.density; font-weight: 750; vertical-alignment: center; horizontal-stretch: 1; }
                        queue-close := Action {
                            width: 36px; quiet: true; icon: "×"; enabled: root.queue-shown && !root.editor-open;
                            accessible-label: "Close play queue"; clicked => { shell.hide-queue(); }
                        }
                    }
                    if root.queue-rows.length > 0: FlexboxLayout {
                        flex-wrap: wrap; spacing: 6px;
                        Action { text: "Shuffle"; height: 32px; selected: root.shuffle; enabled: root.queue-controls && !root.editor-open; accessible-description: root.shuffle ? "On" : "Off"; clicked => { root.queue-action("shuffle", ""); } }
                        Action { text: root.repeat-mode == "one" ? "Repeat: one" : root.repeat-mode == "all" ? "Repeat: all" : "Repeat: off"; height: 32px; selected: root.repeat-mode != "off"; enabled: root.queue-controls && !root.editor-open; clicked => { root.queue-action("repeat", ""); } }
                        if root.queue-has-upcoming: Action { text: "Clear upcoming"; height: 32px; quiet: true; enabled: root.queue-controls && !root.editor-open; clicked => { root.queue-action("clear", ""); } }
                    }
                    Divider { }
                    queue-scroll := ScrollView {
                        min-height: 0px; vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                        function reveal(y: length, h: length) {
                            if y < -self.content-y { self.content-y = -y; }
                            else if y + h > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - y - h); }
                        }
                        queue-list := VerticalLayout {
                            x: 0px; y: 0px; width: queue-scroll.visible-width;
                            spacing: 3px; alignment: start; padding-bottom: 8px;
                            if root.queue-rows.length > 0 && root.queue-status != "": Notice { text: root.queue-status; }
                            if root.queue-rows.length == 0: Caption {
                                text: "The queue is empty. Play a track or choose Add to queue.";
                                wrap: word-wrap;
                            }
                            for phase in ["current", "upcoming", "played"]: phase-list := VerticalLayout {
                                spacing: 0px;
                                for row[i] in root.queue-rows: queue-group := VerticalLayout {
                                    property <bool> member: phase == "current" ? row.current : phase == "upcoming" ? row.upcoming && !row.current : !row.current && !row.upcoming;
                                    property <bool> first-upcoming: i == 0 || !root.queue-rows[i - 1].upcoming;
                                    property <bool> first-played: i == 0 || root.queue-rows[i - 1].current || root.queue-rows[i - 1].upcoming;
                                    if self.member && (row.current || (row.upcoming ? self.first-upcoming : self.first-played)): Eyebrow {
                                        text: phase == "current" ? "NOW PLAYING" : phase == "upcoming" ? "UP NEXT" : "PLAYED";
                                        height: 27px; color: phase == "current" ? Theme.primary : Theme.muted;
                                    }
                                    if self.member: MediaLine {
                                        title: row.title; subtitle: row.subtitle; kind: "track";
                                        // Queue rows name occurrences. Only the cursor row is current,
                                        // even if the recording also occurs in Played or Up Next.
                                        current-track: row.current && row.track-id != "" && row.track-id == root.now-track-id;
                                        playing-track: self.current-track && root.playing;
                                        credits: row.credits; metadata-enabled: !root.local-mode && !root.editor-open;
                                        album-id: row.album-id; album-name: row.album-name;
                                        artwork: row.current ? root.cover-art : root.no-artwork;
                                        property <bool> can-up: i > 0 && root.queue-rows[i - 1].upcoming;
                                        property <bool> can-down: i + 1 < root.queue-rows.length && root.queue-rows[i + 1].upcoming;
                                        can-open: false; compact: !row.current;
                                        playable: row.upcoming && root.queue-controls && !root.editor-open;
                                        selectable: self.playable;
                                        actions: !root.queue-shown || !self.playable ? [] : self.can-up && self.can-down ? ["up", "down", "remove"]
                                            : self.can-up ? ["up", "remove"] : self.can-down ? ["down", "remove"] : ["remove"];
                                        window-height: root.height; menu-key: row.key;
                                        focused => { queue-scroll.reveal(queue-list.y + phase-list.y + queue-group.y + self.y, self.height); }
                                        action(op) => { if op != "open" { root.queue-action(op, row.key); } }
                                        page-action(op, id) => { shell.entity(op, id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if root.dock-visible: player := PlayerBar {
            property <int> queue-focus-serial: shell.dock-queue-focus-serial;
            changed queue-focus-serial => { self.focus-queue(); }
            Timer {
                interval: 1ms; running: shell.restore-lyrics-focus;
                triggered => { shell.restore-lyrics-focus = false; player.focus-lyrics(); }
            }
            x: 0px; y: parent.height - root.player-height; width: parent.width; height: root.player-height;
            track: root.now-title; subtitle: root.now-detail; output: root.output-name;
            credits: root.now-credits; metadata-enabled: !root.local-mode;
            album-id: root.now-album-id; album-name: root.now-album-name;
            status: root.playback-status;
            artwork: root.cover-art; elapsed: root.elapsed; duration: root.duration;
            can-seek: root.can-seek && (!root.local-mode || root.local-playback);
            playing: root.playing; can-toggle: root.can-control && (!root.local-mode || root.local-playback);
            can-skip: root.local-mode ? root.local-playback && root.can-control : root.remote-controls;
            page: root.page-kind; queue-open: root.queue-shown; offline: root.local-mode;
            layered: root.compact;
            shuffle: root.shuffle; repeat-mode: root.repeat-mode; modes-enabled: root.queue-controls;
            queue-action(op, key) => { root.queue-action(op, key); }
            volume: root.local-volume; muted: root.local-muted;
            volume-change(value) => { root.local-volume-change(value); }
            mute-toggle => { root.local-mute-toggle(); }
            previous => { root.previous(); } next => { root.next(); } toggle => { root.toggle-play(); }
            seek(v) => { root.seek(v); } navigate(page) => { shell.route(page); }
            page-action(op, id) => { shell.entity(op, id); }
        }
    }
}
