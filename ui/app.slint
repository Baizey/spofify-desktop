import { ScrollView } from "std-widgets.slint";
import { Action, Caption, Cover, Divider, Eyebrow, Field, Notice, Theme } from "theme.slint";
import { Copy, EmptyState, Hero, LineButton, MediaLine } from "catalog.slint";
import { Editor, SignInView } from "forms.slint";
import { LibraryCard } from "library-grid.slint";
import { PlayerBar } from "playback.slint";
import { NowPlaying } from "now-playing.slint";
import { PaletteRow, Settings, SettingCard } from "settings.slint";
import "../assets/JetBrainsMono-v2.304-wght.ttf";
export { PaletteRow }

export struct BrowseRow { kind: string, title: string, subtitle: string, detail: string, playable: bool, actions: [string], section: string }
export struct QueueRow { key: string, title: string, subtitle: string, current: bool, upcoming: bool }
export struct DeviceRow { id: string, name: string, selected: bool, available: bool, can-play: bool }

export component AppWindow inherits Window {
    title: "Spofify Desktop";
    in property <length> inspection-width: 0px;
    in property <length> inspection-height: 0px;
    preferred-width: 1180px;
    preferred-height: 790px;
    min-width: root.inspection-width > 0px ? root.inspection-width : 480px;
    max-width: root.inspection-width > 0px ? root.inspection-width : 65535px;
    min-height: root.inspection-height > 0px ? root.inspection-height : 440px;
    max-height: root.inspection-height > 0px ? root.inspection-height : 65535px;
    default-font-family: "sans-serif";

    in-out property <string> origin;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> query;
    in property <bool> signed-in;
    in property <bool> busy;
    in property <string> status;
    in property <bool> error;
    in property <string> now-title: "Nothing playing";
    in property <string> now-detail: "Find a track to begin";
    in property <string> player-status;
    in property <bool> playing;
    in property <bool> can-control;
    in property <bool> remote-controls;
    in property <bool> can-seek;
    in property <string> output-name;
    in property <float> elapsed;
    in property <float> duration;
    in property <string> time-label;
    callback sign-in();
    callback sign-out();
    callback server-edited();
    callback search-edited();
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);

    in property <[BrowseRow]> browse-rows;
    in property <[image]> browse-artwork;
    in property <image> page-artwork;
    in property <string> page-title;
    in property <string> page-subtitle;
    in property <string> page-kind: "search";
    in property <string> page-status;
    in property <bool> page-busy;
    in property <bool> page-error;
    in property <bool> has-more;
    in property <bool> can-back;
    in property <[string]> page-actions;
    in property <[string]> page-options;
    callback navigate(string);
    callback row-action(string, int);
    callback page-action(string, string);

    in-out property <string> form-mode;
    in-out property <string> form-name;
    in-out property <string> form-description;
    in-out property <string> form-value;
    in property <string> form-error;
    in property <bool> form-busy;
    in property <string> form-help;

    in property <string> now-track-id;
    in property <string> now-album-id;
    in property <string> now-album-name;
    in property <string> next-title;
    in property <string> next-subtitle;
    in property <string> now-artist-id;
    in property <string> now-context-kind;
    in property <string> now-context-id;
    in property <string> now-context-name;
    in property <image> cover-art;
    in property <string> lyrics-text;
    in property <[float]> waveform;
    in property <string> media-status;
    in property <string> account-label;
    in property <bool> manual-offline;
    in property <bool> reconnecting;
    in property <bool> offline-playback;
    in property <int> appearance-mode;
    in property <float> appearance-scale: 1.0;
    in property <int> appearance-accent;
    in property <[PaletteRow]> palettes;
    in property <string> palette-id;
    in property <string> palette-status;
    in property <bool> palette-enabled;
    callback palette-selected(string);
    callback appearance-changed(int, float, int);
    callback reset-appearance();

    in property <string> room-token;
    in property <[QueueRow]> queue-rows;
    in property <[DeviceRow]> device-rows;
    in property <string> queue-status;
    in property <string> device-status;
    in property <bool> shuffle;
    in property <string> repeat-mode: "off";
    callback queue-action(string, string);
    callback device-action(string, string);

    default-font-size: 13px * Theme.density;
    background: Theme.bg;
    changed appearance-mode => { Theme.light = root.appearance-mode == 1; }
    changed appearance-scale => { Theme.density = clamp(root.appearance-scale, 0.85, 1.25); }
    property <image> no-artwork;
    changed palette-id => {
        if root.palette-id == "" {
            Theme.primary = Theme.light ? #147357 : #66e3b4;
            Theme.on-accent = Theme.light ? #ffffff : #08271d;
            Theme.secondary = Theme.light ? #275da5 : #91bfff;
            Theme.tertiary = Theme.light ? #875611 : #dfbd78;
        }
    }
    for preset in root.palettes: Rectangle {
        visible: false;
        property <bool> current: preset.id == root.palette-id;
        function apply() {
            if self.current {
                Theme.primary = preset.primary;
                Theme.on-accent = preset.on-primary;
                Theme.secondary = preset.secondary;
                Theme.tertiary = preset.tertiary;
            }
        }
        init => { self.apply(); }
        changed current => { self.apply(); }
        property <color> active-primary: preset.primary;
        changed active-primary => { self.apply(); }
    }
    property <bool> compact: self.width < 806px;
    property <bool> dense: self.width < 950px;
    property <bool> editor-open: form-mode != "" && form-mode != "closed";
    property <bool> is-search: page-kind == "search";
    property <bool> is-history: page-kind == "history" || page-kind == "recent";
    property <bool> is-playlist: page-kind == "playlist" || page-kind == "playlist-manual" || page-kind == "playlist-rules";
    property <bool> has-now-context: now-context-name != "" && now-context-id != "" &&
        (now-context-kind == "album" || now-context-kind == "artist" || now-context-kind == "playlist" || now-context-kind == "derived");
    property <bool> is-settings: page-kind == "appearance" || page-kind == "settings" || page-kind == "account";
    property <bool> is-playback-page: page-kind == "now" || page-kind == "queue" || page-kind == "devices";
    property <string> displayed-kind: page-kind;
    property <bool> is-grid: displayed-kind == "albums" || displayed-kind == "artists";
    property <bool> saved-view: displayed-kind == "offline" || displayed-kind == "saved-collection";
    property <bool> local-mode: manual-offline || reconnecting;
    property <bool> can-play-saved: saved-view && local-mode;
    property <bool> queue-controls: local-mode ? offline-playback && can-control : !offline-playback && remote-controls;
    property <bool> queue-has-upcoming: queue-rows.length > 0 && queue-rows[queue-rows.length - 1].upcoming;
    property <string> catalog-title: page-title != "" ? page-title : Copy.title(displayed-kind);
    property <int> expanded-row: -1;
    property <bool> more-page-actions;
    property <string> expanded-queue-key;
    property <[string]> sections: ["history", "playlists", "albums", "artists", "offline"];
    property <length> gutter: max(clamp(root.width * 0.04, 16px, 36px), (root.width - 1220px) / 2);
    changed page-kind => { root.more-page-actions = false; root.expanded-row = -1; root.expanded-queue-key = ""; }
    changed page-title => { root.more-page-actions = false; root.expanded-row = -1; }
    changed browse-rows => { root.expanded-row = -1; }

    function back() { if root.can-back { root.navigate("back"); } }
    function flip-offline() { root.page-action("offline", root.reconnecting || !root.manual-offline ? "on" : "off"); }
    function edit-form(mode: string) {
        root.form-name = "";
        root.form-description = "";
        root.form-value = "";
        root.form-mode = mode;
        root.page-action("prepare-" + mode, "");
    }
    function cancel-form() {
        if root.form-mode != "device-rename" { root.page-action("cancel-form", root.form-mode); }
        root.form-mode = "";
        root.form-name = "";
        root.form-description = "";
        root.form-value = "";
    }
    function submit-form() {
        if root.form-mode == "device-rename" { root.device-action("rename", root.form-name); }
        else if root.form-mode == "remove-saved" { root.form-mode = ""; root.page-action("remove", ""); }
        else { root.page-action(root.form-mode, root.form-mode == "rules" || root.form-mode == "new-rules" ? root.form-value : root.form-mode == "delete" ? "" : root.form-name); }
    }
    function catalog-action(action: string) {
        if action == "new-manual" || action == "new-rules" || action == "rename" || action == "rules" || action == "delete" { root.edit-form(action); }
        else if action == "remove" { root.form-mode = "remove-saved"; }
        else { root.page-action(action, ""); }
    }
    pure function section-label(kind: string) -> string {
        return kind == "history" ? "History" : kind == "offline" ? "Downloads" : Copy.title(kind);
    }
    pure function is-current(section: string) -> bool {
        return root.displayed-kind == section || (section == "albums" && root.displayed-kind == "album") || (section == "artists" && root.displayed-kind == "artist") || (section == "offline" && root.displayed-kind == "saved-collection") || (section == "history" && root.displayed-kind == "recent")
            || (section == "playlists" && (root.displayed-kind == "playlist-manual" || root.displayed-kind == "playlist-rules" || root.displayed-kind == "picker"));
    }

    if !root.signed-in: SignInView {
        origin <=> root.origin; username <=> root.username; password <=> root.password;
        status: root.status; error: root.error; busy: root.busy;
        edited => { root.server-edited(); } sign-in => { root.sign-in(); } cancel => { root.sign-out(); }
    }
    if root.signed-in && root.editor-open: Editor {
        mode: root.form-mode; name <=> root.form-name; description <=> root.form-description; definition <=> root.form-value;
        error: root.form-error; help: root.form-help; busy: root.form-busy; offline: root.local-mode; reconnecting: root.reconnecting;
        cancel => { root.cancel-form(); } save => { root.submit-form(); }
        toggle-offline => { root.flip-offline(); }
    }
    if root.signed-in && !root.editor-open: shell := FocusScope {
        // A clicked result may disappear with its model. Keep shortcut capture alive
        // across that transition without moving the caret while a query is edited.
        property <string> destination: root.displayed-kind;
        init => { self.focus(); }
        changed destination => { if root.is-search { search.take-focus(); } else { self.focus(); } }
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.modifiers.control && (event.text == "f" || event.text == "l" || event.text == "F" || event.text == "L") {
                search.take-focus(); return accept;
            }
            if root.can-back && (event.text == Key.Escape || (event.modifiers.alt && event.text == Key.LeftArrow)) {
                if !event.repeat { root.back(); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            Rectangle {
                height: root.compact ? 58px : 68px; background: Theme.rail;
                HorizontalLayout {
                    padding-left: root.gutter; padding-right: root.gutter; spacing: root.compact ? 8px : 16px;
                    Rectangle { width: root.compact ? 30px : 146px;
                        Image { x: 0px; y: (parent.height - self.height) / 2; width: 27px; height: 27px; source: @image-url("../assets/spofify-logo.svg"); }
                        if !root.compact: Text { x: 37px; text: "Spofify"; vertical-alignment: center; color: Theme.text; font-size: 24px; font-weight: 750; letter-spacing: -1px; }
                    }
                    Rectangle { horizontal-stretch: 1; max-width: 512px; min-width: 100px;
                        search := Field { y: (parent.height - self.height) / 2; width: parent.width; height: 38px; text <=> root.query; prefix: "⌕"; clearable: true; cleared => { root.search-edited(); } pill: true; field-label: "Search music"; placeholder-text: root.compact ? "Search music" : "Search tracks, albums or artists"; edited => { root.search-edited(); } accepted => { root.search-edited(); } }
                    }
                    Rectangle { horizontal-stretch: 1; max-width: root.compact ? 0px : 10000px; }
                    Rectangle { width: root.compact ? 38px : 146px;
                        account-button := Action { y: (parent.height - self.height)/2; width: parent.width; text: root.compact ? "" : root.account-label; icon: "⚙"; quiet: true; accessible-label: "Settings"; selected: root.is-settings; clicked => { root.navigate("settings"); } }
                    }
                }
            }
            Rectangle {
                height: 44px; background: Theme.rail;
                HorizontalLayout { padding-left: root.gutter; padding-right: root.gutter; spacing: root.compact ? 2px : 12px;
                    for section in root.sections: Rectangle {
                        width: nav.min-width; horizontal-stretch: 0;
                        nav := Action { y: (parent.height - self.height)/2; text: root.section-label(section); quiet: true; accessible-description: root.is-current(section) ? "Current section" : ""; clicked => { root.navigate(section); } }
                        if root.is-current(section): Rectangle { x: 9px; y: parent.height - 2px; width: parent.width - 18px; height: 2px; background: Theme.accent; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.local-mode: Rectangle { width: 12px; Rectangle { y: (parent.height - 7px)/2; width: 7px; height: 7px; border-radius: 4px; background: Theme.amber; accessible-role: text; accessible-label: "Offline"; } }
                }
                Divider { y: parent.height - 1px; }
            }
            if root.displayed-kind == "now": VerticalLayout {
                padding-left: root.gutter; padding-right: root.gutter; padding-top: 8px; spacing: 4px;
                HorizontalLayout { Action { icon: "←"; text: "Back"; quiet: true; accessible-label: "Back"; clicked => { root.back(); } } Rectangle { horizontal-stretch: 1; } Action { icon: "◫"; quiet: true; accessible-label: "Playback devices"; clicked => {root.navigate("devices");} } }
                NowPlaying {
                    track-id: root.now-track-id; track: root.now-title; subtitle: root.now-detail; album-name: root.now-album-name; next-title: root.next-title; next-subtitle: root.next-subtitle; album-id: root.now-album-id; artist-id: root.now-artist-id;
                    context-kind: root.now-context-kind; context-id: root.has-now-context ? root.now-context-id : ""; context-name: root.has-now-context ? root.now-context-name : "";
                    artwork: root.cover-art; lyrics-text: root.lyrics-text; waveform: root.waveform; elapsed: root.elapsed; duration: root.duration;
                    playing: root.playing; can-seek: root.can-seek && (!root.local-mode || root.offline-playback); can-toggle: root.can-control && (!root.local-mode || root.offline-playback);
                    can-skip: root.local-mode ? root.offline-playback && root.can-control : root.remote-controls; shuffle: root.shuffle; repeat-mode: root.repeat-mode; can-change-modes: root.queue-controls;
                    previous => {root.previous();} toggle => {root.toggle-play();} next => {root.next();} seek(v) => {root.seek(v);}
                    navigate(page) => {root.navigate(page);} page-action(op,id) => {root.page-action(op,id);} queue-action(op,key) => {root.queue-action(op,key);}
                }
            }
            if root.displayed-kind != "now": catalog-scroll := ScrollView {
                        min-height: 0px; vertical-stretch: 1;
                        content-width: self.visible-width;
                        property <string> scroll-key: root.displayed-kind + "|" + root.catalog-title;
                        changed scroll-key => { self.content-y = 0px; }
                        function reveal(y: length, h: length) {
                            if y < -self.content-y { self.content-y = -y; }
                            else if y + h > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - y - h); }
                        }
                        VerticalLayout {
                            padding-left: root.gutter; padding-right: root.gutter; padding-top: root.compact ? 16px : 26px; padding-bottom: 22px; spacing: 5px; alignment: start;
                            if root.can-back: Action { icon: "←"; text: "Back"; accessible-label: "Back"; quiet: true; leading: true; width: 80px; height: 30px; clicked => { root.back(); } }
                            Hero {
                                title: root.is-settings ? "Settings" : root.catalog-title;
                                subtitle: root.page-subtitle;
                                section: root.saved-view ? "ON THIS COMPUTER" : "";
                                glyph: Copy.mark(root.displayed-kind); tint: Copy.tint(root.displayed-kind);
                                artwork: root.page-artwork;
                                compact: root.compact; show-art: root.is-playlist || root.displayed-kind == "album" || root.displayed-kind == "artist" || root.displayed-kind == "track";
                            }
                            if root.saved-view: HorizontalLayout { Action { text: root.reconnecting ? "Stay offline" : root.local-mode ? "Go online" : "Work offline"; clicked => { root.flip-offline(); } } Rectangle { horizontal-stretch: 1; } }
                            if root.page-actions.length > 0 || root.page-options.length > 0: FlexboxLayout {
                                flex-wrap: wrap; spacing: 6px;
                                for action in root.page-actions: Action {
                                    text: Copy.action-label(action); icon: Copy.action-mark(action); primary: action == "play" || action == "new-manual";
                                    enabled: action != "play" || !root.saved-view || root.can-play-saved;
                                    clicked => { root.catalog-action(action); }
                                }
                                if root.is-playlist && root.page-options.length > 0: Action { icon: "···"; quiet: true; accessible-label: "Playlist options"; selected: root.more-page-actions; clicked => { root.more-page-actions = !root.more-page-actions; } }
                            }
                            if root.more-page-actions && root.is-playlist: HorizontalLayout { spacing: 6px;
                                for action in root.page-options: Action { text: Copy.action-label(action); quiet: true; danger: action == "delete"; clicked => { root.more-page-actions = false; root.catalog-action(action); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.page-status != "": Notice { text: root.page-status; error: root.page-error; }
                            if root.page-busy && root.page-status == "": Caption { text: "Loading…"; }
                            if root.is-settings: Settings {
                                max-width: 720px;
                                account: root.account-label; offline: root.local-mode; reconnecting: root.reconnecting;
                                mode: root.appearance-mode; scale: root.appearance-scale;
                                palettes: root.palettes; palette-id: root.palette-id; palette-status: root.palette-status; palette-enabled: root.palette-enabled;
                                sign-out => { root.sign-out(); } toggle-offline => { root.flip-offline(); }
                                appearance(mode, scale) => { root.appearance-changed(mode, scale, root.appearance-accent); }
                                select-palette(id) => { root.palette-selected(id); } reset => { root.reset-appearance(); }
                            }
                            if root.displayed-kind == "queue": FlexboxLayout {
                                flex-wrap: wrap; spacing: 7px;
                                Action { text: "Shuffle"; selected: root.shuffle; enabled: root.queue-controls; accessible-description: root.shuffle ? "On" : "Off"; clicked => { root.queue-action("shuffle", ""); } }
                                Action { text: root.repeat-mode == "one" ? "Repeat: one" : root.repeat-mode == "all" ? "Repeat: all" : "Repeat: off"; selected: root.repeat-mode != "off"; enabled: root.queue-controls; clicked => { root.queue-action("repeat", ""); } }
                                if root.queue-has-upcoming: Action { text: "Clear upcoming"; enabled: root.queue-controls; clicked => { root.queue-action("clear", ""); } }
                            }
                            if root.displayed-kind == "queue" && root.queue-rows.length > 0 && root.queue-status != "": Notice { text: root.queue-status; }
                            if root.displayed-kind == "queue" && root.queue-rows.length == 0: EmptyState { title: "The queue is empty"; subtitle: "Play or queue tracks from your library."; glyph: "≡"; }
                            if root.displayed-kind == "queue": queue-list := VerticalLayout {
                                spacing: 3px;
                                for row[i] in root.queue-rows: MediaLine {
                                    title: row.title; subtitle: row.current ? "Playing now · " + row.subtitle : row.subtitle;
                                    detail: row.upcoming ? "UP NEXT" : row.current ? "NOW PLAYING" : "PLAYED"; kind: "track";
                                    property <bool> can-up: i > 0 && root.queue-rows[i - 1].upcoming;
                                    property <bool> can-down: i + 1 < root.queue-rows.length && root.queue-rows[i + 1].upcoming;
                                    selected: row.current; can-open: false; playable: row.upcoming && root.queue-controls;
                                    actions: !self.playable ? [] : self.can-up && self.can-down ? ["up", "down", "remove"]
                                        : self.can-up ? ["up", "remove"] : self.can-down ? ["down", "remove"] : ["remove"];
                                    compact: root.compact; expanded: root.expanded-queue-key == row.key;
                                    toggle-options => { root.expanded-queue-key = self.expanded ? "" : row.key; }
                                    focused => { catalog-scroll.reveal(queue-list.y + self.y, self.height); }
                                    action(op) => { if op != "open" { root.queue-action(op, row.key); } }
                                }
                            }
                            if root.displayed-kind == "devices" && root.device-status != "" && (root.local-mode || root.device-rows.length > 0): Notice { text: root.device-status; }
                            if root.displayed-kind == "devices" && root.device-rows.length == 0: EmptyState { title: "No playback devices yet"; subtitle: "Available outputs will appear here."; glyph: "◫"; }
                            if root.displayed-kind == "devices": VerticalLayout {
                                spacing: 6px;
                                for device in root.device-rows: SettingCard {
                                    title: device.name;
                                    detail: device.selected ? "Selected output" : !device.available ? "Not available" : device.can-play ? "Available for playback" : "Cannot play audio";
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Action {
                                            text: device.selected ? "Deselect" : "Select output"; enabled: !root.local-mode && (device.selected || (device.available && device.can-play));
                                            primary: !device.selected; clicked => { root.device-action(device.selected ? "deselect" : "select", device.id); }
                                        }
                                        if device.selected: Action {
                                            text: "Rename"; enabled: !root.local-mode;
                                            clicked => { root.form-name = device.name; root.form-mode = "device-rename"; root.device-action("prepare-rename", device.id); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                            if root.is-history && root.browse-rows.length == 0 && !root.page-busy && !root.page-error: VerticalLayout {
                                spacing: 12px;
                                Caption { text: "Nothing played yet."; font-size: 15px; }
                                HorizontalLayout { Action { text: root.local-mode ? "Browse downloads" : "Browse albums"; clicked => { root.navigate(root.local-mode ? "offline" : "albums"); } } Rectangle { horizontal-stretch: 1; } }
                            }
                            if !root.is-history && !root.is-settings && !root.is-playback-page && root.browse-rows.length == 0 && !root.page-busy && !root.page-error:
                                EmptyState {
                                    glyph: Copy.mark(root.displayed-kind);
                                    title: root.is-history ? "No listening history yet" : root.is-search && root.query == "" ? "What would you like to hear?" : root.is-search ? "No matching results" : root.displayed-kind == "picker" ? "No manual playlists" : root.displayed-kind == "offline" ? "Nothing saved yet" : "No items here yet";
                                    subtitle: root.is-history ? (root.reconnecting ? "Connecting…" : root.local-mode ? "Go online to see listening history for this account." : "Play a song to start your history.") : root.is-search && root.query == "" ? "Use the search field above to explore your library." : root.is-search ? "Try a different title, artist or album." : root.displayed-kind == "picker" ? "Create a manual playlist before adding tracks." : root.displayed-kind == "offline" ? "Use Save offline on a track while you’re online." : "";
                                }
                            if root.browse-rows.length > 0 && (root.is-search || root.is-playlist || root.displayed-kind == "picker"): Eyebrow {
                                height: 35px; text: root.is-search ? "Search results" : root.is-playlist ? "Tracks" : "Manual playlists"; color: Theme.muted; letter-spacing: 0px; font-size: 13px * Theme.density;
                            }
                            if root.is-grid: grid := Rectangle {
                                property <length> gap: 12px;
                                property <int> columns: max(2, floor((self.width + self.gap) / (156px * Theme.density + self.gap)));
                                property <length> tile: (self.width - (self.columns - 1) * self.gap) / self.columns;
                                property <length> cell-height: self.tile + 48px * Theme.density;
                                height: ceil(root.browse-rows.length / self.columns) * (self.cell-height + self.gap);
                                for row[i] in root.browse-rows: LibraryCard {
                                    x: mod(i, grid.columns) * (grid.tile + grid.gap); y: floor(i / grid.columns) * (grid.cell-height + grid.gap);
                                    width: grid.tile; title: row.title; secondary: row.subtitle; is-artist: root.displayed-kind == "artists";
                                    artwork: i < root.browse-artwork.length ? root.browse-artwork[i] : root.no-artwork;
                                    activated => { root.row-action("open", i); } focused => { catalog-scroll.reveal(grid.y + self.y, self.height); }
                                }
                            }
                            if !root.is-grid && !root.is-settings && !root.is-playback-page: catalog-list := VerticalLayout {
                            spacing: 2px;
                            for row[i] in root.browse-rows: shelf-row := VerticalLayout {
                                spacing: 4px;
                                if row.section != "": Eyebrow { text: row.section; height: 28px; }
                                MediaLine {
                                    title: row.title; subtitle: row.subtitle; detail: row.detail; kind: row.kind; sequence: root.displayed-kind == "album" ? i + 1 : 0;
                                    artwork: i < root.browse-artwork.length ? root.browse-artwork[i] : root.no-artwork;
                                    playable: row.playable && (root.saved-view ? root.can-play-saved : !root.local-mode) && root.displayed-kind != "picker";
                                    compact: root.compact; expanded: root.expanded-row == i;
                                    actions: root.displayed-kind == "picker" ? [] : row.actions;
                                    toggle-options => { root.expanded-row = root.expanded-row == i ? -1 : i; }
                                    focused => { catalog-scroll.reveal(catalog-list.y + shelf-row.y + self.y, self.height); }
                                    action(op) => { root.row-action(op, i); }
                                }
                            }
                            }
                            if root.has-more: HorizontalLayout {
                                Action { text: "Load more"; enabled: !root.page-busy; clicked => { root.page-action("more", ""); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
            if root.displayed-kind != "now": PlayerBar {
                has-track: root.now-track-id != "";
                track: root.now-title; subtitle: root.now-detail; output: root.output-name;
                status: root.player-status != "" ? root.player-status : root.reconnecting ? "Connecting…" : "";
                artwork: root.cover-art; elapsed: root.elapsed; duration: root.duration;
                can-seek: root.can-seek && (!root.local-mode || root.offline-playback);
                playing: root.playing;
                can-toggle: root.can-control && (!root.local-mode || root.offline-playback);
                can-skip: root.local-mode ? root.offline-playback && root.can-control : root.remote-controls;
                page: root.displayed-kind; compact: root.compact; offline: root.local-mode || root.offline-playback;
                previous => { root.previous(); } next => { root.next(); } toggle => { root.toggle-play(); }
                seek(v) => { root.seek(v); } navigate(page) => { root.navigate(page); }
            }
        }
    }
}
