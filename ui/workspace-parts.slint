import { Action, Caption, Divider, Eyebrow, Notice, Theme } from "theme.slint";

component PlaybackStatus inherits Action {
    in property <string> message;
    in property <string> context-key;
    text: "Status";
    accessible-label: "Playback status";
    accessible-description: root.message;
    accessible-expanded: details.is-open;
    selected: details.is-open;
    changed message => { if details.is-open { details.close(); } }
    changed context-key => { if details.is-open { details.close(); } }
    changed enabled => { if !self.enabled && details.is-open { details.close(); } }
    clicked => {
        if details.is-open { details.close(); }
        else { self.take-focus(); details.show(); }
    }
    details := PopupWindow {
        x: root.width - self.width; y: root.height + 6px;
        width: 264px; height: message-panel.min-height;
        close-policy: close-on-click-outside;
        forward-focus: keys;
        init => { keys.focus(); }
        message-panel := Notice { width: 100%; height: 100%; text: root.message; }
        keys := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Return || event.text == Key.Space {
                    details.close(); return accept;
                }
                if event.text == Key.Tab || event.text == Key.Backtab { details.close(); }
                return reject;
            }
        }
    }
}

// Surface playback destinations here only when there is no playback dock.
export component PlaybackTools inherits Rectangle {
    in property <bool> labeled;
    in property <bool> enabled;
    in property <bool> queue-open;
    in property <bool> devices-open;
    in property <string> status;
    in property <string> context-key;
    callback navigate(string);
    public function focus-queue() { queue-trigger.take-focus(); }
    preferred-width: tools.preferred-width;
    horizontal-stretch: 0;
    tools := HorizontalLayout {
        spacing: 6px;
        queue-trigger := Action {
            text: root.labeled ? "Queue" : ""; icon: "≡"; selected: root.queue-open;
            accessible-label: "Play queue"; accessible-expanded: root.queue-open;
            enabled: root.enabled; clicked => { root.navigate("queue"); }
        }
        Action {
            text: root.labeled ? "Devices" : ""; icon: "◫"; selected: root.devices-open;
            accessible-label: "Playback devices";
            enabled: root.enabled; clicked => { root.navigate("devices"); }
        }
        if root.status != "": PlaybackStatus {
            message: root.status; context-key: root.context-key;
            enabled: root.enabled;
        }
    }
}

export component WorkspaceRail inherits Rectangle {
    in property <string> kind;
    in property <string> account;
    in property <bool> compact;
    in property <bool> offline;
    in property <bool> reconnecting;
    in property <bool> locked;
    callback navigate(string);
    public function restore-focus() {
        if root.kind == "offline" || root.kind == "saved-collection" { saved.take-focus(); }
        else if root.kind == "settings" || root.kind == "appearance" || root.kind == "account" { settings.take-focus(); }
        else if root.kind == "playlists" || root.kind == "playlist" || root.kind == "playlist-manual" || root.kind == "playlist-rules" || root.kind == "picker" { playlists.take-focus(); }
        else { history.take-focus(); }
    }
    background: Theme.rail;
    Divider { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; }
    VerticalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        padding-left: root.compact ? 7px : 14px;
        padding-right: root.compact ? 7px : 15px;
        padding-top: 12px; padding-bottom: 12px; spacing: 5px;
        HorizontalLayout {
            height: 40px; spacing: root.compact ? 7px : 10px;
            Rectangle {
                width: root.compact ? 22px : 30px;
                Image { x: 2px; y: (parent.height - self.height) / 2; width: parent.width - 2px; height: self.width; source: @image-url("../assets/spofify-logo.svg"); accessible-role: none; }
            }
            Text {
                text: "Spofify"; font-size: root.compact ? 19px : 23px; font-weight: 750; color: Theme.text;
                vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide;
            }
        }
        Rectangle { height: 13px; }
        Eyebrow { text: "YOUR LIBRARY"; color: Theme.muted; height: 22px; }
        history := Action {
            text: "History"; icon: "◷"; leading: true; quiet: true; min-width: 0px;
            selected: root.kind == "history" || root.kind == "recent";
            accessible-description: self.selected ? "Current section" : "Listening history";
            enabled: !root.locked; clicked => { root.navigate("history"); }
        }
        playlists := Action {
            text: "Playlists"; icon: "playlists"; leading: true; quiet: true; min-width: 0px;
            selected: root.kind == "playlists" || root.kind == "playlist" || root.kind == "playlist-manual" || root.kind == "playlist-rules" || root.kind == "picker";
            accessible-description: self.selected ? "Current section" : "Your playlists";
            enabled: !root.locked; clicked => { root.navigate("playlists"); }
        }
        Rectangle { height: 13px; }
        Divider { }
        Eyebrow { text: "ON THIS DEVICE"; color: Theme.muted; height: 25px; letter-spacing: root.compact ? 0.6px : 1.2px; }
        saved := Action {
            text: "Saved offline"; icon: root.compact && Theme.density > 1.05 ? "" : "↓"; leading: true; quiet: true; min-width: 0px;
            selected: root.kind == "offline" || root.kind == "saved-collection";
            accessible-description: self.selected ? "Current section" : "Music saved on this device";
            enabled: !root.locked; clicked => { root.navigate("offline"); }
        }
        Rectangle { vertical-stretch: 1; }
        if root.offline || root.reconnecting: Caption {
            text: root.reconnecting ? "Reconnecting…" : "Offline mode"; color: Theme.tertiary; height: 20px;
        }
        if root.account != "": Caption { text: root.account; height: 22px; }
        settings := Action {
            text: "Settings"; icon: "⚙"; leading: true; quiet: true; min-width: 0px;
            selected: root.kind == "settings" || root.kind == "appearance" || root.kind == "account";
            accessible-description: self.selected ? "Current section" : "Connection, density and account";
            enabled: !root.locked; clicked => { root.navigate("settings"); }
        }
    }
}
