import { Action, Theme } from "theme.slint";

export global ActionCopy {
    public pure function label(action: string) -> string {
        return action == "play" ? "Play" : action == "queue" ? "Add to queue" : action == "add" ? "Add to playlist"
            : action == "save" || action == "pin-playlist" ? "Save offline" : action == "unpin-playlist" ? "Remove offline save"
            : action == "remove" ? "Remove"
            : action == "open-album" ? "Open album" : action == "open-artist" ? "Open artist"
            : action == "album" ? "Album" : action == "artist" ? "Artist" : action == "rename" ? "Rename"
            : action == "rules" ? "Edit rules" : action == "delete" ? "Delete" : action == "new-manual" ? "New playlist"
            : action == "new-rules" ? "New rules playlist" : action;
    }
    public pure function mark(action: string) -> string {
        return action == "play" ? "▶" : action == "queue" ? "≡" : action == "add" ? "+" : action == "save" || self.offline-toggle(action) ? "↓"
            : action == "remove" || action == "delete" ? "−"
            : action == "album" || action == "open-album" ? "◎"
            : action == "artist" || action == "open-artist" ? "◉" : "";
    }
    public pure function offline-toggle(action: string) -> bool {
        return action == "pin-playlist" || action == "unpin-playlist";
    }
    public pure function separates(previous: string, action: string) -> bool {
        return action == "delete" || self.offline-toggle(previous) || self.offline-toggle(action);
    }
}

export component OverflowMenu inherits Rectangle {
    in property <[string]> actions;
    in property <string> text;
    in property <string> label: "More actions";
    in property <string> open-label: label;
    in property <string> item-context;
    in property <string> context-key;
    in property <length> window-height;
    // On Search the popup owns wheel input while open. A nonzero width opts
    // into a transparent window-sized input surface so wheel input outside
    // the panel can dismiss it and scroll the originating results.
    in property <length> scroll-window-width;
    in property <length> scroll-position;
    in property <bool> restore-focus;
    init => { if self.restore-focus { self.take-focus(); } }
    changed restore-focus => { if self.restore-focus { self.take-focus(); } }
    callback action(string);
    callback scrolled(length);
    callback focused();
    callback trigger-focus-changed(bool);
    public function take-focus() { if root.visible && root.actions.length > 0 { trigger.take-focus(); } }

    width: text == "" ? 37px : trigger.min-width;
    height: 38px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: trigger;
    property <length> menu-width: 244px + max(0, Theme.density - 1) * 80px;
    property <length> item-height: max(37px, 34px * Theme.density);
    property <length> anchor-y: self.absolute-position.y;
    property <bool> wheel-scroll: scroll-window-width > 0px && window-height > 0px;

    changed actions => { if menu.is-open { menu.close(); } }
    changed context-key => { if menu.is-open { menu.close(); } }
    changed scroll-position => { if menu.is-open { menu.close(); } }

    trigger := Action {
        width: parent.width; height: parent.height;
        visible: root.actions.length > 0;
        enabled: self.visible;
        text: root.text; icon: menu.is-open ? "×" : "···";
        quiet: root.text == ""; selected: menu.is-open;
        accessible-label: menu.is-open ? root.open-label : root.label;
        accessible-expanded: menu.is-open;
        changed has-focus => { if self.has-focus { root.focused(); } }
        keyboard-focus-changed(owns) => { root.trigger-focus-changed(owns); }
        clicked => {
            if menu.is-open {
                menu.close();
            } else if root.actions.length > 0 {
                // For assistive activation as well as pointer/keyboard activation:
                // Slint restores the focus it saved immediately before showing the popup.
                self.take-focus();
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: root.wheel-scroll ? -root.absolute-position.x : panel-x;
        y: root.wheel-scroll ? -root.anchor-y : panel-y;
        width: root.wheel-scroll ? root.scroll-window-width : root.menu-width;
        height: root.wheel-scroll ? root.window-height : items.preferred-height;
        property <length> panel-x: root.width - root.menu-width;
        property <length> panel-y: self.open-above ? -items.preferred-height - 4px : root.height + 4px;
        property <bool> open-above: root.window-height > 0px
            && root.anchor-y + root.height + 4px + items.preferred-height > root.window-height
            && root.anchor-y > root.window-height - root.anchor-y - root.height;
        close-policy: close-on-click-outside;
        forward-focus: keys;
        property <int> highlighted: 0;
        function choose(op: string) {
            self.close();
            root.action(op);
        }
        init => { keys.focus(); }

        if root.wheel-scroll: TouchArea {
            width: 100%; height: 100%;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && (self.mouse-x < panel.x || self.mouse-x >= panel.x + panel.width
                    || self.mouse-y < panel.y || self.mouse-y >= panel.y + panel.height) { menu.close(); }
            }
            scroll-event(event) => {
                if event.delta-y == 0px { return reject; }
                menu.close();
                root.scrolled(event.delta-y);
                return accept;
            }
        }
        panel := Rectangle {
            x: root.wheel-scroll ? root.absolute-position.x + menu.panel-x : 0px;
            y: root.wheel-scroll ? root.anchor-y + menu.panel-y : 0px;
            width: root.menu-width; height: items.preferred-height;
            background: Theme.panel;
            border-color: Theme.line; border-width: 1px; border-radius: Theme.container-radius;
            accessible-role: list;
            accessible-label: root.label;
            accessible-item-count: root.actions.length;
            accessible-delegate-focus: menu.highlighted;
            items := VerticalLayout {
                padding: 6px;
                for op[i] in root.actions: Rectangle {
                    property <bool> separated: i > 0 && ActionCopy.separates(root.actions[i - 1], op);
                    height: root.item-height + (separated ? 7px : 0px);
                    if separated: Rectangle {
                        x: 5px; y: 3px; width: parent.width - 10px; height: 1px;
                        background: Theme.line;
                    }
                    Action {
                        y: parent.height - self.height; width: parent.width;
                        height: root.item-height; min-width: 0px;
                        text: ActionCopy.label(op); icon: ActionCopy.mark(op);
                        leading: true; quiet: true;
                        keyboard-focusable: false;
                        selected: menu.highlighted == i;
                        border-width: self.selected && keys.has-focus ? 2px : 0px;
                        border-color: Theme.tertiary;
                        accessible-label: self.text + (root.item-context == "" ? "" : " · " + root.item-context);
                        accessible-checkable: ActionCopy.offline-toggle(op);
                        accessible-checked: op == "unpin-playlist";
                        changed has-hover => { if self.has-hover { menu.highlighted = i; } }
                        clicked => { menu.choose(op); }
                    }
                    if op == "unpin-playlist": Text {
                        x: parent.width - 27px; y: parent.height - root.item-height;
                        width: 20px; height: root.item-height;
                        text: "✓"; color: Theme.primary; vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
            keys := FocusScope {
                focus-on-click: false;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        menu.close();
                        return accept;
                    }
                    if event.text == Key.Tab || event.text == Key.Backtab {
                        // Let normal Tab traversal continue from the restored trigger.
                        menu.close();
                        return reject;
                    }
                    if root.actions.length == 0 { return reject; }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        menu.highlighted = mod(menu.highlighted + root.actions.length + (event.text == Key.DownArrow ? 1 : -1), root.actions.length);
                        return accept;
                    }
                    if event.text == Key.Home || event.text == Key.End {
                        menu.highlighted = event.text == Key.Home ? 0 : root.actions.length - 1;
                        return accept;
                    }
                    if event.text == Key.Return || event.text == Key.Space {
                        if !event.repeat { menu.choose(root.actions[menu.highlighted]); }
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}
