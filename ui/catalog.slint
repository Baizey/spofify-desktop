import { Action, AlbumLine, Caption, Cover, Divider, Eyebrow, Theme, TrackTitle } from "theme.slint";
import { ArtistCredit, CreditLine, WrappingCredits } from "credits.slint";
import { ActionCopy, OverflowMenu } from "overflow-menu.slint";
import { Glyph } from "icon.slint";

export global Copy {
    public pure function title(kind: string) -> string {
        return kind == "history" ? "History"
            : kind == "playlists" ? "Playlists" : kind == "offline" ? "Saved offline"
            : kind == "appearance" || kind == "settings" || kind == "account" ? "Settings"
            : kind == "albums" ? "Albums" : kind == "artists" ? "Artists" : kind == "picker" ? "Add to playlist"
            : kind == "now" ? "Now playing" : kind == "queue" ? "Play queue"
            : kind == "album" ? "Album" : kind == "artist" ? "Artist"
            : kind == "saved-collection" ? "Saved collection"
            : kind == "playlist" || kind == "playlist-manual" || kind == "playlist-rules" ? "Playlist" : "Search";
    }
    public pure function mark(kind: string) -> string {
        return kind == "search" ? "⌕" : kind == "history" || kind == "recent" ? "◷"
            : kind == "offline" ? "↓" : kind == "albums" || kind == "album" ? "◎"
            : kind == "artist" || kind == "artists" ? "◉" : kind == "appearance" ? "◐" : kind == "settings" ? "⚙"
            : kind == "playlist" || kind == "playlists" || kind == "playlist-manual" || kind == "playlist-rules" || kind == "picker" ? "playlists"
            : kind == "queue" ? "≡" : kind == "saved-collection" ? "↓" : "♫";
    }
    // Shared by the live row and its virtual layout slot. Fixed-pitch
    // playlists reserve room for credits even when one song has none.
    public pure function row-height(credits: bool, album: bool) -> length {
        return max(max(48px, 56px * Theme.density), 12px + max(20px, 15px * Theme.density + 7px)
            + (credits ? max(20px, 13px * Theme.density + 6px) : 0px)
            + (album ? max(20px, 12px * Theme.density + 7px) : 0px));
    }
    public pure function show-browse-album(page: string, kind: string, album: string) -> bool {
        return kind == "track" && page != "album" && page != "picker" && page != "search" && album != "";
    }
    public pure function action-label(action: string) -> string {
        return ActionCopy.label(action);
    }
    public pure function action-mark(action: string) -> string {
        return ActionCopy.mark(action);
    }
}

export component Hero inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> hide-subtitle;
    in property <string> section;
    in property <string> glyph;
    in property <image> artwork;
    in property <bool> compact;
    in property <bool> show-art: true;
    in property <bool> large;
    in property <[ArtistCredit]> credits;
    in property <bool> metadata-enabled: true;
    callback page-action(string, string);
    callback focused(length, length);
    min-width: 0px;
    min-height: max(copy.preferred-height + 12px,
        large ? (compact ? 155px : 216px) : show-art ? (compact ? 108px : 134px) : subtitle == "" ? 61px : 77px);
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: root.compact ? 16px : 22px;
        if root.show-art: Rectangle {
            width: root.large ? (root.compact ? 134px : 194px) : root.compact ? 86px : 116px;
            Cover {
                y: (parent.height - self.height) / 2;
                width: parent.width; height: self.width;
                artwork: root.artwork; mark: root.glyph;
            }
        }
        copy := VerticalLayout {
            min-width: 0px;
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            if root.section != "": Eyebrow { text: root.section; }
            Text {
                text: root.title; color: Theme.text; font-size: (root.compact ? 28px : 37px) * Theme.density;
                font-weight: 700; letter-spacing: -1px; overflow: elide; wrap: word-wrap; max-height: root.compact ? 61px : 86px;
            }
            if root.subtitle != "" && !root.hide-subtitle: Caption { text: root.subtitle; wrap: word-wrap; max-height: 40px; }
            if root.subtitle != "" && root.hide-subtitle: Caption {
                // Reserve the measured space, without exposing the unfiltered count.
                text: root.subtitle; wrap: word-wrap; max-height: 40px;
                opacity: 0; accessible-role: none;
            }
            if root.credits.length > 0: hero-credits := WrappingCredits {
                credits: root.credits; interactive: root.metadata-enabled;
                activated(id) => { root.page-action("artist", id); }
                focused(y, h) => { root.focused(copy.y + hero-credits.y + y, h); }
            }
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> glyph: "♫";
    min-height: 142px;
    vertical-stretch: 0;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 6px;
        alignment: center;
        Rectangle { height: 41px; Cover { x: (parent.width - 38px) / 2; width: 38px; height: 38px; mark: root.glyph; } }
        Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
        Caption { text: root.subtitle; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component TrackState inherits Rectangle {
    in property <bool> playing;
    width: 16px; height: self.width;
    Glyph {
        visible: root.playing; name: "playing"; ink: Theme.primary;
        width: parent.width; height: parent.height;
    }
    Rectangle {
        visible: !root.playing; background: Theme.primary;
        width: 6px; height: self.width; border-radius: self.width / 2;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

component TrackCover inherits Cover {
    in property <bool> current-track;
    in property <bool> playing-track;
    width: 39px; height: self.width;
    if root.current-track: Rectangle {
        x: parent.width - self.width; y: parent.height - self.height;
        width: 20px; height: self.width; border-radius: 5px; background: Theme.bg;
        TrackState { x: 2px; y: 2px; playing: root.playing-track; }
    }
}

export component MediaLine inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> detail;
    in property <string> kind;
    in property <image> artwork;
    in property <bool> playable;
    in property <bool> can-open;
    in property <bool> selectable;
    in property <bool> playlist-track-row;
    in property <string> restore-control;
    in property <string> open-label: "Open " + root.title;
    in property <int> sequence;
    in property <bool> compact;
    in property <bool> queue-row;
    property <bool> leading-cover: root.sequence == 0 && (root.queue-row ? root.artwork.width > 0 : !root.compact);
    property <bool> leading-state: root.queue-row && root.current-track && !root.leading-cover;
    property <bool> leading-marker: root.sequence == 0 && root.compact && !root.queue-row
        && (root.kind == "track" || root.type-mark != "");
    property <length> leading-slot: root.sequence > 0 ? (root.compact ? 26px : 33px)
        : root.leading-cover || root.leading-state ? 39px : root.leading-marker ? 16px : 0px;
    property <length> word-gap: !root.queue-row && root.compact && root.kind == "track" ? 6px : 8px;
    property <bool> row-reveals-play: row-face.has-hover || (row-keys.has-focus && !root.row-pointer-focus);
    property <bool> row-pointer-focus;
    property <bool> play-focused;
    // The scroll owner supplies the row's viewport position and receives
    // focus before a clipped Play action (or Queue face) can handle another key.
    in property <length> row-viewport-y;
    in property <length> play-viewport-height;
    callback play-focus-evicted();
    property <bool> play-scrolled-out: root.play-focused && root.play-viewport-height > 0px
        && (root.row-viewport-y + root.play-top + root.play-height <= 0px
            || root.row-viewport-y + root.play-top >= root.play-viewport-height);
    changed play-scrolled-out => { if root.play-scrolled-out { root.play-focus-evicted(); } }
    property <string> focused-occurrence;
    property <bool> queue-body-clipped: root.queue-row && row-keys.has-focus && root.play-viewport-height > 0px
        && (root.row-viewport-y + root.height <= 0px || root.row-viewport-y >= root.play-viewport-height
            || (root.play-viewport-height >= root.height && (root.row-viewport-y < 0px || root.row-viewport-y + root.height > root.play-viewport-height)));
    changed queue-body-clipped => { if root.queue-body-clipped { root.play-focus-evicted(); } }
    changed menu-key => {
        // Repeated rows can be reused for a different occurrence in a new Queue snapshot.
        if root.queue-row && row-keys.has-focus && root.focused-occurrence != root.menu-key { root.play-focus-evicted(); }
    }
    changed playable => {
        // A removed conditional control need not send a FocusOut event.
        if !root.playable && root.play-focused {
            root.play-focused = false;
            root.keyboard-focus-changed(false, false);
        }
    }
    in property <bool> title-opens-album;
    in property <bool> show-separate-album: true;
    in property <bool> availability-status;
    in property <string> type-mark;
    in property <length> menu-scroll-window-width;
    callback menu-scrolled(length);
    property <bool> menu-focused;
    property <length> menu-top: (root.height - 38px) / 2;
    property <bool> menu-scrolled-out: root.menu-scroll-window-width > 0px && root.menu-focused && root.play-viewport-height > 0px
        && (root.row-viewport-y + root.menu-top + 38px <= 0px
            || root.row-viewport-y + root.menu-top >= root.play-viewport-height);
    changed menu-scrolled-out => { if root.menu-scrolled-out { root.play-focus-evicted(); } }
    in property <string> current-album-id;
    in property <bool> align-credit-fallback;
    in property <bool> selected;
    in property <length> paint-left;
    in property <length> paint-right;
    in property <color> paint-surface: transparent;
    in property <bool> current-track;
    in property <bool> playing-track;
    in property <[string]> actions;
    in property <bool> quick-add-visible;
    // Empty hides the control; only ready can activate it.
    in property <string> quick-add-state;
    in property <string> quick-add-target;
    in property <string> quick-add-scope;
    callback quick-add();
    callback quick-add-focus-changed(bool /* owns */, bool /* pointer */);
    callback quick-add-focus-evicted(bool /* unavailable */);
    property <bool> quick-add-not-sent: root.quick-add-state == "not-sent";
    property <bool> quick-add-ready: root.quick-add-state == "ready" || root.quick-add-not-sent;
    property <bool> quick-add-at-capacity: root.quick-add-state == "at-capacity";
    property <bool> quick-add-unavailable: root.quick-add-state == "unavailable" || root.quick-add-at-capacity;
    property <bool> quick-add-pending: root.quick-add-state == "pending";
    property <bool> quick-add-member: root.quick-add-state == "member";
    property <bool> quick-add-unconfirmed: root.quick-add-state == "unconfirmed";
    property <bool> has-quick-add: root.quick-add-visible && root.quick-add-state != "";
    property <length> quick-add-width: (root.quick-add-unconfirmed || root.quick-add-not-sent) && !root.compact ? 100px : 37px;
    property <bool> quick-add-focused;
    property <string> quick-add-focus-scope;
    property <bool> quick-add-clipped: root.play-viewport-height > 0px
        && (root.row-viewport-y + root.menu-top + 38px <= 0px || root.row-viewport-y + root.menu-top >= root.play-viewport-height);
    property <bool> quick-add-evicted: root.quick-add-focused
        && (!root.has-quick-add || root.quick-add-focus-scope != root.quick-add-scope || root.quick-add-clipped);
    changed quick-add-evicted => {
        if root.quick-add-evicted {
            root.quick-add-focused = false;
            root.quick-add-focus-evicted(!root.has-quick-add);
        }
    }
    in property <[ArtistCredit]> credits;
    in property <string> album-id;
    in property <string> album-name;
    in property <bool> metadata-enabled: true;
    in property <length> window-height;
    in property <string> menu-key;
    callback page-action(string, string);
    callback action(string);
    callback focused();
    callback keyboard-focus-changed(bool /* owns */, bool /* body */);
    property <bool> has-credits: root.credits.length > 0 || root.subtitle != "";
    property <bool> show-album-line: root.show-separate-album && !root.title-opens-album && root.album-name != "";
    out property <bool> title-focused;
    in property <string> title-focus-key: root.menu-key;
    property <string> focused-title-key;
    // Album IDs are validated path segments; the final slash separates them
    // from any occurrence identifier without a delimiter collision.
    property <string> title-identity: root.title-focus-key + "/" + root.album-id;
    property <bool> title-unavailable: root.title-focused && (!song-title.interactive || root.focused-title-key != root.title-identity ||
        (root.play-viewport-height > 0px && (root.row-viewport-y + words.y + song-title.y + song-title.height <= 0px
            || root.row-viewport-y + words.y + song-title.y >= root.play-viewport-height)));
    changed title-unavailable => { if root.title-unavailable { root.title-focused = false; root.play-focus-evicted(); } }
    min-width: 0px;
    min-height: Copy.row-height(root.has-credits, root.show-album-line);
    vertical-stretch: 0;
    property <bool> play-on-activate: root.selectable && root.playable && !root.can-open;
    property <bool> body-actionable: root.can-open || root.play-on-activate;
    property <bool> body-focusable: root.can-open || root.selectable;
    property <string> pressed-row-key;
    property <bool> pressed-on-body;
    property <string> previous-body-key;
    property <bool> previous-body-release;
    property <bool> accept-body-double;
    property <length> play-height: root.leading-cover ? 39px : clamp(root.height - 4px, 0px, 46px);
    property <length> play-top: (root.height - root.play-height) / 2;
    in property <string> occurrence-description;
    property <string> track-state-label: !root.current-track ? root.occurrence-description
        : (root.occurrence-description == "" ? "" : root.occurrence-description + ", ")
            + (root.playing-track ? "Playing" : "Current track");
    public function take-row-focus() { root.row-pointer-focus = false; row-keys.focus(); }
    property <string> resume-part;
    property <string> resume-credit;
    property <int> resume-serial;
    public function restore-focus(part: string, credit: string) {
        if ((part == "artist" || part == "album") && !root.metadata-enabled)
            || (part == "album" && (credit != root.album-id || (root.title-opens-album ? !song-title.interactive : !root.show-album-line)))
            || (part == "menu" && root.actions.length == 0) {
            if root.body-focusable { root.take-row-focus(); }
        } else if part == "artist" || part == "album" || part == "menu"
            || ((part == "quick-add" || part == "quick-add-pointer") && root.has-quick-add) {
            root.resume-credit = credit;
            root.resume-part = part;
            root.resume-serial += 1;
        } else if root.body-focusable { root.take-row-focus(); }
    }
    function activate-row() {
        if root.can-open { root.action("open"); }
        else if root.play-on-activate && (!root.queue-row ||
            (!root.queue-body-clipped && root.focused-occurrence == root.menu-key)) { root.action("play"); }
    }
    function click-row() {
        root.row-pointer-focus = true;
        row-keys.focus();
        if root.can-open { root.activate-row(); }
    }
    function double-click-row() {
        if root.play-on-activate { root.activate-row(); }
    }

    // Both paint layers reach the pane edges without changing the row's
    // layout, interactive face, accessibility bounds or divider.
    Rectangle {
        x: -root.paint-left; y: 0px;
        width: root.width + root.paint-left + root.paint-right; height: root.height;
        property <bool> engaged: root.body-focusable && (row-face.pressed || row-face.has-hover || row-keys.has-focus);
        background: root.selected || (root.selectable && row-keys.has-focus) ? Theme.panel
            : self.engaged ? root.paint-surface : transparent;

        Rectangle {
            width: parent.width; height: parent.height;
            border-width: row-keys.has-focus && !root.queue-row ? 2px : 0px;
            border-color: Theme.tertiary;
            background: !parent.engaged ? transparent : row-face.pressed ? Theme.line.with-alpha(0.7)
                : Theme.raised.with-alpha(0.55);
        }
        if root.queue-row && row-keys.has-focus && !root.row-pointer-focus: Rectangle {
            x: 8px; y: 1px; width: max(0px, parent.width - 16px); height: parent.height - 2px;
            border-radius: Theme.control-radius; border-width: 2px; border-color: Theme.tertiary;
        }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        if root.body-actionable: Rectangle {
            width: parent.width; height: parent.height;
            accessible-role: button;
            accessible-label: root.can-open ? root.open-label : "Play track: " + root.title;
            accessible-description: root.track-state-label;
            accessible-action-default => { root.take-row-focus(); root.activate-row(); }
            forward-focus: row-keys;
        }

        row-keys := FocusScope {
            enabled: root.body-focusable;
            focus-on-click: false;
            focus-on-tab-navigation: root.body-actionable || root.playlist-track-row;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation { root.row-pointer-focus = false; }
                if reason != FocusReason.window-activation {
                    if root.queue-row { root.focused-occurrence = root.menu-key; }
                    root.keyboard-focus-changed(true, true);
                }
                root.focused();
            }
            focus-lost(reason) => {
                if reason != FocusReason.window-activation { root.keyboard-focus-changed(false, true); }
            }
            key-pressed(event) => {
                if root.body-actionable && (event.text == Key.Return || event.text == Key.Space) {
                    root.row-pointer-focus = false;
                    if !event.repeat { root.activate-row(); }
                    return accept;
                }
                return reject;
            }
        }
    }

    // Slint offers the press to descendants first, so links and controls
    // consume their own clicks. Only the plain track face starts this gesture.
    row-face := TouchArea {
        x: root.playable && !root.queue-row ? -root.paint-left : 0px;
        width: root.width - self.x; height: root.height;
        enabled: root.body-focusable || root.playable;
        mouse-cursor: root.can-open ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pressed-row-key = root.menu-key;
                root.pressed-on-body = self.mouse-x >= -self.x;
            }
        }
        clicked => {
            let matched = root.pressed-on-body && self.mouse-x >= -self.x && root.pressed-row-key == root.menu-key;
            root.accept-body-double = matched && root.previous-body-release && root.previous-body-key == root.pressed-row-key;
            root.previous-body-release = matched;
            root.previous-body-key = root.pressed-row-key;
            if matched { root.click-row(); }
        }
        double-clicked => { if root.accept-body-double { root.double-click-row(); } }

        HorizontalLayout {
            x: -row-face.x;
            width: max(0px, root.width - (root.actions.length > 0 || root.has-quick-add ? root.word-gap : 0px)
                - (root.has-quick-add ? root.quick-add-width : 0px)
                - (root.actions.length > 0 ? 37px : 0px) - (root.has-quick-add && root.actions.length > 0 ? 3px : 0px));
            height: parent.height;
            padding-top: 6px; padding-bottom: 6px;
            spacing: root.word-gap;
            if root.sequence > 0: Rectangle {
                width: root.leading-slot;
                Caption {
                    width: parent.width; height: parent.height; visible: !root.current-track;
                    text: root.sequence; horizontal-alignment: center; font-family: "JetBrains Mono";
                }
                TrackState {
                    visible: root.current-track; playing: root.playing-track;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                }
            }
            if root.leading-cover: Rectangle {
                width: 39px;
                TrackCover {
                    y: (parent.height - self.height) / 2;
                    artwork: root.artwork; mark: Copy.mark(root.kind); circular: root.kind == "artist";
                    current-track: root.current-track; playing-track: root.playing-track;
                }
            }
            if root.leading-state: Rectangle {
                width: 39px;
                TrackState {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    playing: root.playing-track;
                }
            }
            if root.leading-marker: Rectangle {
                width: 16px;
                TrackState { y: (parent.height - self.height) / 2; visible: root.current-track; playing: root.playing-track; }
                if root.type-mark != "": Glyph {
                    width: 14px; height: self.width;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    name: root.type-mark; ink: Theme.muted;
                }
            }
            words := VerticalLayout {
                min-width: 0px; horizontal-stretch: 1; alignment: center;
                song-title := TrackTitle {
                    text: root.title; album-id: root.album-id; album-name: root.album-name;
                    current-album-id: root.current-album-id;
                    links-enabled: root.title-opens-album && root.metadata-enabled;
                    ink: root.current-track || root.selected ? Theme.primary : Theme.text;
                    plain-accessible: !root.body-actionable;
                    track-description: root.track-state-label + (root.availability-status
                        ? (root.track-state-label == "" ? "" : ", ") + root.detail : "");
                    click-scope: root.title-identity;
                    restore-focus: root.title-opens-album && root.restore-control == "album:" + root.album-id;
                    focus-serial: root.resume-part == "album" && root.resume-credit == root.album-id ? root.resume-serial : 0;
                    activated => { if !root.title-unavailable { root.page-action("album", root.album-id); } }
                    focused => { root.focused(); }
                    keyboard-focus-changed(owns) => {
                        if owns { root.focused-title-key = root.title-identity; }
                        root.title-focused = owns;
                        root.keyboard-focus-changed(owns, false);
                    }
                }
                if root.has-credits: Rectangle {
                    min-width: 0px; horizontal-stretch: 1;
                    height: artist-line.preferred-height;
                    artist-line := CreditLine {
                        // Credit names already have a 2px text inset; the fallback has none.
                        x: root.queue-row || root.playlist-track-row || root.align-credit-fallback ? (root.credits.length > 0 ? 2px : 4px) : 0px;
                        width: max(0px, parent.width - 2 * self.x); height: parent.height;
                        credits: root.credits; fallback: root.subtitle; interactive: root.metadata-enabled;
                        restore-control: root.restore-control;
                        focus-credit: root.resume-part == "artist" ? root.resume-credit : "";
                        focus-serial: root.resume-serial;
                        background-clickable: root.body-focusable;
                        background-click-scope: root.menu-key;
                        background-cursor: root.can-open ? MouseCursor.pointer : MouseCursor.default;
                        background-clicked => { root.click-row(); }
                        background-double-clicked => { root.double-click-row(); }
                        activated(id) => { root.page-action("artist", id); }
                        focused => { root.focused(); }
                        keyboard-focus-changed(owns) => { root.keyboard-focus-changed(owns, false); }
                    }
                }
                if root.show-album-line: AlbumLine {
                    text: root.album-name; album-id: root.album-id; links-enabled: root.metadata-enabled;
                    fit-link: true;
                    restore-focus: root.restore-control == "album:" + root.album-id;
                    focus-serial: root.resume-part == "album" ? root.resume-serial : 0;
                    activated => { root.page-action("album", root.album-id); }
                    focused => { root.focused(); }
                    keyboard-focus-changed(owns) => { root.keyboard-focus-changed(owns, false); }
                }
            }
            if (root.availability-status || !root.compact || root.sequence > 0) && root.detail != "": Caption {
                property <length> column-width: root.sequence > 0 ? (root.compact ? 42px : 64px) : 126px;
                width: root.availability-status ? self.preferred-width : root.playlist-track-row && !root.playable
                    ? max(self.column-width, min(180px, self.preferred-width)) : self.column-width;
                text: root.detail; horizontal-alignment: root.availability-status || root.sequence > 0 ? right : left;
            }
        }
        // Keep Play out of layout flow and after metadata links in Tab order.
        // Hiding only the paint leaves a reachable, self-revealing keyboard action.
        if root.playable && !root.queue-row: row-play := Action {
            // Artless catalog rows can use the pane inset; the compact
            // track marker can borrow 5px on each side.
            x: root.leading-slot == 0px ? 1px : -row-face.x - (root.leading-marker ? 5px : 0px);
            y: root.play-top;
            width: root.leading-slot == 0px ? max(0px, root.paint-left - 1px)
                : root.leading-slot + (root.leading-marker ? 10px : 0px);
            height: root.play-height;
            min-width: 0px;
            icon: "▶"; quiet: true;
            glyph-size: root.leading-cover ? 23px : 20px;
            border-radius: root.leading-cover ? (root.kind == "artist" && root.artwork.width == 0
                ? self.height / 2 : min(Theme.container-radius, self.height / 5)) : Theme.control-radius;
            // Dim photos but replace the fallback glyph to avoid two icons
            // fighting for the same center.
            background: root.leading-cover && root.artwork.width > 0 ? Theme.bg.with-alpha(self.has-hover ? 0.83 : 0.73)
                : self.has-hover || self.has-focus ? Theme.raised : Theme.panel;
            property <bool> revealed: root.row-reveals-play || self.has-focus;
            opacity: self.revealed ? 1 : 0;
            pointer-enabled: self.revealed;
            accessible-label: "Play " + root.title;
            accessible-description: root.track-state-label;
            single-pointer-activation: true; click-scope: root.menu-key;
            keyboard-focus-changed(owns) => {
                root.keyboard-focus-changed(owns, false);
                // Tab can reach a mounted neighbor outside the viewport.
                // Reveal it before arming the scroll-away handoff.
                if owns { root.focused(); }
                root.play-focused = owns;
            }
            clicked => { root.action("play"); }
        }
        // Real art gets a type mark in its corner; fallback art already
        // communicates the type. Keep the mark visible next to hover Play.
        if root.type-mark != "" && root.leading-cover && root.artwork.width > 0: Rectangle {
            width: 17px; height: self.width;
            x: -row-face.x + 39px - self.width; y: (root.height + 39px) / 2 - self.height;
            border-radius: 5px; background: Theme.bg;
            Glyph { x: 2px; y: 2px; width: 13px; height: self.width; name: root.type-mark; ink: Theme.text; }
        }
        if root.has-quick-add: Action {
            x: parent.width - self.width - (root.actions.length > 0 ? 40px : 0px); y: root.menu-top;
            width: root.quick-add-width; height: 38px; min-width: 0px; quiet: true;
            icon: root.quick-add-ready || root.quick-add-unavailable ? "+" : "";
            text: root.quick-add-not-sent && !root.compact ? "Not sent" : "";
            secondary-ink: root.quick-add-not-sent ? Theme.tertiary
                : root.quick-add-unavailable ? Theme.muted.with-alpha(0.55) : Theme.primary;
            pointer-focus-visible: false;
            pointer-enabled: root.quick-add-ready;
            // Keep a previously focused target through a temporary status change,
            // but skip disabled targets when tabbing into the row. Status slots
            // still consume pointer clicks rather than activating the track behind them.
            property <bool> restore-quick: root.resume-part == "quick-add" || root.resume-part == "quick-add-pointer";
            property <int> resume: self.restore-quick ? root.resume-serial : 0;
            keyboard-focusable: root.quick-add-ready || self.has-focus || self.restore-quick;
            changed resume => {
                if self.resume != 0 {
                    if root.resume-part == "quick-add-pointer" { self.take-pointer-focus(); }
                    else { self.take-focus(); }
                    root.resume-part = "";
                }
            }
            accessible-enabled: root.quick-add-ready;
            accessible-label: root.quick-add-member ? "In playlist: " + root.quick-add-target
                : root.quick-add-unconfirmed ? "Add unconfirmed for " + root.title + " in " + root.quick-add-target
                : root.quick-add-at-capacity ? "Quick add queue is full"
                : root.quick-add-unavailable ? "Quick add unavailable for " + root.quick-add-target
                : (root.quick-add-ready ? "Add " : "Adding ") + root.title + " to " + root.quick-add-target;
            accessible-description: root.quick-add-unconfirmed ? "Use song actions to add another copy if intended."
                : root.quick-add-not-sent ? "Previous add was not sent."
                : root.quick-add-member || root.quick-add-unavailable ? root.title : "";
            accessible-live-region: self.has-focus && (root.quick-add-pending || root.quick-add-unconfirmed) ? polite : off;
            click-scope: root.quick-add-scope;
            keyboard-focus-changed(owns) => {
                if owns {
                    root.focused();
                    root.quick-add-focus-scope = root.quick-add-scope;
                }
                root.quick-add-focus-changed(owns, self.pointer-focused);
                root.quick-add-focused = owns;
                root.keyboard-focus-changed(owns, false);
            }
            clicked => { if root.quick-add-ready && !root.quick-add-clipped && !root.quick-add-evicted { root.quick-add(); } }
            if !root.quick-add-ready: TouchArea {
                width: parent.width; height: parent.height;
                mouse-cursor: MouseCursor.default;
            }
            if root.quick-add-unconfirmed: Caption {
                width: parent.width; height: parent.height;
                horizontal-alignment: center; color: Theme.tertiary;
                text: root.compact ? "?" : "Unconfirmed"; accessible-role: none;
            }
            if root.quick-add-pending || root.quick-add-member: Image {
                width: 18px; height: self.width; image-fit: contain;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                source: root.quick-add-member ? @image-url("../assets/icons/add-in-playlist.svg")
                    : @image-url("../assets/icons/add-pending.svg");
                colorize: root.quick-add-member ? Theme.primary : Theme.muted;
                accessible-role: none;
            }
        }
        if root.actions.length > 0: OverflowMenu {
            x: parent.width - 37px; y: root.menu-top;
            actions: root.actions; label: "Show actions for " + root.title; open-label: "Hide actions for " + root.title;
            item-context: root.title; context-key: root.menu-key; window-height: root.window-height;
            scroll-window-width: root.menu-scroll-window-width;
            scroll-position: root.menu-scroll-window-width > 0px ? root.row-viewport-y : 0px;
            scrolled(delta) => { root.menu-scrolled(delta); }
            restore-focus: root.restore-control == "menu";
            property <int> resume: root.resume-part == "menu" ? root.resume-serial : 0;
            changed resume => { if self.resume != 0 { self.take-focus(); } }
            trigger-focus-changed(owns) => {
                root.menu-focused = owns;
                root.keyboard-focus-changed(owns, false);
            }
            action(op) => { root.action(op); }
            focused => { root.focused(); }
        }
    }
    Divider { y: parent.height - 1px; x: 0px; width: parent.width; opacity: row-keys.has-focus ? 0 : 0.5; }
}
