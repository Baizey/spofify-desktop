import { Action, Caption, Divider, Theme } from "theme.slint";

export component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    background: transparent;
    min-height: layout.preferred-height;
    vertical-stretch: 0;
    Divider { y: parent.height - 1px; }
    layout := VerticalLayout {
        padding-top: 12px; padding-bottom: 12px;
        spacing: 9px;
        if root.title != "": Text { text: root.title; color: Theme.text; font-size: 15px * Theme.density; font-weight: 700; }
        if root.detail != "": Caption { text: root.detail; wrap: word-wrap; }
        @children
    }
}

component SettingsLabel inherits Text {
    color: Theme.text;
    font-size: 14px * Theme.density;
    font-weight: 600;
    vertical-alignment: center;
    wrap: word-wrap;
}

component SettingsValue inherits Caption {
    min-width: 0px;
    font-size: 13px * Theme.density;
    wrap: word-wrap;
    overflow: clip;
    accessible-role: text;
    accessible-label: self.text;
}

component SettingsAction inherits Action {
    in property <length> focus-origin;
    callback focused(length, length);
    height: max(34px, 34px * Theme.density);
    // Track the position in the page, not the window. Round out floating-point
    // jitter from subtracting translated coordinates during manual scrolling.
    property <length> page-y: round((root.absolute-position.y - root.focus-origin) / 1px) * 1px;
    function reveal-focus() {
        if root.has-focus { root.focused(root.page-y - 4px, root.height + 8px); }
    }
    changed has-focus => { root.reveal-focus(); }
    changed page-y => { root.reveal-focus(); }
    changed height => { root.reveal-focus(); }
}

component SettingsChoice inherits SettingsAction {
    accessible-checkable: true;
    accessible-checked: self.selected;
    // The mark makes the checked state recognizable without relying on tint.
    if root.selected: Rectangle {
        x: (parent.width - self.width) / 2; y: parent.height - 6px;
        width: 14px; height: 2px; border-radius: 1px;
        background: Theme.primary; accessible-role: none;
    }
}

// A section surface. The body stays top-aligned if its neighbor is taller.
component SettingsPanel inherits Rectangle {
    in property <string> title;
    in property <length> inset;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.container-radius;
    accessible-role: groupbox;
    accessible-label: root.title;
    min-width: 0px;
    min-height: body.preferred-height;
    vertical-stretch: 0;
    body := VerticalLayout {
        width: parent.width;
        padding: root.inset;
        spacing: 12px;
        alignment: start;
        SettingsLabel {
            text: root.title;
            font-size: 19px * Theme.density;
            font-weight: 700;
            accessible-role: none;
        }
        @children
    }
}

// Common title/value/action row. The label takes surplus width; actions wrap
// below it before the label or control would be squeezed.
component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> status;
    in property <color> status-color: Theme.muted;
    property <length> gap: 8px;
    property <bool> has-text: root.title != "" || root.detail != "" || root.status != "";
    property <length> min-label-width: (root.detail == "" ? 112px : 136px) * Theme.density;
    property <bool> stacked: root.has-text && root.width < root.min-label-width + controls.width + root.gap;
    min-height: root.stacked ? description.height + root.gap + controls.height : max(description.height, controls.height);
    vertical-stretch: 0;
    description := VerticalLayout {
        x: 0px; y: root.stacked ? 0px : (parent.height - self.height) / 2;
        width: root.stacked ? parent.width : max(0px, parent.width - controls.width - root.gap);
        height: root.has-text ? self.preferred-height : 0px;
        spacing: 4px;
        if root.title != "": SettingsLabel { text: root.title; }
        if root.status != "": HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Rectangle {
                width: 7px; height: 7px;
                border-radius: self.width / 2;
                background: root.status-color;
                accessible-role: none;
            }
            SettingsValue {
                text: root.status;
                accessible-live-region: polite;
            }
        }
        if root.detail != "": SettingsValue {
            text: root.detail;
            wrap: root.title == "" ? char-wrap : word-wrap;
        }
    }
    controls := HorizontalLayout {
        x: root.stacked ? 0px : parent.width - self.width;
        y: root.stacked ? description.height + root.gap : (parent.height - self.height) / 2;
        width: self.preferred-width; height: self.preferred-height;
        @children
    }
}

component SettingsNotice inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    border-radius: Theme.container-radius;
    border-width: 1px;
    border-color: root.error ? Theme.error.with-alpha(0.40) : Theme.line;
    background: root.error ? Theme.error.with-alpha(0.09) : Theme.rail;
    min-height: message.preferred-height + 16px;
    vertical-stretch: 0;
    message := SettingsValue {
        x: 10px; y: 8px; width: parent.width - 20px;
        text: root.text;
        color: root.error ? Theme.error : Theme.muted;
        accessible-live-region: polite;
    }
}

export component Settings inherits Rectangle {
    in property <string> account;
    in property <bool> offline;
    in property <bool> reconnecting;
    in property <string> music-storage;
    in property <bool> crossfade-enabled;
    in property <string> crossfade-status;
    in property <float> scale;
    callback sign-out();
    callback toggle-offline();
    callback crossfade-changed(bool);
    callback open-downloads();
    callback density-changed(float);
    callback focused(length, length);
    min-height: content.preferred-height;
    vertical-stretch: 0;
    property <length> gap: 12px;
    property <length> inset: root.width < 400px ? 12px : 18px;
    property <bool> split: root.width >= 640px + 100px * max(0, Theme.density - 1);
    property <length> panel-width: root.split ? (root.width - root.gap) / 2 : root.width;
    property <length> origin: root.absolute-position.y;

    content := VerticalLayout {
        x: 0px; y: 0px; width: parent.width;
        spacing: root.gap;
        alignment: start;

        Rectangle {
            // A single instance and reading order at every width keeps focus
            // and density selection intact while the page reflows.
            min-height: root.split ? max(listening.min-height, density-panel.min-height)
                : listening.min-height + root.gap + density-panel.min-height;
            vertical-stretch: 0;
            listening := SettingsPanel {
                x: 0px; y: 0px; width: root.panel-width;
                height: root.split ? parent.height : self.min-height;
                inset: root.inset;
                title: "Listening";
                SettingsRow {
                    title: "Connection";
                    status: root.reconnecting ? "Reconnecting…" : root.offline ? "Offline" : "Online";
                    status-color: root.reconnecting ? Theme.tertiary : root.offline ? Theme.subtle : Theme.primary;
                    detail: root.offline ? "Downloaded music only" : "";
                    SettingsAction {
                        text: root.reconnecting ? "Stay offline" : root.offline ? "Go online" : "Work offline";
                        primary: root.offline;
                        focus-origin: root.origin; focused(y, h) => { root.focused(y, h); }
                        clicked => { root.toggle-offline(); }
                    }
                }
                Divider { }
                SettingsRow {
                    title: "Crossfade";
                    SettingsChoice {
                        text: root.crossfade-enabled ? "On" : "Off";
                        min-width: 58px;
                        selected: root.crossfade-enabled;
                        accessible-label: "Crossfade";
                        focus-origin: root.origin; focused(y, h) => { root.focused(y, h); }
                        clicked => { root.crossfade-changed(!root.crossfade-enabled); }
                    }
                }
                if root.crossfade-status != "": SettingsNotice { text: root.crossfade-status; error: true; }
                Divider { }
                SettingsRow {
                    title: "Music storage";
                    detail: root.music-storage;
                    SettingsAction {
                        text: "Manage downloads";
                        focus-origin: root.origin; focused(y, h) => { root.focused(y, h); }
                        clicked => { root.open-downloads(); }
                    }
                }
            }
            density-panel := SettingsPanel {
                x: root.split ? listening.width + root.gap : 0px;
                y: root.split ? 0px : listening.height + root.gap;
                width: root.panel-width;
                height: root.split ? parent.height : self.min-height;
                inset: root.inset;
                title: "Density";
                FlexboxLayout {
                    flex-wrap: wrap; alignment: stretch; spacing: 5px;
                    for choice in [{ name: "Compact", scale: 0.85 }, { name: "Standard", scale: 1.0 }, { name: "Large", scale: 1.2 }]: SettingsChoice {
                        text: choice.name;
                        horizontal-stretch: 1;
                        selected: choice.scale == 0.85 ? root.scale < 0.95
                            : choice.scale == 1.0 ? root.scale >= 0.95 && root.scale < 1.10 : root.scale >= 1.10;
                        focus-origin: root.origin; focused(y, h) => { root.focused(y, h); }
                        clicked => { root.density-changed(choice.scale); }
                    }
                }
            }
        }
        SettingsPanel {
            inset: root.inset;
            title: "Account";
            SettingsRow {
                detail: root.account;
                SettingsAction {
                    text: "Sign out";
                    focus-origin: root.origin; focused(y, h) => { root.focused(y, h); }
                    clicked => { root.sign-out(); }
                }
            }
        }
    }
}
