import { Action, Caption, Divider, Notice, Theme } from "theme.slint";

export struct PaletteRow { id: string, title: string, primary: color, on-primary: color, secondary: color, tertiary: color }

export component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    background: transparent;
    min-height: layout.preferred-height;
    vertical-stretch: 0;
    Divider { y: parent.height - 1px; }
    layout := VerticalLayout {
        padding-top: 12px; padding-bottom: 12px;
        spacing: 9px;
        if root.title != "": Text { text: root.title; color: Theme.text; font-size: 15px * Theme.density; font-weight: 700; }
        if root.detail != "": Caption { text: root.detail; wrap: word-wrap; }
        @children
    }
}

component SettingsLabel inherits Text {
    color: Theme.text;
    font-size: 14px * Theme.density;
    font-weight: 700;
    vertical-alignment: center;
}

component SettingsAction inherits Action {
    callback focused(length, length);
    height: 34px;
    property <float> density: Theme.density;
    function reveal-focus() {
        if root.has-focus { root.focused(root.absolute-position.y, root.height); }
    }
    changed has-focus => { root.reveal-focus(); }
    // Changing density can wrap rows and move the active control below the fold.
    changed density => { root.reveal-focus(); }
}

component DisplayChoice inherits SettingsAction {
    accessible-checkable: true;
    accessible-checked: self.selected;
}

component SettingsSection inherits VerticalLayout {
    spacing: 6px;
    padding-bottom: 6px;
    Divider { }
    @children
}

export component Settings inherits Rectangle {
    in property <string> account;
    in property <bool> offline;
    in property <bool> reconnecting;
    in property <string> music-storage;
    in property <bool> crossfade-enabled;
    in property <string> crossfade-status;
    in property <int> mode;
    in property <float> scale;
    in property <[PaletteRow]> palettes;
    in property <string> palette-id;
    in property <string> palette-status;
    in property <bool> palette-enabled;
    callback sign-out();
    callback toggle-offline();
    callback crossfade-changed(bool);
    callback open-downloads();
    callback appearance(int, float);
    callback select-palette(string);
    callback reset();
    callback focused(length, length);
    min-height: content.preferred-height;
    vertical-stretch: 0;

    content := VerticalLayout {
        x: 0px; y: 0px; width: min(parent.width, 680px);
        spacing: 4px;
        alignment: start;

        SettingsSection {
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    min-width: 0px; horizontal-stretch: 1;
                    alignment: center;
                    SettingsLabel { text: "Connection"; }
                    Caption {
                        text: root.reconnecting ? "Reconnecting…" : root.offline ? "Offline" : "Online";
                    }
                    if root.offline: Caption { text: "Downloaded music only"; wrap: word-wrap; }
                }
                SettingsAction {
                    text: root.reconnecting ? "Stay offline" : root.offline ? "Go online" : "Work offline";
                    primary: root.offline;
                    focused(y, h) => { root.focused(y, h); }
                    clicked => { root.toggle-offline(); }
                }
            }
        }
        SettingsSection {
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    min-width: 0px; horizontal-stretch: 1;
                    alignment: center;
                    SettingsLabel { text: "Crossfade"; }
                    Caption { text: "Up to 5 seconds · This device"; wrap: word-wrap; }
                }
                SettingsAction {
                    text: root.crossfade-enabled ? "On" : "Off";
                    min-width: 58px;
                    selected: root.crossfade-enabled;
                    accessible-label: "Crossfade";
                    accessible-checkable: true;
                    accessible-checked: root.crossfade-enabled;
                    focused(y, h) => { root.focused(y, h); }
                    clicked => { root.crossfade-changed(!root.crossfade-enabled); }
                }
            }
            if root.crossfade-status != "": Notice { text: root.crossfade-status; error: true; }
        }
        SettingsSection {
            FlexboxLayout {
                flex-wrap: wrap; alignment: space-between; cross-axis-alignment: center; spacing: 8px;
                VerticalLayout {
                    min-width: storage-title.preferred-width;
                    preferred-width: parent.width - downloads.min-width - 8px >= self.min-width
                        ? parent.width - downloads.min-width - 8px : parent.width;
                    storage-title := SettingsLabel { text: "Music storage"; }
                    if root.music-storage != "": Caption { text: root.music-storage; wrap: word-wrap; }
                }
                downloads := SettingsAction {
                    text: "Manage downloads";
                    focused(y, h) => { root.focused(y, h); }
                    clicked => { root.open-downloads(); }
                }
            }
        }
        SettingsSection {
            SettingsLabel { text: "Appearance on this device"; }
            FlexboxLayout {
                flex-wrap: wrap; alignment: space-between; cross-axis-alignment: center; spacing: 4px;
                Caption { text: "Theme"; }
                HorizontalLayout {
                    spacing: 4px;
                    DisplayChoice {
                        text: "Dark"; selected: root.mode == 0;
                        focused(y, h) => { root.focused(y, h); }
                        clicked => { root.appearance(0, root.scale); }
                    }
                    DisplayChoice {
                        text: "Light"; selected: root.mode == 1;
                        focused(y, h) => { root.focused(y, h); }
                        clicked => { root.appearance(1, root.scale); }
                    }
                }
            }
            FlexboxLayout {
                flex-wrap: wrap; alignment: space-between; cross-axis-alignment: center; spacing: 4px;
                Caption { text: "Density"; }
                HorizontalLayout {
                    spacing: 4px;
                    DisplayChoice {
                        text: "Compact"; selected: root.scale < 0.95;
                        focused(y, h) => { root.focused(y, h); }
                        clicked => { root.appearance(root.mode, 0.85); }
                    }
                    DisplayChoice {
                        text: "Standard"; selected: root.scale >= 0.95 && root.scale < 1.10;
                        focused(y, h) => { root.focused(y, h); }
                        clicked => { root.appearance(root.mode, 1.0); }
                    }
                    DisplayChoice {
                        text: "Large"; selected: root.scale >= 1.10;
                        focused(y, h) => { root.focused(y, h); }
                        clicked => { root.appearance(root.mode, 1.2); }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                SettingsAction {
                    text: "Reset display defaults"; quiet: true;
                    focused(y, h) => { root.focused(y, h); }
                    clicked => { root.reset(); }
                }
            }
        }
        SettingsSection {
            SettingsLabel { text: "Account colors"; }
            if root.offline: Caption {
                text: root.reconnecting ? "Available after reconnecting" : "Go online to change colors";
                wrap: word-wrap;
            }
            if !root.offline && root.palette-status != "": Notice { text: root.palette-status; }
            for palette in root.palettes: HorizontalLayout {
                spacing: 6px;
                SettingsAction {
                    text: palette.title; leading: true; quiet: true; min-width: 0px; horizontal-stretch: 1;
                    selected: palette.id == root.palette-id; enabled: root.palette-enabled && !root.offline;
                    accessible-label: palette.title + (self.selected ? ", selected palette" : ", choose palette");
                    focused(y, h) => { root.focused(y, h); }
                    clicked => { root.select-palette(palette.id); }
                }
                for swatch in [palette.primary, palette.secondary, palette.tertiary]: Rectangle {
                    width: 17px;
                    Rectangle {
                        y: (parent.height - self.height) / 2; width: 14px; height: 14px; border-radius: 7px;
                        background: swatch; border-width: 1px; border-color: Theme.line;
                    }
                }
            }
            if !root.offline && root.palette-status == "" && root.palettes.length == 0: Caption { text: "No colors available"; }
        }
        SettingsSection {
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    min-width: 0px; horizontal-stretch: 1;
                    alignment: center;
                    SettingsLabel { text: "Account"; }
                    if root.account != "": Caption { text: root.account; wrap: word-wrap; }
                }
                SettingsAction {
                    text: "Sign out";
                    focused(y, h) => { root.focused(y, h); }
                    clicked => { root.sign-out(); }
                }
            }
        }
    }
}
