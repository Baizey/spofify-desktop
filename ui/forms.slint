import { ScrollView } from "std-widgets.slint";
import { Action, Caption, CheckChoice, Divider, Eyebrow, Field, Notice, Theme } from "theme.slint";

export component SignInView inherits Rectangle {
    in-out property <string> origin;
    in-out property <string> username;
    in-out property <string> password;
    in property <string> status;
    in property <bool> error;
    in property <bool> busy;
    in property <bool> restoring;
    in-out property <bool> keep-signed-in;
    in property <string> auth-notice;
    in property <bool> can-retry-session;
    property <bool> reveal-password;
    property <bool> ready: !root.busy && root.origin != "" && root.username != "" && root.password != "";
    callback server-edited();
    callback username-edited();
    callback sign-in();
    callback retry-session();
    callback cancel();
    background: Theme.bg;
    ScrollView {
        content-width: self.visible-width;
        content-height: max(self.visible-height, sign-in-form.preferred-height + 40px);
        Rectangle {
            width: parent.width; height: parent.height;
            background: Theme.bg;
            Rectangle {
                x: (parent.width - self.width) / 2; y: max(20px, (parent.height - self.height) / 2);
                width: min(392px, parent.width - 40px); height: sign-in-form.preferred-height;
                background: Theme.bg;
                sign-in-form := VerticalLayout {
                    padding: 8px; spacing: 9px; alignment: start;
                    HorizontalLayout {
                        height: 35px; spacing: 10px;
                        Image { width: 31px; height: 31px; source: @image-url("../assets/spofify-logo.svg"); accessible-role: none; }
                        Text { text: "Spofify"; color: Theme.text; font-size: 19px; font-weight: 700; vertical-alignment: center; }
                    }
                    Text { text: "Sign in"; color: Theme.text; font-size: 26px; font-weight: 700; wrap: word-wrap; }
                    Rectangle { height: 11px; }
                    Caption { text: "Server address"; color: Theme.text; }
                    Field { text <=> root.origin; field-label: "Server address"; placeholder-text: "https://music.example.com"; enabled: !root.busy; edited => { root.server-edited(); } }
                    Caption { text: "Username"; color: Theme.text; }
                    Field { text <=> root.username; field-label: "Username"; enabled: !root.busy; edited => { root.username-edited(); } }
                    HorizontalLayout { height: 28px; Caption { text: "Password"; color: Theme.text; } Rectangle { horizontal-stretch: 1; } Action { text: root.reveal-password ? "Hide" : "Show"; accessible-label: root.reveal-password ? "Hide password" : "Show password"; quiet: true; height: 28px; enabled: !root.busy; clicked => { root.reveal-password = !root.reveal-password; } } }
                    Field { text <=> root.password; field-label: "Password"; input-type: root.reveal-password ? InputType.text : InputType.password; enabled: !root.busy; accepted => { if root.ready { root.reveal-password = false; root.sign-in(); } } }
                    CheckChoice { text: "Keep me signed in"; checked <=> root.keep-signed-in; enabled: !root.busy; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { text: root.restoring ? "Restoring session…" : root.busy ? "Signing in…" : "Sign in"; primary: true; enabled: root.ready; clicked => { root.reveal-password = false; root.sign-in(); } }
                        if root.busy: Action { text: "Cancel"; accessible-label: "Cancel sign in"; clicked => { root.cancel(); } }
                    }
                    if root.status != "": Notice { text: root.status; error: root.error; }
                    if root.auth-notice != "": Notice { text: root.auth-notice; }
                    if root.can-retry-session && !root.busy: Action { text: "Retry saved session"; quiet: true; clicked => { root.retry-session(); } }
                }
            }
        }
    }
}

component RulesField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    public function take-focus() { input.focus(); }
    forward-focus: input;
    height: 178px;
    background: Theme.bg;
    border-radius: Theme.control-radius;
    border-width: input.has-focus ? 2px : 1px;
    border-color: Theme.field-border(input.has-focus);
    opacity: enabled ? 1 : 0.55;

    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: @tr("Cut"); enabled: input.text != ""; activated => { input.cut(); } }
            MenuItem { title: @tr("Copy"); enabled: input.text != ""; activated => { input.copy(); } }
            MenuItem { title: @tr("Paste"); activated => { input.paste(); } }
            MenuItem { title: @tr("Select All"); enabled: input.text != ""; activated => { input.select-all(); } }
        }
        scroll := ScrollView {
            x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
            content-width: self.visible-width;
            content-height: max(self.visible-height, input.preferred-height);
            input := TextInput {
                width: scroll.visible-width; height: scroll.content-height;
                enabled: root.enabled;
                single-line: false; wrap: word-wrap;
                page-height: scroll.visible-height;
                font-family: "JetBrains Mono"; font-size: 13px * Theme.density;
                color: Theme.text;
                selection-background-color: Theme.primary.with-alpha(0.3);
                selection-foreground-color: Theme.text;
                accessible-label: "Playlist rules definition";
                cursor-position-changed(position) => {
                    let cursor-y = position.y + scroll.content-y;
                    let line-height = self.font-size * 1.55;
                    if cursor-y < 0px {
                        scroll.content-y = clamp(-position.y, scroll.visible-height - self.height, 0px);
                    } else if cursor-y + line-height > scroll.visible-height {
                        scroll.content-y = clamp(scroll.visible-height - position.y - line-height, scroll.visible-height - self.height, 0px);
                    }
                }
            }
        }
    }
}

export component Editor inherits Rectangle {
    in property <string> mode;
    in property <string> help;
    in property <string> error;
    in property <bool> busy;
    in-out property <string> name;
    in-out property <string> description;
    in-out property <string> definition;
    callback save();
    callback cancel();
    property <bool> deleting: mode == "delete" || mode == "remove-saved";
    property <bool> editing-rules: mode == "rules" || mode == "new-rules";
    property <bool> editing-name: mode == "new-manual" || mode == "new-rules" || mode == "rename" || mode == "device-rename";
    property <bool> creating: mode == "new-manual" || mode == "new-rules";
    property <bool> editing-description: creating || mode == "rename";
    property <bool> ready: !busy && (!editing-name || name != "") && (!editing-rules || definition != "");
    background: Theme.bg;
    FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape && !root.busy { if !event.repeat { root.cancel(); } return accept; }
            return reject;
        }
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                padding: 14px; alignment: start;
                Rectangle {
                    max-width: 660px;
                    min-height: editor-form.preferred-height;
                    vertical-stretch: 0;
                    background: Theme.panel; border-radius: Theme.container-radius; border-width: 1px; border-color: Theme.line;
                    editor-form := VerticalLayout {
                        padding: 15px; spacing: 10px;
                        Eyebrow { text: root.mode == "device-rename" ? "PLAYBACK DEVICES" : root.mode == "remove-saved" ? "SAVED OFFLINE" : "PLAYLIST MANAGEMENT"; }
                        Text {
                            text: root.mode == "remove-saved" ? "Remove this saved collection?" : root.mode == "delete" ? "Delete this playlist?" : root.mode == "rename" ? "Rename playlist"
                                : root.mode == "rules" ? "Edit playlist rules" : root.mode == "new-rules" ? "New rules playlist"
                                : root.mode == "device-rename" ? "Rename playback device" : "New playlist";
                            color: Theme.text; font-weight: 700; font-size: 25px; wrap: word-wrap;
                        }
                        if root.deleting: Caption { text: root.mode == "remove-saved" ? "This removes the collection from Saved offline. Its audio files stay on this computer." : "The playlist will be deleted. Tracks in your library won’t be affected."; wrap: word-wrap; }
                        if root.editing-name: Caption { text: root.mode == "device-rename" ? "Device name" : "Playlist name"; color: Theme.text; }
                        if root.editing-name: Field {
                            text <=> root.name;
                            field-label: root.mode == "device-rename" ? "Device name" : "Playlist name";
                            enabled: !root.busy;
                            init => { self.take-focus(); }
                            accepted => { if root.ready && !root.editing-rules { root.save(); } }
                        }
                        if root.editing-description: Caption { text: "Description (optional)"; color: Theme.text; }
                        if root.editing-description: Field { text <=> root.description; field-label: "Playlist description"; enabled: !root.busy; }
                        if root.editing-rules: Caption { text: "Rules"; color: Theme.text; }
                        if root.editing-rules: Caption { text: root.help == "" ? "Write one directive per line. Use two spaces to indent conditions." : root.help; wrap: word-wrap; }
                        if root.editing-rules: RulesField {
                            text <=> root.definition; enabled: !root.busy;
                            init => { if !root.editing-name { self.take-focus(); } }
                        }
                        if root.error != "": Notice { text: root.error; error: true; }
                        Divider { }
                        FlexboxLayout {
                            flex-wrap: wrap;
                            spacing: 8px;
                            Action {
                                text: "Cancel"; enabled: !root.busy;
                                init => { if root.deleting { self.take-focus(); } }
                                clicked => { root.cancel(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Action {
                                text: root.busy ? "Working…" : root.mode == "remove-saved" ? "Remove from Saved" : root.deleting ? "Delete playlist" : root.creating ? "Create playlist" : "Save changes";
                                enabled: root.ready; primary: !root.deleting;
                                clicked => { root.save(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
