import { Glyph } from "icon.slint";
export global Theme {
    in-out property <float> density: 1.0;
    out property <length> control-radius: 8px;
    out property <length> container-radius: 12px;
    out property <color> bg: #131617;
    out property <color> rail: #191d1e;
    out property <color> panel: #1e2324;
    out property <color> raised: #293032;
    out property <color> line: #303638;
    out property <color> text: #f4f6fa;
    out property <color> muted: #b4bdcb;
    out property <color> subtle: #9ca9ba;
    out property <color> primary: #66e3b4;
    out property <color> on-primary: #08271d;
    out property <color> tertiary: #dfbd78;
    out property <color> error: #ffa2ac;

    public pure function field-border(focused: bool) -> color {
        return focused ? self.tertiary : self.subtle.with-alpha(0.65);
    }
}

export component Caption inherits Text {
    color: Theme.muted;
    font-size: 12px * Theme.density;
    vertical-alignment: center;
    overflow: elide;
}

export component Eyebrow inherits Caption {
    color: Theme.subtle;
    font-size: 11px * Theme.density;
    font-weight: 700;
    letter-spacing: 1.2px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
    accessible-role: none;
}

export component Action inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> quiet;
    in property <bool> selected;
    in property <bool> leading;
    in property <bool> round;
    // An action whose target can change while the pointer is down can supply an identity.
    in property <string> click-scope;
    property <string> pressed-scope;
    in property <bool> single-pointer-activation;
    property <int> pending-clicks;
    property <string> pending-click-scope;
    // Composite controls such as a popup menu can own keyboard focus themselves.
    in property <bool> keyboard-focusable: true;
    // Let playback buttons keep Tab position without painting a pointer-only ring.
    in property <bool> pointer-focus-visible: true;
    out property <bool> has-focus: key.has-focus;
    out property <bool> has-hover: pointer.has-hover;
    out property <bool> pointer-focused;
    out property <bool> focus-visible: root.enabled && key.has-focus && (root.pointer-focus-visible || !root.pointer-focused);
    callback clicked();
    public function take-focus() { root.pointer-focused = false; key.focus(); }
    public function take-pointer-focus() { root.pointer-focused = true; key.focus(); }
    forward-focus: key;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.pointer-focused = false; root.clicked(); } }
    height: 38px;
    min-width: text == "" ? 36px : max(40px, words.preferred-width + (icon == "" ? 23px : 43px));
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: round ? self.height / 2 : Theme.control-radius;
    border-width: focus-visible ? 2px : (quiet ? 0px : 1px);
    border-color: focus-visible ? Theme.tertiary : primary ? Theme.primary : selected ? Theme.primary.with-alpha(0.48) : Theme.line;
    background: !enabled ? (quiet ? transparent : Theme.panel)
        : primary ? (pointer.pressed ? Theme.primary.darker(0.18) : pointer.has-hover ? Theme.primary.brighter(0.14) : Theme.primary)
        : pointer.pressed ? Theme.raised : selected ? Theme.primary.with-alpha(0.15) : pointer.has-hover || focus-visible ? Theme.raised : quiet ? transparent : Theme.panel;
    opacity: enabled ? 1 : 0.48;
    // Keep gold focus distinct from the similarly bright mint fill.
    if root.primary && root.focus-visible: Rectangle {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
        border-width: 2px; border-color: Theme.bg; border-radius: max(0px, parent.border-radius - 2px);
        accessible-role: none;
    }
    property <color> ink: primary && enabled ? Theme.on-primary : selected ? Theme.primary : Theme.text;
    property <length> glyph-size: root.icon == "" ? 0px : 18px;
    property <length> gap: root.icon != "" && root.text != "" ? 7px : 0px;
    // An empty Text still has a preferred width. An icon-only button has no label to reserve room for.
    property <length> inset: root.text == "" ? (root.width - root.glyph-size) / 2
        : root.leading ? 10px : max(0px, (root.width - root.glyph-size - root.gap - words.preferred-width) / 2);
    if root.icon != "": Glyph { x: root.inset; y: (root.height - self.height) / 2; width: root.glyph-size; height: self.width; name: root.icon; ink: root.ink; }
    words := Text {
        x: root.inset + root.glyph-size + root.gap; y: 0px; height: root.height;
        width: min(self.preferred-width, max(0px, root.width - self.x - 4px)); text: root.text; color: root.ink;
        font-size: 14px * Theme.density; font-weight: 600; overflow: elide; vertical-alignment: center; accessible-role: none;
    }
    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pressed-scope = root.click-scope;
            }
        }
        clicked => {
            if root.pressed-scope == root.click-scope {
                if root.keyboard-focusable { root.take-pointer-focus(); }
                if root.single-pointer-activation {
                    if root.pending-click-scope != root.click-scope { root.pending-clicks = 0; }
                    root.pending-click-scope = root.click-scope;
                    root.pending-clicks += 1;
                } else { root.clicked(); }
            }
        }
        double-clicked => {
            // Slint reports both clicked releases, then double-clicked for
            // the second. Drop just that release, even if both are pending.
            if root.single-pointer-activation && root.pressed-scope == root.click-scope {
                root.pending-clicks = max(0, root.pending-clicks - 1);
            }
        }
    }
    Timer {
        interval: 1ms;
        running: root.pending-clicks > 0;
        triggered => {
            let activate = root.pending-clicks > 0 && root.enabled && root.pending-click-scope == root.click-scope;
            root.pending-clicks = 0;
            if activate { root.clicked(); }
        }
    }
    key := FocusScope {
        enabled: root.enabled && root.keyboard-focusable;
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation { root.pointer-focused = false; }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.pointer-focused = false;
                if !event.repeat { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
}

export component CheckChoice inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    height: max(24px, label.preferred-height + 6px);
    border-radius: 4px;
    border-width: key.has-focus && enabled ? 2px : 0px;
    border-color: Theme.tertiary;
    opacity: enabled ? 1 : 0.55;
    forward-focus: key;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { if root.enabled { root.toggle(); } }

    function toggle() { root.checked = !root.checked; }
    Rectangle {
        x: 4px; y: (parent.height - self.height) / 2; width: 18px; height: self.width;
        border-radius: 3px; border-width: 1px;
        border-color: root.checked ? Theme.primary : Theme.subtle;
        background: root.checked ? (pointer.pressed ? Theme.primary.darker(0.18) : Theme.primary)
            : pointer.has-hover ? Theme.raised : Theme.bg;
        if root.checked: Path {
            x: 3px; y: 3px; width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12;
            commands: "M1,6 L4.5,9.5 L11,3"; stroke: Theme.on-primary; stroke-width: 2px;
            accessible-role: none;
        }
    }
    label := Text {
        x: 32px; width: parent.width - self.x - 4px; height: parent.height; text: root.text;
        color: Theme.text; vertical-alignment: center; accessible-role: none;
    }
    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { key.focus(); root.toggle(); }
    }
    key := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if !event.repeat { root.toggle(); }
                return accept;
            }
            return reject;
        }
    }
}

// A text-sized target with its own hit area, separate from the containing row.
// Slint 1.18 has no accessible link role; navigation is exposed as a named button.
export component TextTarget inherits Rectangle {
    in property <string> text;
    in property <string> label: text;
    in property <bool> interactive: true;
    in property <bool> link;
    in property <bool> fit-link;
    in property <color> ink: Theme.text;
    in property <length> font-size: 15px * Theme.density;
    in property <int> font-weight: 600;
    callback activated();
    callback focused();
    min-width: 0px;
    horizontal-stretch: 1;
    height: max(20px, font-size + 7px);

    if root.interactive: Rectangle {
        x: 0px; y: 0px;
        width: root.fit-link ? min(parent.width, words.preferred-width + 8px) : parent.width;
        height: parent.height;
        forward-focus: key;
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { key.focus(); root.activated(); }
        border-radius: 5px;
        border-width: key.has-focus ? 2px : 0px;
        border-color: Theme.tertiary;
        background: pointer.has-hover || key.has-focus ? Theme.raised : transparent;
        words := Text {
            x: 4px; width: max(0px, parent.width - 8px); height: parent.height;
            text: root.text; color: root.link ? Theme.primary : root.ink;
            font-size: root.font-size; font-weight: root.font-weight;
            vertical-alignment: center; overflow: elide; accessible-role: none;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { key.focus(); root.activated(); }
        }
        key := FocusScope {
            focus-on-click: false;
            focus-gained(_) => { root.focused(); }
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space {
                    if !event.repeat { root.activated(); }
                    return accept;
                }
                return reject;
            }
        }
    }
    if !root.interactive: Text {
        x: 4px; width: max(0px, parent.width - 8px); height: parent.height;
        text: root.text; color: root.ink;
        font-size: root.font-size; font-weight: root.font-weight;
        vertical-alignment: center; overflow: elide;
        accessible-role: AccessibleRole.text; accessible-label: root.text;
    }
}

export component AlbumLine inherits TextTarget {
    in property <string> album-id;
    in property <bool> links-enabled: true;
    label: "Open album: " + self.text;
    interactive: links-enabled && album-id != "" && self.text != "";
    link: true;
    ink: Theme.muted;
    font-size: 12px * Theme.density;
    font-weight: 500;
}

export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <InputType> input-type;
    in property <bool> multiline;
    in property <bool> pill;
    in property <string> prefix;
    in property <string> field-label;
    in property <bool> clearable;
    callback cleared();
    callback edited();
    callback accepted();
    public function take-focus() { input.focus(); }
    forward-focus: input;
    height: pill ? 43px : 40px;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: Theme.bg;
    border-radius: Theme.control-radius;
    property <bool> show-focus: root.enabled && input.has-focus;
    border-width: show-focus ? 2px : 1px;
    border-color: Theme.field-border(show-focus);
    opacity: enabled ? 1 : 0.55;
    clip: true;
    if root.prefix != "": Glyph { x: 13px; y: (parent.height - self.height)/2; width: 16px; height: 16px; name: root.prefix; ink: Theme.muted; }
    Caption {
        x: input.x; y: input.y; width: input.width; height: root.multiline ? 22px : input.height;
        text: root.placeholder-text;
        visible: input.text == "";
        accessible-role: none;
    }
    input := TextInput {
        x: root.prefix != "" ? 39px : 13px;
        y: root.multiline ? 9px : 0px;
        width: parent.width - self.x - (root.clearable ? 39px : 13px);
        height: parent.height - 2 * self.y;
        enabled: root.enabled;
        input-type: root.input-type;
        single-line: !root.multiline;
        color: Theme.text;
        font-size: 14px * Theme.density;
        wrap: root.multiline ? word-wrap : no-wrap;
        vertical-alignment: root.multiline ? top : center;
        selection-background-color: Theme.primary.with-alpha(0.3);
        selection-foreground-color: Theme.text;
        accessible-label: root.field-label;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
    if root.clearable && root.text != "": Action { x: parent.width - 35px; y: (parent.height - 28px)/2; width: 28px; height: 28px; quiet: true; icon: "×"; accessible-label: "Clear search"; clicked => { root.text = ""; root.cleared(); root.take-focus(); } }
}

export component Cover inherits Rectangle {
    in property <image> artwork;
    in property <string> mark: "♫";
    in property <bool> circular;
    border-radius: circular && artwork.width == 0 ? self.height / 2 : min(Theme.container-radius, self.height / 5);
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    accessible-role: none;
    if root.artwork.width == 0: Glyph { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: parent.height * 0.47; height: self.width; name: root.mark; ink: Theme.subtle; }
    Image {
        x: 0; y: 0; width: parent.width; height: parent.height;
        source: root.artwork; visible: root.artwork.width > 0; image-fit: cover; accessible-role: none;
    }
}

export component Notice inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    min-width: 0px;
    min-height: message.preferred-height + 20px;
    vertical-stretch: 0;
    border-radius: Theme.container-radius;
    border-width: 1px;
    border-color: error ? Theme.error.with-alpha(0.40) : Theme.line;
    background: error ? Theme.error.with-alpha(0.09) : Theme.panel;
    message := Text {
        x: 12px; y: 9px; width: parent.width - 24px;
        text: root.text; color: root.error ? Theme.error : Theme.muted;
        font-size: 12px; wrap: word-wrap; vertical-alignment: center;
    }
}
