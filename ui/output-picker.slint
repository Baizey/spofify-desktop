import { ScrollView } from "std-widgets.slint";
import { Action, Caption, Divider, Theme } from "theme.slint";

export struct DeviceRow { id: string, name: string, selected: bool, available: bool, can-play: bool }

export component OutputPicker inherits Action {
    in property <[DeviceRow]> devices;
    in property <string> output;
    in property <string> status;
    in property <string> context-key;
    in property <bool> offline;
    in property <bool> show-management;
    in property <length> window-width;
    callback select-output(string);
    callback manage-devices();

    icon: "◫";
    quiet: true;
    pointer-focus-visible: false;
    accessible-label: "Playback devices";
    accessible-description: root.offline ? root.message : root.output;
    accessible-expandable: true;
    accessible-expanded: picker.is-open;
    selected: picker.is-open;

    property <length> anchor-x: self.absolute-position.x;
    property <length> anchor-y: self.absolute-position.y;
    property <string> message: root.status != "" ? root.status : root.offline ? "Device control is unavailable offline"
        : root.devices.length == 0 ? "No outputs available" : "";
    changed context-key => { if picker.is-open { picker.close(); } }
    clicked => {
        if picker.is-open { picker.close(); }
        else {
            // Save the trigger as Slint's focus-return target, also for assistive activation.
            if self.pointer-focused { self.take-pointer-focus(); }
            else { self.take-focus(); }
            picker.show();
        }
    }

    picker := PopupWindow {
        width: min(326px, root.window-width - 16px);
        height: min(286px, root.anchor-y - 14px, header.height + rows.preferred-height + footer.height + 2px);
        x: clamp((root.width - self.width) / 2, 8px - root.anchor-x,
            root.window-width - root.anchor-x - self.width - 8px);
        y: -self.height - 6px;
        close-policy: close-on-click-outside;
        function choose(id: string) {
            // Call through the popup's parent before close disconnects its Slint item tree.
            root.select-output(id);
            self.close();
        }
        init => {
            if root.pointer-focused { close-button.take-pointer-focus(); }
            else { close-button.take-focus(); }
        }

        panel := Rectangle {
            width: 100%; height: 100%;
            background: Theme.panel;
            border-color: Theme.line; border-width: 1px; border-radius: Theme.container-radius;
            header := Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: 42px;
                Text {
                    x: 11px; width: parent.width - 54px; height: parent.height;
                    text: "Playback devices"; color: Theme.text;
                    font-size: 14px * Theme.density; font-weight: 700; vertical-alignment: center;
                }
                close-button := Action {
                    x: parent.width - 39px; y: 3px; width: 36px; height: 36px;
                    icon: "×"; quiet: true; pointer-focus-visible: false;
                    accessible-label: "Close playback devices";
                    clicked => { picker.close(); }
                }
                Divider { y: parent.height - 1px; }
            }
            scroll := ScrollView {
                x: 1px; y: header.y + header.height; width: parent.width - 2px;
                height: parent.height - self.y - footer.height - 1px;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                function reveal(y: length, h: length) {
                    if y < -self.content-y { self.content-y = -y; }
                    else if y + h > -self.content-y + self.visible-height {
                        self.content-y = min(0px, self.visible-height - y - h);
                    }
                }
                rows := VerticalLayout {
                    width: scroll.visible-width; padding: 5px; padding-right: 15px; spacing: 2px;
                    if root.message != "": Caption {
                        text: root.message; wrap: word-wrap;
                        height: self.preferred-height + 8px;
                    }
                    // Surface the actual output above alternatives, without making it an action.
                    for selected in [true, false]: VerticalLayout {
                        spacing: 0px;
                        for device in root.devices: VerticalLayout {
                            spacing: 0px;
                            if selected == device.selected: row := VerticalLayout {
                                spacing: 0px;
                                // The roster can still carry the last owner when its socket is unavailable.
                                property <bool> current: device.selected && device.available && !root.offline;
                                property <string> reason: root.offline ? "" : !device.available ? "Not available"
                                    : !device.can-play ? "Cannot play audio" : "";
                                if device.selected: Text {
                                    x: 10px; width: parent.width - 20px; height: 34px;
                                    text: (row.current ? "✓ " : "") + device.name;
                                    color: row.current ? Theme.primary : Theme.muted;
                                    font-size: 14px * Theme.density; font-weight: 600;
                                    vertical-alignment: center; overflow: elide;
                                    accessible-label: device.name;
                                    accessible-item-selectable: row.current;
                                    accessible-item-selected: row.current;
                                    accessible-description: !row.current ? row.reason
                                        : row.reason == "" ? "Selected output" : "Selected output · " + row.reason;
                                }
                                if !device.selected: Action {
                                    height: 34px; min-width: 0px;
                                    text: device.name; leading: true; quiet: true;
                                    enabled: !root.offline && device.available && device.can-play;
                                    accessible-label: "Select output: " + device.name;
                                    accessible-description: row.reason;
                                    click-scope: device.id;
                                    changed has-focus => {
                                        if self.has-focus { scroll.reveal(self.absolute-position.y - rows.absolute-position.y, row.height); }
                                    }
                                    clicked => { picker.choose(device.id); }
                                }
                                if row.reason != "": Caption {
                                    x: 10px; width: parent.width - 20px;
                                    text: row.reason; height: self.preferred-height + 3px;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                }
            }
            footer := Rectangle {
                x: 1px; y: parent.height - self.height - 1px; width: parent.width - 2px;
                height: root.show-management ? 43px : 0px;
                if root.show-management: Divider { y: 0px; }
                if root.show-management: Action {
                    x: 5px; y: 4px; width: parent.width - 10px; height: 34px;
                    text: "Manage devices"; leading: true; quiet: true;
                    clicked => { root.manage-devices(); picker.close(); }
                }
            }
        }
    }
}
