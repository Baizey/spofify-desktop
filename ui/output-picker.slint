import { ScrollView } from "std-widgets.slint";
import { Action, Caption, Divider, Field, Theme } from "theme.slint";

export struct DeviceRow { id: string, name: string, selected: bool, available: bool, can-play: bool }

export component OutputPicker inherits Action {
    in property <[DeviceRow]> devices;
    in property <string> output;
    in property <string> status;
    in property <string> context-key;
    in property <bool> offline;
    in property <length> window-width;
    property <bool> open: picker.is-open;
    callback device-action(string, string, string);

    icon: "◫";
    quiet: true;
    pointer-focus-visible: false;
    accessible-label: "Playback devices";
    accessible-description: root.offline ? root.message : root.output;
    accessible-expandable: true;
    accessible-expanded: root.open;
    selected: root.open;

    property <length> anchor-x: self.absolute-position.x;
    property <length> anchor-y: self.absolute-position.y;
    property <string> message: root.status != "" ? root.status : root.offline ? "Device control is unavailable offline"
        : root.devices.length == 0 ? "No outputs available" : "";
    changed context-key => { root.dismiss(); }
    changed enabled => { if !self.enabled { root.dismiss(); } }
    public function dismiss() { if root.open { picker.close(); } }
    clicked => {
        if root.open { picker.close(); }
        else {
            // Slint saves the focused trigger before showing the popup.
            if self.pointer-focused { self.take-pointer-focus(); }
            else { self.take-focus(); }
            picker.show();
        }
    }

    picker := PopupWindow {
        width: min(326px, root.window-width - 16px);
        height: min(286px, max(42px, root.anchor-y - 14px),
            header.height + selected-row.preferred-height + rows.preferred-height + 2px);
        x: clamp((root.width - self.width) / 2, 8px - root.anchor-x,
            root.window-width - root.anchor-x - self.width - 8px);
        y: -self.height - 6px;
        close-policy: close-on-click-outside;
        init => {
            if root.pointer-focused { close-button.take-pointer-focus(); }
            else { close-button.take-focus(); }
        }

        panel := Rectangle {
            width: 100%; height: 100%;
            background: Theme.panel;
            border-color: Theme.line; border-width: 1px; border-radius: Theme.container-radius;
            // Panel-local guides. Keep the check in its own gutter, whether or
            // not there is a selected output, and align the two icon actions.
            property <length> text-guide: 32px;
            property <length> check-inset: 12px;
            property <length> action-inset: 8px;
            property <length> action-size: 36px;
            property <length> row-height: 42px;
            header := Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: panel.row-height;
                Text {
                    x: panel.text-guide - header.x; width: close-button.x - self.x - 8px; height: parent.height;
                    text: "Playback devices"; color: Theme.text;
                    font-size: 14px * Theme.density; font-weight: 700; vertical-alignment: center;
                }
                close-button := Action {
                    x: panel.width - header.x - panel.action-inset - self.width;
                    y: (parent.height - self.height) / 2;
                    width: panel.action-size; height: self.width;
                    icon: "×"; quiet: true; pointer-focus-visible: false;
                    accessible-label: "Close playback devices";
                    clicked => { picker.close(); }
                }
                Divider { y: parent.height - 1px; }
            }
            scroll := ScrollView {
                x: 1px; y: selected-row.y + selected-row.height; width: parent.width - 2px;
                height: max(0px, parent.height - self.y - 1px);
                content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                function reveal(y: length, h: length) {
                    if y < -self.content-y { self.content-y = -y; }
                    else if y + h > -self.content-y + self.visible-height {
                        self.content-y = min(0px, self.visible-height - y - h);
                    }
                }
                rows := VerticalLayout {
                    property <length> label-inset: panel.text-guide - scroll.x - self.padding-left;
                    width: scroll.visible-width; padding-left: 5px; padding-right: 15px;
                    padding-bottom: root.message != "" || choices.preferred-height > 0px ? 7px : 0px;
                    if root.message != "": Rectangle {
                        height: status-text.preferred-height + 12px;
                        status-text := Caption {
                            x: rows.label-inset; width: parent.width - self.x; height: parent.height;
                            text: root.message; wrap: word-wrap; min-width: 0px;
                        }
                    }
                    choices := VerticalLayout {
                        for eligible in [true, false]: VerticalLayout {
                            for device in root.devices: VerticalLayout {
                                if !device.selected && eligible == (!root.offline && device.available && device.can-play): choice := VerticalLayout {
                                    property <string> reason: root.offline ? "" : !device.available ? "Not available"
                                        : !device.can-play ? "Cannot play audio" : "";
                                    Action {
                                        height: 34px; min-width: 0px;
                                        text: device.name; leading: true; leading-inset: rows.label-inset; quiet: true;
                                        enabled: eligible;
                                        accessible-label: "Select output: " + device.name;
                                        accessible-description: choice.reason;
                                        click-scope: device.id;
                                        changed has-focus => {
                                            if self.has-focus { scroll.reveal(self.absolute-position.y - rows.absolute-position.y, self.height); }
                                        }
                                        clicked => {
                                            root.device-action("select", device.id, "");
                                            picker.close();
                                        }
                                    }
                                    if choice.reason != "": Caption {
                                        x: rows.label-inset; width: parent.width - self.x;
                                        text: choice.reason; height: self.preferred-height + 3px;
                                        accessible-role: none;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Positioned at the top, but after the roster in Tab order: selection
            // is the primary action. Leave the current name visible while scrolling.
            selected-row := VerticalLayout {
                x: 1px; y: header.y + header.height; width: parent.width - 2px;
                height: self.preferred-height;
                for device in root.devices: VerticalLayout {
                    if device.selected: row := FocusScope {
                        height: panel.row-height + (self.editing && self.stack-editor ? panel.action-size + 4px
                            : self.reason != "" && !self.editing ? reason-text.height : 0px);
                        focus-on-click: false; focus-on-tab-navigation: false;
                        property <bool> current: device.available && !root.offline;
                        property <string> reason: root.offline ? "" : !device.available ? "Not available"
                            : !device.can-play ? "Cannot play audio" : "";
                        property <string> device-id: device.id;
                        property <string> editing-id;
                        property <bool> editing: self.current && self.editing-id == self.device-id;
                        // Larger text needs the whole line to show an ordinary name.
                        property <bool> stack-editor: Theme.density >= 1.1;
                        property <string> draft;
                        changed device-id => { self.editing-id = ""; }
                        changed current => {
                            if !self.current && self.editing-id != "" {
                                self.editing-id = "";
                                close-button.take-focus();
                            }
                        }
                        function finish(save: bool) {
                            if !self.editing || (save && self.draft == "") { return; }
                            self.editing-id = "";
                            pencil.take-focus();
                            if save && self.draft != device.name { root.device-action("rename", device.id, self.draft); }
                        }
                        capture-key-pressed(event) => {
                            if self.editing && event.text == Key.Escape {
                                if !event.repeat { self.finish(false); }
                                return accept;
                            }
                            return reject;
                        }
                        if row.current && !row.editing: checkmark := Text {
                            x: panel.check-inset - selected-row.x; y: 0px;
                            width: panel.text-guide - panel.check-inset - 4px; height: panel.row-height;
                            text: "✓"; color: Theme.primary;
                            font-size: 14px * Theme.density; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            accessible-role: none;
                        }
                        selected-name := Text {
                            visible: !row.editing;
                            x: panel.text-guide - selected-row.x; y: 0px; height: panel.row-height;
                            width: max(0px, pencil.x - 8px - self.x);
                            text: device.name; color: row.current ? Theme.primary : Theme.muted;
                            font-size: 14px * Theme.density; font-weight: 600;
                            vertical-alignment: center; overflow: elide;
                            accessible-label: device.name;
                            accessible-item-selectable: row.current;
                            accessible-item-selected: row.current;
                            accessible-description: !row.current ? row.reason
                                : row.reason == "" ? "Selected output" : "Selected output · " + row.reason;
                        }
                        pencil := Action {
                            x: panel.width - selected-row.x - panel.action-inset - panel.action-size;
                            y: (panel.row-height - self.height) / 2;
                            visible: row.current && !row.editing; enabled: self.visible;
                            width: panel.action-size; height: self.width; icon: "rename"; quiet: true;
                            accessible-label: "Rename device: " + device.name;
                            click-scope: device.id;
                            clicked => { row.draft = device.name; row.editing-id = device.id; }
                        }
                        if row.editing: editor := Rectangle {
                            // Align the typed text (not the field border) to the names.
                            x: panel.text-guide - selected-row.x - name-field.text-inset;
                            y: (panel.row-height - panel.action-size) / 2;
                            width: panel.width - selected-row.x - self.x - panel.action-inset;
                            height: cancel-button.y + panel.action-size;
                            name-field := Field {
                                x: 0px; y: 0px; height: panel.action-size;
                                width: row.stack-editor ? parent.width : max(0px, save-button.x - 4px);
                                text <=> row.draft; field-label: "Device name";
                                init => { self.take-focus(); }
                                accepted => { row.finish(true); }
                            }
                            save-button := Action {
                                x: cancel-button.x - self.width - 4px; y: cancel-button.y;
                                width: self.min-width; height: panel.action-size;
                                text: "Save"; primary: true; enabled: row.draft != "";
                                accessible-label: "Save device name";
                                clicked => { row.finish(true); }
                            }
                            cancel-button := Action {
                                x: parent.width - self.width;
                                y: row.stack-editor ? panel.action-size + 4px : 0px;
                                width: self.min-width; height: panel.action-size;
                                text: "Cancel"; quiet: true;
                                accessible-label: "Cancel device rename";
                                clicked => { row.finish(false); }
                            }
                        }
                        reason-text := Caption {
                            visible: row.reason != "" && !row.editing;
                            x: selected-name.x; y: panel.row-height - 3px;
                            width: parent.width - self.x - panel.action-inset; height: self.preferred-height + 3px;
                            text: row.reason; accessible-role: none;
                        }
                    }
                }
            }
        }
    }
}
